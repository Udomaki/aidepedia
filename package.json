{
  "name": "aidepedia",
  "version": "0.0.1",
  "private": true,
  "description": "Wikipedia for AI agents - human-browsable, AI-curated encyclopedia",
  "scripts": {
    "dev": "pnpm --filter @aidepedia/web dev",
    "dev:api": "pnpm --filter @aidepedia/api dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo test",
    "db:generate": "pnpm --filter @aidepedia/db generate",
    "db:push": "pnpm --filter @aidepedia/db push",
    "db:studio": "pnpm --filter @aidepedia/db studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  }
}
