---
/**
 * ArticleSummary Component
 * Displays AI-generated summary for an article
 */

interface Props {
  summary: string;
  keyPoints: string[];
  style?: 'brief' | 'detailed' | 'bullets';
  wordCount?: number;
  model?: string;
  generatedAt?: Date;
  showMeta?: boolean;
  compact?: boolean;
}

const {
  summary,
  keyPoints,
  style = 'detailed',
  wordCount,
  model,
  generatedAt,
  showMeta = true,
  compact = false
} = Astro.props;

// Format date
const formattedDate = generatedAt
  ? new Date(generatedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    })
  : null;

// Determine styling based on style prop
const isBrief = style === 'brief';
const isBullets = style === 'bullets';
const isDetailed = style === 'detailed';
---

<div
  class:list={[
    "article-summary bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-slate-800/50 dark:to-slate-900/50 rounded-lg p-5 border border-blue-100 dark:border-slate-700",
    { "article-summary-compact": compact }
  ]}
  aria-label="AI-generated summary"
>
  <div class="flex items-start gap-3">
    <!-- AI Icon -->
    <div
      class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-sm"
      aria-hidden="true"
    >
      AI
    </div>

    <div class="flex-grow min-w-0">
      <!-- Header -->
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-blue-900 dark:text-blue-300 uppercase tracking-wide">
          {isBrief ? 'Quick Summary' : isBullets ? 'Summary' : 'AI Summary'}
        </h3>

        {showMeta && model && (
          <span
            class="text-xs text-gray-500 dark:text-gray-400 bg-white/50 dark:bg-slate-800/50 px-2 py-1 rounded-full"
            aria-label={`Generated using ${model}`}
          >
            {model.includes('claude') ? 'Claude' : 'AI'}
          </span>
        )}
      </div>

      <!-- Summary Content -->
      {isBullets ? (
        <div class="text-gray-700 dark:text-gray-300 text-sm space-y-1.5">
          {summary.split('\n').map(line => (
            <p class={line.startsWith('•') ? 'ml-2' : ''}>{line}</p>
          ))}
        </div>
      ) : (
        <p
          class:list={[
            "text-gray-700 dark:text-gray-300",
            isBrief ? "text-sm font-medium" : "text-base leading-relaxed"
          ]}
        >
          {summary}
        </p>
      )}

      <!-- Key Points -->
      {keyPoints && keyPoints.length > 0 && (
        <div class="mt-4">
          <h4
            class="text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-2"
          >
            Key Points
          </h4>
          <ul
            class="space-y-1.5"
            aria-label="Key points"
          >
            {keyPoints.map((point) => (
              <li
                class="flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300"
              >
                <svg
                  class="w-4 h-4 text-blue-500 dark:text-blue-400 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Metadata Footer -->
      {showMeta && (wordCount || formattedDate) && (
        <div
          class="mt-3 pt-3 border-t border-blue-200/50 dark:border-slate-700/50 flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400"
          aria-label="Summary metadata"
        >
          {wordCount && (
            <span>{wordCount} words</span>
          )}
          {wordCount && formattedDate && (
            <span>•</span>
          )}
          {formattedDate && (
            <time datetime={generatedAt?.toISOString()}>
              {formattedDate}
            </time>
          )}
        </div>
      )}
    </div>
  </div>
</div>

<style>
  .article-summary-compact {
    @apply p-4;
  }

  .article-summary-compact h3 {
    @apply text-xs;
  }

  .article-summary-compact .text-base {
    @apply text-sm;
  }
</style>
