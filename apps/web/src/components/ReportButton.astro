---
interface Props {
  contentType: 'article' | 'comment';
  contentId: number;
  isLoggedIn: boolean;
}

const { contentType, contentId, isLoggedIn } = Astro.props;
---

<button
  id="report-btn"
  data-content-type={contentType}
  data-content-id={contentId}
  class="flex items-center gap-2 px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors font-medium"
>
  🚩 Report
</button>

<!-- Report Modal -->
<div id="report-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
    <div class="p-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Report Content</h2>
      <p class="text-gray-600 mb-4">
        Please select a reason for reporting this content:
      </p>

      <form id="report-form" class="space-y-4">
        <div class="space-y-2">
          <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
            <input type="radio" name="reason" value="spam" required class="w-4 h-4 text-red-600" />
            <div>
              <div class="font-medium text-gray-900">Spam</div>
              <div class="text-sm text-gray-500">Misleading or repetitive content</div>
            </div>
          </label>

          <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
            <input type="radio" name="reason" value="harassment" required class="w-4 h-4 text-red-600" />
            <div>
              <div class="font-medium text-gray-900">Harassment</div>
              <div class="text-sm text-gray-500">Targeted abuse or bullying</div>
            </div>
          </label>

          <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
            <input type="radio" name="reason" value="misinformation" required class="w-4 h-4 text-red-600" />
            <div>
              <div class="font-medium text-gray-900">Misinformation</div>
              <div class="text-sm text-gray-500">False or misleading information</div>
            </div>
          </label>

          <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
            <input type="radio" name="reason" value="inappropriate" required class="w-4 h-4 text-red-600" />
            <div>
              <div class="font-medium text-gray-900">Inappropriate</div>
              <div class="text-sm text-gray-500">Offensive or unsuitable content</div>
            </div>
          </label>

          <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
            <input type="radio" name="reason" value="copyright" required class="w-4 h-4 text-red-600" />
            <div>
              <div class="font-medium text-gray-900">Copyright Violation</div>
              <div class="text-sm text-gray-500">Unauthorized use of copyrighted material</div>
            </div>
          </label>

          <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
            <input type="radio" name="reason" value="other" required class="w-4 h-4 text-red-600" />
            <div>
              <div class="font-medium text-gray-900">Other</div>
              <div class="text-sm text-gray-500">Please specify below</div>
            </div>
          </label>
        </div>

        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
            Additional details (optional)
          </label>
          <textarea
            id="description"
            name="description"
            rows="3"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
            placeholder="Provide more context about the issue..."
          ></textarea>
        </div>

        <div class="flex gap-3">
          <button
            type="button"
            id="cancel-report"
            class="flex-1 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="flex-1 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium"
          >
            Submit Report
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const reportBtn = document.getElementById('report-btn');
  const reportModal = document.getElementById('report-modal');
  const reportForm = document.getElementById('report-form');
  const cancelBtn = document.getElementById('cancel-report');

  if (reportBtn) {
    reportBtn.addEventListener('click', () => {
      const isLoggedIn = reportBtn.getAttribute('data-logged-in');
      if (isLoggedIn === 'false') {
        alert('Please log in to report content');
        window.location.href = '/auth/signin';
        return;
      }
      reportModal?.classList.remove('hidden');
      reportModal?.classList.add('flex');
    });
  }

  if (cancelBtn) {
    cancelBtn.addEventListener('click', () => {
      reportModal?.classList.add('hidden');
      reportModal?.classList.remove('flex');
      reportForm?.reset();
    });
  }

  if (reportForm) {
    reportForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(reportForm as HTMLFormElement);
      const reason = formData.get('reason');
      const description = formData.get('description');
      
      const contentType = reportBtn?.getAttribute('data-content-type');
      const contentId = reportBtn?.getAttribute('data-content-id');

      try {
        const response = await fetch('/api/v1/reports', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            contentType,
            contentId: parseInt(contentId || '0'),
            reason,
            description: description || null,
          }),
        });

        const result = await response.json();

        if (result.success) {
          alert('Thank you for your report. We will review it shortly.');
          reportModal?.classList.add('hidden');
          reportModal?.classList.remove('flex');
          reportForm.reset();
        } else {
          alert(result.error?.message || 'Failed to submit report');
        }
      } catch (error) {
        console.error('Error submitting report:', error);
        alert('Failed to submit report. Please try again.');
      }
    });
  }

  // Close modal on outside click
  reportModal?.addEventListener('click', (e) => {
    if (e.target === reportModal) {
      reportModal.classList.add('hidden');
      reportModal.classList.remove('flex');
      reportForm?.reset();
    }
  });
</script>
