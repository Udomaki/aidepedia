---
/**
 * SkeletonLoader - Loading placeholder components
 * Provides visual feedback while content is loading
 */

interface Props {
  variant?: 'text' | 'card' | 'article' | 'comment' | 'list' | 'avatar' | 'image';
  count?: number;
  class?: string;
}

const { variant = 'text', count = 1, class: className = '' } = Astro.props;

// Skeleton animation styles
const skeletonBase = 'animate-pulse bg-gray-200 dark:bg-slate-700 rounded';

// Variant templates
const variants = {
  text: () => (
    <div class="space-y-3">
      <div class={`${skeletonBase} h-4 w-full`}></div>
      <div class={`${skeletonBase} h-4 w-5/6`}></div>
      <div class={`${skeletonBase} h-4 w-4/6`}></div>
    </div>
  ),
  
  card: () => (
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-md border border-gray-200 dark:border-slate-700 p-6">
      <div class="flex items-start gap-4">
        <div class={`${skeletonBase} w-12 h-12 rounded-lg flex-shrink-0`}></div>
        <div class="flex-1 space-y-3">
          <div class={`${skeletonBase} h-4 w-3/4`}></div>
          <div class={`${skeletonBase} h-4 w-full`}></div>
          <div class={`${skeletonBase} h-4 w-5/6`}></div>
          <div class="flex gap-4 mt-4">
            <div class={`${skeletonBase} h-3 w-20`}></div>
            <div class={`${skeletonBase} h-3 w-16`}></div>
            <div class={`${skeletonBase} h-3 w-24`}></div>
          </div>
        </div>
      </div>
    </div>
  ),
  
  article: () => (
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
      {/* Header */}
      <div class="p-6 border-b border-gray-200 dark:border-slate-700">
        <div class={`${skeletonBase} h-8 w-3/4 mb-4`}></div>
        <div class="flex items-center gap-4">
          <div class={`${skeletonBase} w-10 h-10 rounded-full`}></div>
          <div class="space-y-2">
            <div class={`${skeletonBase} h-4 w-32`}></div>
            <div class={`${skeletonBase} h-3 w-24`}></div>
          </div>
        </div>
      </div>
      {/* Content */}
      <div class="p-6 space-y-4">
        <div class={`${skeletonBase} h-4 w-full`}></div>
        <div class={`${skeletonBase} h-4 w-full`}></div>
        <div class={`${skeletonBase} h-4 w-5/6`}></div>
        <div class={`${skeletonBase} h-4 w-full`}></div>
        <div class={`${skeletonBase} h-4 w-4/6`}></div>
      </div>
      {/* Footer */}
      <div class="p-6 border-t border-gray-200 dark:border-slate-700 flex gap-4">
        <div class={`${skeletonBase} h-8 w-24 rounded-lg`}></div>
        <div class={`${skeletonBase} h-8 w-24 rounded-lg`}></div>
        <div class={`${skeletonBase} h-8 w-24 rounded-lg`}></div>
      </div>
    </div>
  ),
  
  comment: () => (
    <div class="flex gap-4 p-4 border-b border-gray-200 dark:border-slate-700">
      <div class={`${skeletonBase} w-10 h-10 rounded-full flex-shrink-0`}></div>
      <div class="flex-1 space-y-3">
        <div class="flex items-center gap-3">
          <div class={`${skeletonBase} h-4 w-24`}></div>
          <div class={`${skeletonBase} h-3 w-16`}></div>
        </div>
        <div class={`${skeletonBase} h-4 w-full`}></div>
        <div class={`${skeletonBase} h-4 w-3/4`}></div>
      </div>
    </div>
  ),
  
  list: () => (
    <div class="space-y-4">
      {Array.from({ length: 3 }).map(() => (
        <div class="flex items-center gap-4 p-3">
          <div class={`${skeletonBase} w-8 h-8 rounded`}></div>
          <div class="flex-1 space-y-2">
            <div class={`${skeletonBase} h-4 w-3/4`}></div>
            <div class={`${skeletonBase} h-3 w-1/2`}></div>
          </div>
        </div>
      ))}
    </div>
  ),
  
  avatar: () => (
    <div class={`${skeletonBase} w-12 h-12 rounded-full`}></div>
  ),
  
  image: () => (
    <div class={`${skeletonBase} w-full h-48 rounded-lg`}></div>
  ),
};
---

<div class={`skeleton-wrapper ${className}`} role="status" aria-label="Loading content" aria-live="polite">
  {Array.from({ length: count }).map(() => (
    <div class="skeleton-item">
      {variants[variant]()}
    </div>
  ))}
  <span class="sr-only">Loading...</span>
</div>

<style>
  .skeleton-item + .skeleton-item {
    margin-top: 1rem;
  }
  
  @keyframes shimmer {
    0% {
      background-position: -468px 0;
    }
    100% {
      background-position: 468px 0;
    }
  }
  
  /* Enhanced shimmer effect for browsers that support it */
  @supports (background-image: linear-gradient(to right, transparent, rgba(255,255,255,0.4), transparent)) {
    .animate-pulse {
      animation: shimmer 1.5s ease-in-out infinite;
      background-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(255, 255, 255, 0.4) 50%,
        transparent 100%
      );
      background-size: 936px 100%;
    }
    
    .dark .animate-pulse {
      background-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(255, 255, 255, 0.1) 50%,
        transparent 100%
      );
    }
  }
</style>
