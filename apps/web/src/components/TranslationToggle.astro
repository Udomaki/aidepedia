---
import { getLanguageName } from '../lib/i18n/language-detector';

interface Props {
  originalLanguage: string;
  translatedLanguage: string;
  showOriginal?: boolean;
  class?: string;
}

const { 
  originalLanguage, 
  translatedLanguage, 
  showOriginal = true,
  class: className = '' 
} = Astro.props;

const originalName = getLanguageName(originalLanguage);
const translatedName = getLanguageName(translatedLanguage);
---

<div class:list={['translation-toggle', className]}>
  <button 
    class="toggle-btn toggle-btn--original"
    data-showing={showOriginal ? 'true' : 'false'}
    data-original-lang={originalLanguage}
    data-translated-lang={translatedLanguage}
  >
    <svg class="toggle-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
    </svg>
    <span class="toggle-label">
      {showOriginal ? `Show in ${translatedName}` : `Show in ${originalName}`}
    </span>
  </button>
  
  <div class="language-indicator">
    <span class="indicator-label">Currently viewing:</span>
    <span class="indicator-lang">{showOriginal ? originalName : translatedName}</span>
  </div>
</div>

<style>
  .translation-toggle {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background-color: var(--bg-secondary, #f3f4f6);
    border-radius: 0.5rem;
    border: 1px solid var(--border-color, #e5e7eb);
  }

  .toggle-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: white;
    border: 1px solid var(--border-color, #d1d5db);
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary, #1f2937);
    cursor: pointer;
    transition: all 0.2s;
  }

  .toggle-btn:hover {
    background-color: var(--bg-hover, #f9fafb);
    border-color: var(--accent-color, #3b82f6);
  }

  .toggle-btn:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .toggle-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--accent-color, #3b82f6);
  }

  .language-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    font-size: 0.875rem;
  }

  .indicator-label {
    color: var(--text-secondary, #6b7280);
  }

  .indicator-lang {
    font-weight: 600;
    color: var(--text-primary, #1f2937);
  }

  /* RTL Support */
  :global([dir="rtl"]) .language-indicator {
    margin-left: 0;
    margin-right: auto;
  }

  @media (max-width: 640px) {
    .translation-toggle {
      flex-direction: column;
      align-items: stretch;
    }

    .language-indicator {
      margin-left: 0;
      justify-content: center;
    }
  }
</style>

<script>
  const toggleBtn = document.querySelector('.toggle-btn') as HTMLButtonElement;
  
  if (toggleBtn) {
    toggleBtn.addEventListener('click', async () => {
      const showingOriginal = toggleBtn.dataset.showing === 'true';
      const originalLang = toggleBtn.dataset.originalLang || 'en';
      const translatedLang = toggleBtn.dataset.translatedLang || 'en';
      
      // Toggle state
      toggleBtn.dataset.showing = showingOriginal ? 'false' : 'true';
      
      // Update label
      const label = toggleBtn.querySelector('.toggle-label');
      if (label) {
        const newText = showingOriginal 
          ? `Show in ${getLanguageName(originalLang)}`
          : `Show in ${getLanguageName(translatedLang)}`;
        label.textContent = newText;
      }
      
      // Update indicator
      const indicator = document.querySelector('.indicator-lang');
      if (indicator) {
        indicator.textContent = showingOriginal 
          ? getLanguageName(translatedLang)
          : getLanguageName(originalLang);
      }
      
      // Dispatch custom event for content to listen to
      const event = new CustomEvent('language-toggle', {
        detail: {
          showOriginal: !showingOriginal,
          originalLanguage: originalLang,
          translatedLanguage: translatedLang
        }
      });
      document.dispatchEvent(event);
    });
  }

  function getLanguageName(code: string): string {
    const names: Record<string, string> = {
      en: 'English',
      es: 'Spanish',
      fr: 'French',
      de: 'German',
      ja: 'Japanese',
      ar: 'Arabic',
      he: 'Hebrew',
    };
    return names[code] || code.toUpperCase();
  }
</script>
