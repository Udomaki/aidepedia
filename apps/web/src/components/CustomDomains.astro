---
/**
 * CustomDomains - Domain management for white-label deployment
 * Allows organizations to add, verify, and manage custom domains
 */

interface Props {
  organizationId: number;
  domains?: Array<{
    id: number;
    domain: string;
    isPrimary: boolean;
    verificationStatus: string;
    sslStatus: string;
    isActive: boolean;
    verifiedAt?: string;
    sslExpiresAt?: string;
    errorMessage?: string;
  }>;
}

const { organizationId, domains = [] } = Astro.props;
---

<div class="custom-domains bg-white dark:bg-slate-800 rounded-2xl shadow-xl p-8">
  <div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">Custom Domains</h2>
    <p class="text-gray-600 dark:text-gray-400">Add and manage custom domains for your organization</p>
  </div>

  <!-- Add Domain Form -->
  <div class="mb-8 p-6 bg-gray-50 dark:bg-slate-700/50 rounded-xl">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Add New Domain</h3>
    <div class="flex gap-3">
      <input
        type="text"
        id="newDomain"
        placeholder="docs.yourcompany.com"
        class="flex-1 px-4 py-2 rounded-lg border border-gray-200 dark:border-slate-600 dark:bg-slate-900 dark:text-gray-100"
      />
      <button
        type="button"
        id="addDomainBtn"
        class="px-6 py-2 bg-blue-600 dark:bg-blue-500 text-white rounded-lg font-medium hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors"
      >
        Add Domain
      </button>
    </div>
    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
      Enter your domain without http:// or https://
    </p>
  </div>

  <!-- Domains List -->
  <div id="domainsList" class="space-y-4">
    {domains.length === 0 && (
      <div class="text-center py-12 text-gray-500 dark:text-gray-400">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
        <p>No custom domains configured yet</p>
      </div>
    )}

    {domains.map((domain) => (
      <div class="domain-card p-6 border border-gray-200 dark:border-slate-700 rounded-xl">
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center gap-3">
            <h4 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
              {domain.domain}
            </h4>
            {domain.isPrimary && (
              <span class="px-2 py-1 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">
                Primary
              </span>
            )}
          </div>
          <div class="flex items-center gap-2">
            {!domain.isPrimary && domain.isActive && (
              <button
                type="button"
                class="set-primary-btn px-3 py-1 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200"
                data-domain-id={domain.id}
              >
                Set as Primary
              </button>
            )}
            <button
              type="button"
              class="remove-domain-btn px-3 py-1 text-sm text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300"
              data-domain-id={domain.id}
            >
              Remove
            </button>
          </div>
        </div>

        <!-- Domain Status -->
        <div class="grid grid-cols-2 gap-4 mb-4">
          <!-- Verification Status -->
          <div class="flex items-center gap-2">
            <div class={`w-3 h-3 rounded-full ${
              domain.verificationStatus === 'verified' 
                ? 'bg-green-500' 
                : domain.verificationStatus === 'failed' 
                  ? 'bg-red-500' 
                  : 'bg-yellow-500'
            }`}></div>
            <div>
              <p class="text-sm font-medium text-gray-900 dark:text-gray-100">Verification</p>
              <p class="text-xs text-gray-500 dark:text-gray-400 capitalize">{domain.verificationStatus}</p>
            </div>
          </div>

          <!-- SSL Status -->
          <div class="flex items-center gap-2">
            <div class={`w-3 h-3 rounded-full ${
              domain.sslStatus === 'active' 
                ? 'bg-green-500' 
                : domain.sslStatus === 'failed' 
                  ? 'bg-red-500' 
                  : 'bg-yellow-500'
            }`}></div>
            <div>
              <p class="text-sm font-medium text-gray-900 dark:text-gray-100">SSL Certificate</p>
              <p class="text-xs text-gray-500 dark:text-gray-400 capitalize">{domain.sslStatus}</p>
            </div>
          </div>
        </div>

        <!-- Verification Instructions -->
        {domain.verificationStatus === 'pending' && (
          <div class="mt-4 p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
            <h5 class="font-medium text-yellow-800 dark:text-yellow-200 mb-2">Verification Required</h5>
            <button
              type="button"
              class="view-instructions-btn text-sm text-yellow-700 dark:text-yellow-300 underline"
              data-domain-id={domain.id}
            >
              View DNS Instructions
            </button>
          </div>
        )}

        <!-- Error Message -->
        {domain.errorMessage && (
          <div class="mt-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
            <h5 class="font-medium text-red-800 dark:text-red-200 mb-2">Error</h5>
            <p class="text-sm text-red-700 dark:text-red-300">{domain.errorMessage}</p>
          </div>
        )}

        <!-- Active Domain Info -->
        {domain.isActive && (
          <div class="mt-4 flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
            {domain.verifiedAt && (
              <span>Verified: {new Date(domain.verifiedAt).toLocaleDateString()}</span>
            )}
            {domain.sslExpiresAt && (
              <span>SSL Expires: {new Date(domain.sslExpiresAt).toLocaleDateString()}</span>
            )}
          </div>
        )}
      </div>
    ))}
  </div>

  <!-- DNS Instructions Modal -->
  <div id="dnsInstructionsModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl max-w-2xl w-full mx-4 p-8">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100">DNS Configuration</h3>
        <button type="button" id="closeModal" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <div id="dnsInstructionsContent" class="prose dark:prose-invert max-w-none">
        <!-- Instructions will be loaded here -->
      </div>

      <div class="mt-6 flex justify-end">
        <button
          type="button"
          id="verifyDomainBtn"
          class="px-6 py-2 bg-blue-600 dark:bg-blue-500 text-white rounded-lg font-medium hover:bg-blue-700 dark:hover:bg-blue-600"
        >
          Verify Domain
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ organizationId }}>
  class CustomDomainsManager {
    constructor(organizationId) {
      this.organizationId = organizationId;
      this.initializeElements();
      this.bindEvents();
    }

    initializeElements() {
      this.addDomainBtn = document.getElementById('addDomainBtn');
      this.newDomainInput = document.getElementById('newDomain');
      this.domainsList = document.getElementById('domainsList');
      this.modal = document.getElementById('dnsInstructionsModal');
      this.closeModalBtn = document.getElementById('closeModal');
      this.verifyDomainBtn = document.getElementById('verifyDomainBtn');
      this.dnsInstructionsContent = document.getElementById('dnsInstructionsContent');
    }

    bindEvents() {
      this.addDomainBtn.addEventListener('click', () => this.addDomain());
      this.closeModalBtn.addEventListener('click', () => this.closeModal());
      this.verifyDomainBtn.addEventListener('click', () => this.verifyDomain());

      // Delegate event handling for dynamic buttons
      this.domainsList.addEventListener('click', (e) => {
        if (e.target.classList.contains('view-instructions-btn')) {
          this.showDNSInstructions(e.target.dataset.domainId);
        } else if (e.target.classList.contains('set-primary-btn')) {
          this.setPrimaryDomain(e.target.dataset.domainId);
        } else if (e.target.classList.contains('remove-domain-btn')) {
          this.removeDomain(e.target.dataset.domainId);
        }
      });

      // Close modal on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !this.modal.classList.contains('hidden')) {
          this.closeModal();
        }
      });

      // Enter key on domain input
      this.newDomainInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          this.addDomain();
        }
      });
    }

    async addDomain() {
      const domain = this.newDomainInput.value.trim();
      
      if (!domain) {
        alert('Please enter a domain name');
        return;
      }

      try {
        this.addDomainBtn.disabled = true;
        this.addDomainBtn.textContent = 'Adding...';

        const response = await fetch('/api/v1/branding/domains', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            organizationId: this.organizationId,
            domain,
          }),
        });

        const result = await response.json();

        if (result.success) {
          alert('Domain added successfully!');
          this.showDNSInstructions(result.data.domain.id, result.data.instructions);
          window.location.reload();
        } else {
          throw new Error(result.error?.message || 'Failed to add domain');
        }
      } catch (error) {
        console.error('Error adding domain:', error);
        alert('Failed to add domain: ' + error.message);
      } finally {
        this.addDomainBtn.disabled = false;
        this.addDomainBtn.textContent = 'Add Domain';
      }
    }

    async showDNSInstructions(domainId, instructions = null) {
      this.currentDomainId = domainId;

      if (instructions) {
        this.dnsInstructionsContent.innerHTML = `<pre class="text-sm">${instructions}</pre>`;
      } else {
        try {
          const response = await fetch(`/api/v1/branding/domains/${domainId}`);
          const result = await response.json();
          
          if (result.success) {
            this.dnsInstructionsContent.innerHTML = `<pre class="text-sm">${result.data.instructions}</pre>`;
          }
        } catch (error) {
          console.error('Error fetching instructions:', error);
        }
      }

      this.modal.classList.remove('hidden');
    }

    async verifyDomain() {
      if (!this.currentDomainId) return;

      try {
        this.verifyDomainBtn.disabled = true;
        this.verifyDomainBtn.textContent = 'Verifying...';

        const response = await fetch('/api/v1/branding/domains', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            organizationId: this.organizationId,
            domainId: this.currentDomainId,
            action: 'verify',
          }),
        });

        const result = await response.json();

        if (result.success && result.data.verified) {
          alert('Domain verified successfully! SSL certificate is being provisioned.');
          this.closeModal();
          window.location.reload();
        } else {
          throw new Error(result.data?.message || 'Domain verification failed');
        }
      } catch (error) {
        console.error('Error verifying domain:', error);
        alert('Failed to verify domain: ' + error.message);
      } finally {
        this.verifyDomainBtn.disabled = false;
        this.verifyDomainBtn.textContent = 'Verify Domain';
      }
    }

    async setPrimaryDomain(domainId) {
      if (!confirm('Set this domain as primary?')) return;

      try {
        const response = await fetch('/api/v1/branding/domains', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            organizationId: this.organizationId,
            domainId,
            action: 'setPrimary',
          }),
        });

        const result = await response.json();

        if (result.success) {
          alert('Primary domain updated successfully!');
          window.location.reload();
        } else {
          throw new Error(result.error?.message || 'Failed to set primary domain');
        }
      } catch (error) {
        console.error('Error setting primary domain:', error);
        alert('Failed to set primary domain: ' + error.message);
      }
    }

    async removeDomain(domainId) {
      if (!confirm('Are you sure you want to remove this domain?')) return;

      try {
        const response = await fetch(
          `/api/v1/branding/domains?organizationId=${this.organizationId}&domainId=${domainId}`,
          {
            method: 'DELETE',
          }
        );

        const result = await response.json();

        if (result.success) {
          alert('Domain removed successfully!');
          window.location.reload();
        } else {
          throw new Error(result.error?.message || 'Failed to remove domain');
        }
      } catch (error) {
        console.error('Error removing domain:', error);
        alert('Failed to remove domain: ' + error.message);
      }
    }

    closeModal() {
      this.modal.classList.add('hidden');
      this.currentDomainId = null;
    }
  }

  // Initialize
  new CustomDomainsManager(organizationId);
</script>
