---
interface Props {
  articleId: number;
  slug: string;
  isAuthor: boolean;
}

const { articleId, slug, isAuthor } = Astro.props;

// Only show to authors
if (!isAuthor) {
  return null;
}
---

<div id="article-stats-card" class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-lg border border-blue-200 p-4 mb-6" data-article-slug={slug}>
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-sm font-semibold text-blue-900 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
      </svg>
      Article Stats (Last 30 days)
    </h3>
    <a href={`/dashboard/stats`} class="text-xs text-blue-600 hover:text-blue-700 font-medium">
      View Full Stats →
    </a>
  </div>

  <div id="stats-loading" class="flex items-center justify-center py-4">
    <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600"></div>
  </div>

  <div id="stats-content" class="hidden">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="bg-white rounded-lg p-3 text-center">
        <div class="text-2xl font-bold text-gray-900" id="stat-views">-</div>
        <div class="text-xs text-gray-500">Views</div>
      </div>
      <div class="bg-white rounded-lg p-3 text-center">
        <div class="text-2xl font-bold text-gray-900" id="stat-visitors">-</div>
        <div class="text-xs text-gray-500">Visitors</div>
      </div>
      <div class="bg-white rounded-lg p-3 text-center">
        <div class="text-2xl font-bold text-gray-900" id="stat-reads">-</div>
        <div class="text-xs text-gray-500">Reads</div>
      </div>
      <div class="bg-white rounded-lg p-3 text-center">
        <div class="text-2xl font-bold text-gray-900" id="stat-reactions">-</div>
        <div class="text-xs text-gray-500">Reactions</div>
      </div>
    </div>

    <div class="mt-3 flex items-center gap-4 text-xs text-gray-600">
      <div class="flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Avg read: <strong id="stat-avg-read">-</strong></span>
      </div>
      <div class="flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
        <span>Scroll: <strong id="stat-scroll">-</strong></span>
      </div>
    </div>
  </div>

  <div id="stats-error" class="hidden text-sm text-red-600 text-center py-4">
    Unable to load stats
  </div>
</div>

<script>
  async function loadStats() {
    const card = document.getElementById('article-stats-card');
    if (!card) return;

    const slug = card.getAttribute('data-article-slug');
    if (!slug) return;

    const loading = document.getElementById('stats-loading');
    const content = document.getElementById('stats-content');
    const error = document.getElementById('stats-error');

    try {
      const response = await fetch(`/api/v1/articles/${slug}/stats?days=30`);
      
      if (!response.ok) {
        throw new Error('Failed to fetch stats');
      }

      const data = await response.json();
      const stats = data.data.stats;

      // Format number
      const formatNum = (n: number) => {
        if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
        if (n >= 1000) return (n / 1000).toFixed(1) + 'K';
        return n.toString();
      };

      // Format time
      const formatTime = (seconds: number | null) => {
        if (seconds === null) return 'N/A';
        const mins = Math.floor(seconds / 60);
        const secs = Math.round(seconds % 60);
        return mins > 0 ? `${mins}m ${secs}s` : `${secs}s`;
      };

      // Update stats
      document.getElementById('stat-views')!.textContent = formatNum(stats.totalViews);
      document.getElementById('stat-visitors')!.textContent = formatNum(stats.uniqueVisitors);
      document.getElementById('stat-reads')!.textContent = formatNum(stats.uniqueVisitors);
      document.getElementById('stat-reactions')!.textContent = formatNum(
        Object.values(stats.reactions).reduce((a: number, b) => a + b, 0)
      );
      document.getElementById('stat-avg-read')!.textContent = formatTime(stats.avgReadTimeSeconds);
      document.getElementById('stat-scroll')!.textContent = 
        stats.avgScrollDepth !== null ? `${Math.round(stats.avgScrollDepth)}%` : 'N/A';

      // Show content
      loading?.classList.add('hidden');
      content?.classList.remove('hidden');
    } catch (e) {
      console.error('Error loading stats:', e);
      loading?.classList.add('hidden');
      error?.classList.remove('hidden');
    }
  }

  // Load stats when component mounts
  loadStats();
</script>
