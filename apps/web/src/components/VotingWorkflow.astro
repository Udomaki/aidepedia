---
interface Props {
  articleSlug: string;
  articleId: number;
  isLoggedIn?: boolean;
}

const { articleSlug, articleId, isLoggedIn = false } = Astro.props;
---

<div class="voting-workflow" id={`voting-workflow-${articleId}`} data-article-slug={articleSlug} data-article-id={articleId}>
  <!-- Vote Statistics -->
  <div class="vote-stats mb-4 p-4 bg-gray-50 dark:bg-slate-800 rounded-lg">
    <div class="flex items-center justify-between mb-2">
      <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300">Community Votes</h3>
      <span class="text-xs text-gray-500 dark:text-gray-400" id={`total-votes-${articleId}`}>0 votes</span>
    </div>
    <div class="flex gap-2">
      <div class="flex-1 bg-green-100 dark:bg-green-900/30 rounded p-2 text-center">
        <div class="text-lg font-bold text-green-700 dark:text-green-400" id={`approve-count-${articleId}`}>0</div>
        <div class="text-xs text-green-600 dark:text-green-500">Approve</div>
      </div>
      <div class="flex-1 bg-red-100 dark:bg-red-900/30 rounded p-2 text-center">
        <div class="text-lg font-bold text-red-700 dark:text-red-400" id={`reject-count-${articleId}`}>0</div>
        <div class="text-xs text-red-600 dark:text-red-500">Reject</div>
      </div>
      <div class="flex-1 bg-gray-100 dark:bg-gray-700 rounded p-2 text-center">
        <div class="text-lg font-bold text-gray-700 dark:text-gray-400" id={`neutral-count-${articleId}`}>0</div>
        <div class="text-xs text-gray-600 dark:text-gray-500">Neutral</div>
      </div>
    </div>
    <div class="mt-2 text-center">
      <span class="text-xs text-gray-600 dark:text-gray-400">Avg Rating: </span>
      <span class="text-xs font-semibold text-gray-700 dark:text-gray-300" id={`avg-rating-${articleId}`}>-</span>
    </div>
  </div>

  {isLoggedIn ? (
    <div class="voting-form">
      <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Your Vote</h3>

      <!-- Vote Buttons -->
      <div class="vote-buttons flex gap-2 mb-4">
        <button
          class="vote-btn flex-1 px-4 py-2 rounded-lg border-2 transition-all duration-200 flex items-center justify-center gap-2"
          data-vote="approve"
          data-article-id={articleId}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span>Approve</span>
        </button>
        <button
          class="vote-btn flex-1 px-4 py-2 rounded-lg border-2 transition-all duration-200 flex items-center justify-center gap-2"
          data-vote="reject"
          data-article-id={articleId}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
          <span>Reject</span>
        </button>
        <button
          class="vote-btn flex-1 px-4 py-2 rounded-lg border-2 transition-all duration-200 flex items-center justify-center gap-2"
          data-vote="neutral"
          data-article-id={articleId}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 100-2 1 1 0 000 2zm7-1a1 1 0 11-2 0 1 1 0 012 0zm-7.536 5.879a1 1 0 001.415 0 3 3 0 014.242 0 1 1 0 001.415-1.415 5 5 0 00-7.072 0 1 1 0 000 1.415z" clip-rule="evenodd" />
          </svg>
          <span>Neutral</span>
        </button>
      </div>

      <!-- Quality Rating -->
      <div class="quality-rating mb-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          Quality Rating (Optional)
        </label>
        <div class="flex items-center gap-2">
          <input
            type="range"
            min="1"
            max="5"
            value="3"
            class="flex-1 h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer"
            id={`quality-slider-${articleId}`}
            data-article-id={articleId}
          />
          <span class="text-sm font-semibold text-gray-700 dark:text-gray-300 w-8 text-center" id={`quality-value-${articleId}`}>3</span>
          <span class="text-xs text-gray-500 dark:text-gray-400">stars</span>
        </div>
      </div>

      <!-- Comment Field -->
      <div class="comment-field mb-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          Comment (Optional)
        </label>
        <textarea
          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          rows="3"
          placeholder="Share your thoughts about this article..."
          id={`comment-field-${articleId}`}
          data-article-id={articleId}
          maxlength="1000"
        ></textarea>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
          <span id={`char-count-${articleId}`}>0</span>/1000 characters
        </p>
      </div>

      <!-- Submit Button -->
      <button
        class="submit-vote-btn w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors duration-200 disabled:bg-gray-400 disabled:cursor-not-allowed"
        id={`submit-vote-${articleId}`}
        data-article-id={articleId}
        disabled
      >
        Submit Vote
      </button>
    </div>
  ) : (
    <div class="login-prompt p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg text-center">
      <p class="text-sm text-gray-700 dark:text-gray-300 mb-2">
        Please log in to vote on this article
      </p>
      <a
        href="/auth/signin"
        class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg transition-colors duration-200"
      >
        Log In
      </a>
    </div>
  )}
</div>

<style>
  .vote-btn {
    @apply border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800;
  }

  .vote-btn:hover {
    @apply border-blue-500 bg-blue-50 dark:bg-blue-900/20;
  }

  .vote-btn.selected-approve {
    @apply border-green-500 bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-400;
  }

  .vote-btn.selected-reject {
    @apply border-red-500 bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-400;
  }

  .vote-btn.selected-neutral {
    @apply border-gray-500 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300;
  }

  input[type="range"] {
    @apply accent-blue-600;
  }
</style>

{isLoggedIn && (
  <script define:vars={{ articleSlug, articleId }}>
    class VotingWorkflow {
      constructor(articleSlug, articleId) {
        this.articleSlug = articleSlug;
        this.articleId = articleId;
        this.selectedVote = null;
        this.qualityRating = 3;
        this.comment = '';
        this.hasChanges = false;

        this.init();
      }

      async init() {
        this.attachEventListeners();
        await this.loadExistingVote();
        await this.loadVoteStats();
      }

      attachEventListeners() {
        // Vote buttons
        document.querySelectorAll('.vote-btn').forEach(btn => {
          btn.addEventListener('click', (e) => this.handleVoteSelect(e));
        });

        // Quality slider
        const slider = document.getElementById(`quality-slider-${this.articleId}`);
        if (slider) {
          slider.addEventListener('input', (e) => this.handleQualityChange(e));
        }

        // Comment field
        const commentField = document.getElementById(`comment-field-${this.articleId}`);
        if (commentField) {
          commentField.addEventListener('input', (e) => this.handleCommentChange(e));
        }

        // Submit button
        const submitBtn = document.getElementById(`submit-vote-${this.articleId}`);
        if (submitBtn) {
          submitBtn.addEventListener('click', () => this.handleSubmit());
        }
      }

      handleVoteSelect(e) {
        const btn = e.currentTarget;
        const vote = btn.dataset.vote;

        // Remove selected class from all buttons
        document.querySelectorAll('.vote-btn').forEach(b => {
          b.classList.remove('selected-approve', 'selected-reject', 'selected-neutral');
        });

        // Add selected class to clicked button
        btn.classList.add(`selected-${vote}`);

        this.selectedVote = vote;
        this.hasChanges = true;
        this.updateSubmitButton();
      }

      handleQualityChange(e) {
        this.qualityRating = parseInt(e.target.value);
        const valueDisplay = document.getElementById(`quality-value-${this.articleId}`);
        if (valueDisplay) {
          valueDisplay.textContent = this.qualityRating;
        }
        this.hasChanges = true;
        this.updateSubmitButton();
      }

      handleCommentChange(e) {
        this.comment = e.target.value;
        const charCount = document.getElementById(`char-count-${this.articleId}`);
        if (charCount) {
          charCount.textContent = this.comment.length;
        }
        this.hasChanges = true;
        this.updateSubmitButton();
      }

      updateSubmitButton() {
        const submitBtn = document.getElementById(`submit-vote-${this.articleId}`);
        if (submitBtn) {
          submitBtn.disabled = !this.selectedVote;
        }
      }

      async loadExistingVote() {
        try {
          const response = await fetch(`/api/v1/articles/${this.articleSlug}/vote`);
          if (!response.ok) throw new Error('Failed to load vote');

          const data = await response.json();

          if (data.data.userVote) {
            const vote = data.data.userVote;

            // Set selected vote
            this.selectedVote = vote.vote;
            const btn = document.querySelector(`.vote-btn[data-vote="${vote.vote}"]`);
            if (btn) {
              btn.classList.add(`selected-${vote.vote}`);
            }

            // Set quality rating
            if (vote.qualityRating) {
              this.qualityRating = vote.qualityRating;
              const slider = document.getElementById(`quality-slider-${this.articleId}`);
              const valueDisplay = document.getElementById(`quality-value-${this.articleId}`);
              if (slider) slider.value = vote.qualityRating;
              if (valueDisplay) valueDisplay.textContent = vote.qualityRating;
            }

            // Set comment
            if (vote.comment) {
              this.comment = vote.comment;
              const commentField = document.getElementById(`comment-field-${this.articleId}`);
              const charCount = document.getElementById(`char-count-${this.articleId}`);
              if (commentField) commentField.value = vote.comment;
              if (charCount) charCount.textContent = vote.comment.length;
            }

            this.updateSubmitButton();
          }
        } catch (error) {
          console.error('Error loading vote:', error);
        }
      }

      async loadVoteStats() {
        try {
          const response = await fetch(`/api/v1/articles/${this.articleSlug}/vote`);
          if (!response.ok) throw new Error('Failed to load stats');

          const data = await response.json();
          const stats = data.data.stats;

          // Update counts
          const approveEl = document.getElementById(`approve-count-${this.articleId}`);
          const rejectEl = document.getElementById(`reject-count-${this.articleId}`);
          const neutralEl = document.getElementById(`neutral-count-${this.articleId}`);
          const totalEl = document.getElementById(`total-votes-${this.articleId}`);
          const avgRatingEl = document.getElementById(`avg-rating-${this.articleId}`);

          if (approveEl) approveEl.textContent = stats.approve;
          if (rejectEl) rejectEl.textContent = stats.reject;
          if (neutralEl) neutralEl.textContent = stats.neutral;
          if (totalEl) totalEl.textContent = `${stats.total} vote${stats.total !== 1 ? 's' : ''}`;
          if (avgRatingEl) avgRatingEl.textContent = stats.avgQualityRating ? `${stats.avgQualityRating} ⭐` : '-';
        } catch (error) {
          console.error('Error loading stats:', error);
        }
      }

      async handleSubmit() {
        if (!this.selectedVote) return;

        const submitBtn = document.getElementById(`submit-vote-${this.articleId}`);
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';
        }

        try {
          const response = await fetch(`/api/v1/articles/${this.articleSlug}/vote`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              vote: this.selectedVote,
              qualityRating: this.qualityRating,
              comment: this.comment || undefined
            })
          });

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.message || 'Failed to submit vote');
          }

          const data = await response.json();

          // Update stats
          const stats = data.data.stats;
          const approveEl = document.getElementById(`approve-count-${this.articleId}`);
          const rejectEl = document.getElementById(`reject-count-${this.articleId}`);
          const neutralEl = document.getElementById(`neutral-count-${this.articleId}`);
          const totalEl = document.getElementById(`total-votes-${this.articleId}`);
          const avgRatingEl = document.getElementById(`avg-rating-${this.articleId}`);

          if (approveEl) approveEl.textContent = stats.approve;
          if (rejectEl) rejectEl.textContent = stats.reject;
          if (neutralEl) neutralEl.textContent = stats.neutral;
          if (totalEl) totalEl.textContent = `${stats.total} vote${stats.total !== 1 ? 's' : ''}`;
          if (avgRatingEl) avgRatingEl.textContent = stats.avgQualityRating ? `${stats.avgQualityRating} ⭐` : '-';

          this.hasChanges = false;

          // Show success message
          this.showToast('Vote submitted successfully!', 'success');
        } catch (error) {
          console.error('Error submitting vote:', error);
          this.showToast(error.message || 'Failed to submit vote', 'error');
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Vote';
            this.updateSubmitButton();
          }
        }
      }

      showToast(message, type = 'info') {
        const toast = document.createElement('div');
        toast.className = `fixed bottom-4 right-4 px-4 py-2 rounded-lg text-white font-medium z-50 ${
          type === 'success' ? 'bg-green-600' : type === 'error' ? 'bg-red-600' : 'bg-blue-600'
        }`;
        toast.textContent = message;
        document.body.appendChild(toast);

        setTimeout(() => {
          toast.remove();
        }, 3000);
      }
    }

    // Initialize on page load
    document.addEventListener('astro:page-load', () => {
      new VotingWorkflow(articleSlug, articleId);
    });
  </script>
)}
