---
import Layout from '../layouts/Layout.astro';
import { getMaintenanceModeSettings } from '@aidepedia/db/queries';

export const prerender = false;

// Fetch maintenance settings
const settings = await getMaintenanceModeSettings();

// If maintenance mode is disabled, redirect to home
if (!settings.enabled) {
  return Astro.redirect('/');
}
---

<Layout title="Maintenance Mode">
  <div class="min-h-screen bg-gray-50 flex flex-col items-center justify-center px-4">
    <div class="max-w-md w-full text-center">
      <!-- Maintenance Icon -->
      <div class="mb-8">
        <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-yellow-100">
          <svg class="w-12 h-12 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
      </div>

      <!-- Title -->
      <h1 class="text-3xl font-bold text-gray-900 mb-4">
        We'll Be Right Back
      </h1>

      <!-- Message -->
      <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 mb-6">
        <p class="text-gray-700 leading-relaxed">
          {settings.message || 'We are currently performing scheduled maintenance. Please check back soon.'}
        </p>
      </div>

      <!-- Estimated Time -->
      {settings.estimatedTime && (
        <div class="flex items-center justify-center gap-2 text-gray-600 mb-6">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Estimated time: <strong>{settings.estimatedTime}</strong></span>
        </div>
      )}

      <!-- Contact Info -->
      {settings.contactEmail && (
        <div class="text-gray-600">
          <p class="text-sm">
            Need immediate assistance? Contact us at:
          </p>
          <a 
            href={`mailto:${settings.contactEmail}`}
            class="text-blue-600 hover:text-blue-700 font-medium"
          >
            {settings.contactEmail}
          </a>
        </div>
      )}

      <!-- Refresh Button -->
      <div class="mt-8">
        <button 
          onclick="window.location.reload()"
          class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
        >
          Refresh Page
        </button>
      </div>

      <!-- Auto-refresh notice -->
      <p class="text-gray-500 text-sm mt-4">
        This page will automatically refresh in <span id="countdown">60</span> seconds.
      </p>
    </div>
  </div>
</Layout>

<script>
  // Auto-refresh countdown
  let seconds = 60;
  const countdownEl = document.getElementById('countdown');
  
  const interval = setInterval(() => {
    seconds--;
    if (countdownEl) {
      countdownEl.textContent = seconds.toString();
    }
    
    if (seconds <= 0) {
      clearInterval(interval);
      window.location.reload();
    }
  }, 1000);
</script>
