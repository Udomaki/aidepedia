---
import Layout from '../layouts/Layout.astro';
import { getUserBookmarks, getCategories } from '@aidepedia/db';
import { getSession } from '../lib/auth';

// Check if user is logged in
let session = null;
let bookmarks = null;
let categories = null;

try {
  session = await getSession(Astro.request);
  
  if (session?.user?.id) {
    // Get user's bookmarks
    const result = await getUserBookmarks(parseInt(session.user.id as string), { limit: 100 });
    bookmarks = result.data;
    
    // Get categories for lookup
    categories = await getCategories();
  }
} catch (e) {
  console.error('Error fetching bookmarks:', e);
}

// Redirect to login if not authenticated
if (!session?.user?.id) {
  return Astro.redirect('/login');
}

const categoryMap = new Map(categories?.map(c => [c.id, c]) || []);

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  }).format(new Date(date));
}

function getCategoryColor(categoryName: string | undefined): string {
  const colors: Record<string, string> = {
    'technology': 'bg-blue-600',
    'wellness': 'bg-green-600',
    'philosophy': 'bg-purple-600',
  };
  return colors[(categoryName || '').toLowerCase()] || 'bg-gray-600';
}

const pageTitle = 'My Bookmarks - AIdepedia';
---

<Layout title={pageTitle}>
  <main class="container mx-auto px-4 py-8 max-w-6xl">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6">
      <a href="/" class="text-blue-600 hover:text-blue-700">Home</a>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-gray-600">My Bookmarks</span>
    </nav>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">🔖 My Bookmarks</h1>
      <p class="text-gray-600">Articles you've saved for later</p>
    </div>

    <!-- Bookmarks List -->
    {bookmarks && bookmarks.length > 0 ? (
      <div class="space-y-4">
        {bookmarks.map((article) => {
          const categoryName = article.categoryId 
            ? categoryMap.get(article.categoryId)?.name 
            : undefined;
          
          return (
            <article class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    {categoryName && (
                      <span class={`px-3 py-1 text-white text-xs font-medium rounded-full ${getCategoryColor(categoryName)}`}>
                        {categoryName}
                      </span>
                    )}
                    {article.status === 'published' && (
                      <span class="text-green-600 text-xs">✓ Published</span>
                    )}
                  </div>
                  
                  <h2 class="text-xl font-semibold text-gray-900 mb-2">
                    <a href={`/articles/${article.slug}`} class="hover:text-blue-600 transition-colors">
                      {article.title}
                    </a>
                  </h2>
                  
                  {article.excerpt && (
                    <p class="text-gray-600 mb-3 line-clamp-2">{article.excerpt}</p>
                  )}
                  
                  <div class="flex items-center gap-4 text-sm text-gray-500">
                    <span>📅 Saved {formatDate(article.bookmarkedAt)}</span>
                    {article.viewCount && article.viewCount > 0 && (
                      <span>👁 {article.viewCount} views</span>
                    )}
                    {article.qualityScore !== null && article.qualityScore !== undefined && (
                      <span>⭐ Quality: {article.qualityScore}</span>
                    )}
                    <span>👍 {(article.upvotes || 0) - (article.downvotes || 0)} net votes</span>
                  </div>
                  
                  {article.tags && article.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mt-3">
                      {article.tags.map((tag: string) => (
                        <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                
                <div class="ml-4 flex flex-col gap-2">
                  <a
                    href={`/articles/${article.slug}`}
                    class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium text-sm whitespace-nowrap"
                  >
                    Read →
                  </a>
                  <button
                    class="remove-bookmark-btn px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium text-sm whitespace-nowrap"
                    data-article-slug={article.slug}
                    data-article-id={article.id}
                  >
                    Remove
                  </button>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
        <div class="text-6xl mb-4">📑</div>
        <h2 class="text-2xl font-bold text-gray-900 mb-2">No bookmarks yet</h2>
        <p class="text-gray-600 mb-6">Start saving articles to read later!</p>
        <a
          href="/articles"
          class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
        >
          Browse Articles
        </a>
      </div>
    )}
  </main>
</Layout>

<script define:vars={{}}>
  // Handle remove bookmark buttons
  document.querySelectorAll('.remove-bookmark-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const articleSlug = btn.dataset.articleSlug;
      
      if (!confirm('Remove this bookmark?')) {
        return;
      }
      
      try {
        const response = await fetch(`/api/v1/articles/${articleSlug}/bookmark`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        if (response.ok) {
          // Remove the article card from the page
          const articleCard = btn.closest('article');
          articleCard?.remove();
          
          // Check if there are no more bookmarks
          const remainingBookmarks = document.querySelectorAll('article');
          if (remainingBookmarks.length === 0) {
            window.location.reload();
          }
        } else {
          const error = await response.json();
          alert(error.error || 'Failed to remove bookmark');
        }
      } catch (error) {
        console.error('Error removing bookmark:', error);
        alert('Failed to remove bookmark');
      }
    });
  });
</script>
