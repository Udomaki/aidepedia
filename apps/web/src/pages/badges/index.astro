    earnedBy: 89,
    points: 250,
  },
  {
    id: 'collaborator',
    name: 'Collaborator',
    description: 'Contributed to 20+ articles started by others',
    icon: '🤝',
    color: 'from-indigo-400 to-purple-500',
    category: 'collaboration',
    rarity: 'uncommon',
    requirements: 'Edit 20 articles by others',
    earnedBy: 234,
    points: 150,
  },
  {
    id: 'perfectionist',
    name: 'Perfectionist',
    description: 'Made 10+ edits with zero rejections',
    icon: '💎',
    color: 'from-pink-400 to-rose-500',
    category: 'editing',
    rarity: 'epic',
