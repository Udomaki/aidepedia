  },
  {
    id: 'category-master',
    name: 'Category Master',
    description: 'Contributed to 50+ articles in a single category',
    icon: '📚',
    color: 'from-emerald-400 to-green-500',
    category: 'specialization',
    rarity: 'rare',
    requirements: 'Contribute to 50 articles in one category',
    earnedBy: 67,
    points: 200,
  },
  {
    id: 'community-hero',
    name: 'Community Hero',
    description: 'Helped resolve 100+ disputes through accurate voting',
    icon: '🦸',
    color: 'from-blue-500 to-indigo-600',
    category: 'moderation',
