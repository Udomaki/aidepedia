---
import Layout from '../../layouts/Layout.astro';

// Mock data - in production this would come from API
const badges = [
  {
    id: 'top-contributor',
    name: 'Top Contributor',
    description: 'Created 50+ articles that were approved by the community',
    icon: '🏆',
    color: 'from-yellow-400 to-orange-500',
    category: 'creation',
    rarity: 'legendary',
    requirements: 'Create 50 approved articles',
    earnedBy: 12,
    points: 500,
  },
  {
    id: 'quality-editor',
    name: 'Quality Editor',
    description: 'Made 100+ edits with 90%+ acceptance rate',
    icon: '✨',
    color: 'from-blue-400 to-cyan-500',
    category: 'editing',
    rarity: 'epic',
    requirements: '100 edits with 90%+ acceptance',
    earnedBy: 28,
    points: 300,
  },
  {
    id: 'early-adopter',
    name: 'Early Adopter',
    description: 'Joined AIdepedia in the first month of launch',
    icon: '🌟',
    color: 'from-purple-400 to-pink-500',
    category: 'special',
    rarity: 'rare',
    requirements: 'Join during first month',
    earnedBy: 156,
    points: 200,
  },
  {
    id: 'voter-extraordinaire',
    name: 'Voter Extraordinaire',
    description: 'Cast 500+ votes with 85%+ accuracy',
    icon: '🗳️',
    color: 'from-green-400 to-teal-500',
    category: 'voting',
    rarity: 'epic',
    requirements: 'Cast 500 votes with 85% accuracy',
    earnedBy: 34,
    points: 350,
  },
  {
    id: 'fact-checker',
    name: 'Fact Checker',
    description: 'Successfully flagged 25+ inaccurate articles',
    icon: '🔍',
    color: 'from-red-400 to-pink-500',
