  },
  {
    id: 'speed-demon',
    name: 'Speed Demon',
    description: 'Created 5 approved articles in a single day',
    icon: '⚡',
    color: 'from-amber-400 to-yellow-500',
    category: 'creation',
    rarity: 'uncommon',
    requirements: 'Create 5 articles in one day',
    earnedBy: 178,
