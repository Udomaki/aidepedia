---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/auth';
import { getUserByUsername, getUserStats, getUserActivity, getArticleById, getFollowCounts } from '@aidepedia/db';

export function getStaticPaths() {
  return [];
}

const { username } = Astro.params;
const session = await getSession(Astro.request);
const currentUser = session?.user;

// Fetch user data
let user: any;
let stats: any;
let followCounts: any;
let activities: any[] = [];

try {
  user = await getUserByUsername(username || '');
  stats = await getUserStats(user.id);
  followCounts = await getFollowCounts(user.id);
  
  // Only show activity if user allows it
  if (user.showActivity !== false) {
    const activityResult = await getUserActivity(user.id, { limit: 20 });
    activities = activityResult.data;
  }
} catch (error) {
  return Astro.redirect('/404');
}

function formatDate(dateStr: string | Date): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function formatTimestamp(timestamp: string | Date): string {
  const date = new Date(timestamp);
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffHours / 24);
  
  if (diffDays > 7) return formatDate(timestamp);
  if (diffDays > 0) return `${diffDays}d ago`;
  if (diffHours > 0) return `${diffHours}h ago`;
  return 'Just now';
}

function getActivityIcon(type: string, changeType?: string): string {
  if (type === 'edit') {
    if (changeType === 'created') return '📄';
    if (changeType === 'published') return '✅';
    return '✏️';
  }
  if (type === 'comment') return '💬';
  if (type === 'vote') return '🗳️';
  return '📝';
}

function getActivityText(activity: any): string {
  if (activity.type === 'edit') {
    if (activity.changeType === 'created') return 'Created article';
    if (activity.changeType === 'published') return 'Published article';
    if (activity.changeType === 'reverted') return 'Reverted article';
    return 'Edited article';
  }
  if (activity.type === 'comment') return 'Commented on';
  if (activity.type === 'vote') return activity.voteType === 'upvote' ? 'Upvoted' : 'Downvoted';
  return 'Activity on';
}

// Calculate badges based on stats
const badges: Array<{name: string, icon: string, color: string}> = [];
if (stats.articleCount >= 10) badges.push({ name: 'Prolific Writer', icon: '✍️', color: 'from-purple-400 to-purple-600' });
if (stats.articleCount >= 50) badges.push({ name: 'Content Creator', icon: '📚', color: 'from-blue-400 to-blue-600' });
if (stats.revisionCount >= 100) badges.push({ name: 'Diligent Editor', icon: '✏️', color: 'from-green-400 to-green-600' });
if (stats.netVotes >= 100) badges.push({ name: 'Community Favorite', icon: '⭐', color: 'from-yellow-400 to-orange-500' });
if (stats.commentCount >= 50) badges.push({ name: 'Engaged Member', icon: '💬', color: 'from-pink-400 to-pink-600' });
if (user.showBadges !== false) {
  // Add early adopter badge for users created before a certain date
  const earlyDate = new Date('2026-06-01');
  if (new Date(user.createdAt) < earlyDate) {
    badges.unshift({ name: 'Early Adopter', icon: '🚀', color: 'from-indigo-400 to-indigo-600' });
  }
}
---

<Layout title={`${user.name} - User Profile`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Profile Header -->
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8 mb-6">
      <div class="flex flex-col sm:flex-row items-start justify-between gap-6">
        <div class="flex items-center space-x-6">
          {user.image ? (
            <img 
              src={user.image} 
              alt={user.name} 
              class="w-24 h-24 rounded-full object-cover border-4 border-white shadow-lg"
            />
          ) : (
            <div class="w-24 h-24 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center shadow-lg">
              <span class="text-4xl text-white font-bold">{user.name?.charAt(0)?.toUpperCase() || '?'}</span>
            </div>
          )}
          <div>
            <h1 class="text-3xl font-bold text-gray-900">{user.name}</h1>
            {user.bio && (
              <p class="text-gray-600 mt-2 max-w-md">{user.bio}</p>
            )}
            <p class="text-sm text-gray-400 mt-2">
              Member since {formatDate(user.createdAt)}
            </p>
          </div>
        </div>
        
        {currentUser && currentUser.id !== user.id && (
          <div class="flex gap-2">
            <button 
              id="follow-btn"
              data-user-id={user.id}
              data-username={username}
              class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
            >
              Follow
            </button>
            <button 
              id="block-btn"
              data-user-id={user.id}
              data-username={username}
              class="px-4 py-2 border border-red-300 text-red-600 rounded-lg hover:bg-red-50 transition-colors font-medium text-sm"
              title="Block this user"
            >
              Block
            </button>
          </div>
        )}
        
        {currentUser && currentUser.id === user.id && (
          <a 
            href="/settings/profile" 
            class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors font-medium"
          >
            Edit Profile
          </a>
        )}
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
      <a href={`/users/${username}/followers`} class="bg-white rounded-xl shadow border border-gray-100 p-6 text-center hover:shadow-md transition-shadow">
        <div class="text-3xl font-bold text-blue-600">{followCounts.followersCount}</div>
        <div class="text-sm text-gray-600 mt-1">Followers</div>
      </a>
      <a href={`/users/${username}/following`} class="bg-white rounded-xl shadow border border-gray-100 p-6 text-center hover:shadow-md transition-shadow">
        <div class="text-3xl font-bold text-green-600">{followCounts.followingCount}</div>
        <div class="text-sm text-gray-600 mt-1">Following</div>
      </a>
      <div class="bg-white rounded-xl shadow border border-gray-100 p-6 text-center">
        <div class="text-3xl font-bold text-purple-600">{stats.articleCount}</div>
        <div class="text-sm text-gray-600 mt-1">Articles</div>
      </div>
      <div class="bg-white rounded-xl shadow border border-gray-100 p-6 text-center">
        <div class="text-3xl font-bold text-orange-600">{stats.revisionCount}</div>
        <div class="text-sm text-gray-600 mt-1">Edits</div>
      </div>
      <div class="bg-white rounded-xl shadow border border-gray-100 p-6 text-center">
        <div class="text-3xl font-bold text-teal-600">{stats.commentCount}</div>
        <div class="text-sm text-gray-600 mt-1">Comments</div>
      </div>
    </div>

    {user.showBadges !== false && badges.length > 0 && (
      <!-- Badges -->
      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6 mb-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Badges</h2>
        <div class="flex flex-wrap gap-3">
          {badges.map((badge) => (
            <span class={`px-4 py-2 bg-gradient-to-r ${badge.color} text-white rounded-full text-sm font-medium flex items-center gap-2`}>
              <span>{badge.icon}</span>
              {badge.name}
            </span>
          ))}
        </div>
      </div>
    )}

    {user.showActivity !== false && activities.length > 0 && (
      <!-- Recent Activity -->
      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Recent Activity</h2>
        <div class="space-y-3">
          {activities.map((activity) => (
            <div class="flex items-start justify-between py-3 border-b border-gray-100 last:border-0">
              <div class="flex items-start space-x-3">
                <span class="text-2xl">{getActivityIcon(activity.type, activity.changeType)}</span>
                <div>
                  <div class="text-gray-700">
                    <span class="font-medium">{getActivityText(activity)}</span>
                    {activity.articleTitle && (
                      <>
                        <span class="text-gray-500 mx-2">·</span>
                        <a 
                          href={`/articles/${activity.articleId}`} 
                          class="text-blue-600 hover:text-blue-800 font-medium"
                        >
                          {activity.articleTitle}
                        </a>
                      </>
                    )}
                  </div>
                  {activity.type === 'comment' && activity.content && (
                    <p class="text-sm text-gray-500 mt-1 line-clamp-2">{activity.content}</p>
                  )}
                </div>
              </div>
              <span class="text-sm text-gray-400 whitespace-nowrap ml-4">
                {formatTimestamp(activity.timestamp)}
              </span>
            </div>
          ))}
        </div>
      </div>
    )}

    {user.showActivity === false && (
      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-12 text-center">
        <p class="text-gray-500">
          <span class="text-4xl mb-4 block">🔒</span>
          This user's activity is private
        </p>
      </div>
    )}
  </div>
</Layout>

<script>
  const followBtn = document.getElementById('follow-btn');
  const blockBtn = document.getElementById('block-btn');
  
  if (followBtn) {
    let isFollowing = false;
    
    // Check initial follow status
    const username = followBtn.dataset.username;
    fetch(`/api/v1/users/${username}/follow`)
      .then(res => res.json())
      .then(data => {
        if (data.success && data.data.following) {
          isFollowing = true;
          followBtn.textContent = 'Unfollow';
          followBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
          followBtn.classList.add('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
        }
      })
      .catch(err => console.error('Error checking follow status:', err));
    
    followBtn.addEventListener('click', async () => {
      try {
        const method = isFollowing ? 'DELETE' : 'POST';
        const response = await fetch(`/api/v1/users/${username}/follow`, {
          method,
          headers: {
            'Content-Type': 'application/json',
          },
        });
        
        const data = await response.json();
        
        if (data.success) {
          isFollowing = !isFollowing;
          
          if (isFollowing) {
            followBtn.textContent = 'Unfollow';
            followBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
            followBtn.classList.add('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
          } else {
            followBtn.textContent = 'Follow';
            followBtn.classList.remove('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
            followBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
          }
          
          // Refresh page to update follower count
          window.location.reload();
        } else {
          alert(data.error?.message || 'Failed to update follow status');
        }
      } catch (error) {
        console.error('Error updating follow status:', error);
        alert('Failed to update follow status');
      }
    });
  }

  // Block button handling
  if (blockBtn) {
    let isBlocking = false;
    const username = blockBtn.dataset.username;
    
    // Check initial block status
    fetch(`/api/v1/users/${username}/block`)
      .then(res => res.json())
      .then(data => {
        if (data.success && data.data.blocking) {
          isBlocking = true;
          blockBtn.textContent = 'Unblock';
          blockBtn.classList.remove('border-red-300', 'text-red-600', 'hover:bg-red-50');
          blockBtn.classList.add('border-gray-300', 'text-gray-600', 'hover:bg-gray-50');
        }
      })
      .catch(err => console.error('Error checking block status:', err));
    
    blockBtn.addEventListener('click', async () => {
      const confirmMsg = isBlocking 
        ? 'Are you sure you want to unblock this user?' 
        : 'Are you sure you want to block this user? They will not be able to see your content or contact you.';
      
      if (!confirm(confirmMsg)) return;
      
      try {
        const method = isBlocking ? 'DELETE' : 'POST';
        const response = await fetch(`/api/v1/users/${username}/block`, {
          method,
          headers: {
            'Content-Type': 'application/json',
          },
        });
        
        const data = await response.json();
        
        if (data.success) {
          isBlocking = !isBlocking;
          
          if (isBlocking) {
            blockBtn.textContent = 'Unblock';
            blockBtn.classList.remove('border-red-300', 'text-red-600', 'hover:bg-red-50');
            blockBtn.classList.add('border-gray-300', 'text-gray-600', 'hover:bg-gray-50');
            
            // Hide follow button when blocking
            if (followBtn) {
              followBtn.style.display = 'none';
            }
          } else {
            blockBtn.textContent = 'Block';
            blockBtn.classList.remove('border-gray-300', 'text-gray-600', 'hover:bg-gray-50');
            blockBtn.classList.add('border-red-300', 'text-red-600', 'hover:bg-red-50');
            
            // Show follow button when unblocking
            if (followBtn) {
              followBtn.style.display = 'block';
            }
          }
        } else {
          alert(data.error?.message || 'Failed to update block status');
        }
      } catch (error) {
        console.error('Error updating block status:', error);
        alert('Failed to update block status');
      }
    });
  }
</script>
