---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/auth';

const session = await getSession(Astro.request);

// Redirect to login if not authenticated
if (!session?.user?.id) {
  return Astro.redirect('/login');
}
---

<Layout title="API & Billing">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">API & Billing</h1>
      <p class="text-gray-600 mt-2">Manage API keys, usage, and billing</p>
    </div>

    <!-- Settings Navigation -->
    <div class="flex space-x-1 mb-8 bg-gray-100 rounded-lg p-1 overflow-x-auto">
      <a href="/settings/profile" class="px-4 py-2 text-sm font-medium text-gray-600 rounded-md hover:bg-white hover:text-gray-900 transition-colors whitespace-nowrap">
        Profile
      </a>
      <a href="/settings/notifications" class="px-4 py-2 text-sm font-medium text-gray-600 rounded-md hover:bg-white hover:text-gray-900 transition-colors whitespace-nowrap">
        Notifications
      </a>
      <a href="/settings/security" class="px-4 py-2 text-sm font-medium text-gray-600 rounded-md hover:bg-white hover:text-gray-900 transition-colors whitespace-nowrap">
        Security
      </a>
      <a href="/settings/billing" class="px-4 py-2 text-sm font-medium bg-white text-gray-900 rounded-md shadow whitespace-nowrap">
        API & Billing
      </a>
    </div>

    <!-- Billing Tabs -->
    <div class="mb-8 border-b border-gray-200">
      <nav class="-mb-px flex space-x-8">
        <button 
          id="tab-api-keys" 
          class="border-b-2 border-blue-500 text-blue-600 py-4 px-1 text-sm font-medium"
          onclick="switchTab('api-keys')"
        >
          API Keys
        </button>
        <button 
          id="tab-usage" 
          class="border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium"
          onclick="switchTab('usage')"
        >
          Usage
        </button>
        <button 
          id="tab-billing" 
          class="border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium"
          onclick="switchTab('billing')"
        >
          Billing
        </button>
        <button 
          id="tab-webhooks" 
          class="border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium"
          onclick="switchTab('webhooks')"
        >
          Webhooks
        </button>
      </nav>
    </div>

    <!-- API Keys Tab -->
    <div id="content-api-keys" class="tab-content">
      <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
        <div class="flex justify-between items-center mb-6">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">API Keys</h2>
            <p class="text-sm text-gray-600 mt-1">Manage your API keys for programmatic access</p>
          </div>
          <button 
            onclick="showCreateKeyModal()"
            class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            Create API Key
          </button>
        </div>

        <div id="api-keys-list" class="space-y-4">
          <!-- API keys will be loaded here -->
          <div class="text-center py-8 text-gray-500">
            Loading API keys...
          </div>
        </div>
      </div>
    </div>

    <!-- Usage Tab -->
    <div id="content-usage" class="tab-content hidden">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
          <div class="text-sm font-medium text-gray-600">Total Requests</div>
          <div id="stat-total" class="text-3xl font-bold text-gray-900 mt-2">-</div>
        </div>
        <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
          <div class="text-sm font-medium text-gray-600">Success Rate</div>
          <div id="stat-success-rate" class="text-3xl font-bold text-green-600 mt-2">-</div>
        </div>
        <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
          <div class="text-sm font-medium text-gray-600">Avg Response Time</div>
          <div id="stat-avg-time" class="text-3xl font-bold text-gray-900 mt-2">-</div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Usage Details</h2>
        <div id="usage-chart" class="mb-6">
          <!-- Usage chart will be rendered here -->
        </div>
        <div id="top-endpoints">
          <!-- Top endpoints will be loaded here -->
        </div>
      </div>
    </div>

    <!-- Billing Tab -->
    <div id="content-billing" class="tab-content hidden">
      <div class="bg-white rounded-xl shadow border border-gray-100 p-6 mb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Current Plan</h2>
        <div id="current-plan">
          <div class="text-center py-8 text-gray-500">
            Loading billing information...
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Available Plans</h2>
        <div id="plans-list" class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Plans will be loaded here -->
        </div>
      </div>
    </div>

    <!-- Webhooks Tab -->
    <div id="content-webhooks" class="tab-content hidden">
      <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
        <div class="flex justify-between items-center mb-6">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">Webhook Endpoints</h2>
            <p class="text-sm text-gray-600 mt-1">Manage webhook endpoints for real-time notifications</p>
          </div>
          <button 
            onclick="showCreateWebhookModal()"
            class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            Create Webhook
          </button>
        </div>

        <div id="webhooks-list" class="space-y-4">
          <!-- Webhooks will be loaded here -->
          <div class="text-center py-8 text-gray-500">
            Loading webhooks...
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Tab switching
  function switchTab(tabName) {
    // Hide all tab contents
    document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
    
    // Show selected tab content
    document.getElementById(`content-${tabName}`).classList.remove('hidden');
    
    // Update tab button styles
    document.querySelectorAll('[id^="tab-"]').forEach(el => {
      el.classList.remove('border-blue-500', 'text-blue-600');
      el.classList.add('border-transparent', 'text-gray-500');
    });
    
    const activeTab = document.getElementById(`tab-${tabName}`);
    activeTab.classList.remove('border-transparent', 'text-gray-500');
    activeTab.classList.add('border-blue-500', 'text-blue-600');
    
    // Load data for the tab
    if (tabName === 'api-keys') loadApiKeys();
    if (tabName === 'usage') loadUsage();
    if (tabName === 'billing') loadBilling();
    if (tabName === 'webhooks') loadWebhooks();
  }
  
  // Load API keys
  async function loadApiKeys() {
    try {
      const response = await fetch('/api/v1/api-keys');
      const keys = await response.json();
      
      const container = document.getElementById('api-keys-list');
      
      if (keys.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8 text-gray-500">
            No API keys yet. Create your first API key to get started.
          </div>
        `;
        return;
      }
      
      container.innerHTML = keys.map(key => `
        <div class="border border-gray-200 rounded-lg p-4 hover:border-gray-300 transition-colors">
          <div class="flex justify-between items-start">
            <div class="flex-1">
              <h3 class="font-medium text-gray-900">${key.name}</h3>
              <p class="text-sm text-gray-600 mt-1 font-mono">${key.key}</p>
              <div class="flex items-center space-x-4 mt-2 text-sm text-gray-500">
                <span class="${key.isActive ? 'text-green-600' : 'text-red-600'}">
                  ${key.isActive ? '● Active' : '● Inactive'}
                </span>
                <span>Rate limit: ${key.rateLimit}/min</span>
                <span>Quota: ${key.monthlyQuota.toLocaleString()}/month</span>
                ${key.lastUsedAt ? `<span>Last used: ${new Date(key.lastUsedAt).toLocaleDateString()}</span>` : ''}
              </div>
            </div>
            <div class="flex space-x-2">
              <button 
                onclick="toggleKey(${key.id}, ${!key.isActive})"
                class="px-3 py-1 text-sm text-gray-600 hover:text-gray-900"
              >
                ${key.isActive ? 'Disable' : 'Enable'}
              </button>
              <button 
                onclick="deleteKey(${key.id})"
                class="px-3 py-1 text-sm text-red-600 hover:text-red-700"
              >
                Delete
              </button>
            </div>
          </div>
        </div>
      `).join('');
    } catch (error) {
      console.error('Error loading API keys:', error);
    }
  }
  
  // Load usage stats
  async function loadUsage() {
    try {
      const response = await fetch('/api/v1/usage?period=month');
      const stats = await response.json();
      
      document.getElementById('stat-total').textContent = stats.total.toLocaleString();
      
      const successRate = stats.total > 0 
        ? ((stats.successful / stats.total) * 100).toFixed(1) 
        : 0;
      document.getElementById('stat-success-rate').textContent = `${successRate}%`;
      
      document.getElementById('stat-avg-time').textContent = `${stats.avgResponseTime}ms`;
      
      // Load top endpoints
      const endpointsContainer = document.getElementById('top-endpoints');
      if (stats.topEndpoints && stats.topEndpoints.length > 0) {
        endpointsContainer.innerHTML = `
          <h3 class="font-medium text-gray-900 mb-3">Top Endpoints</h3>
          <div class="space-y-2">
            ${stats.topEndpoints.map(ep => `
              <div class="flex justify-between items-center py-2 border-b border-gray-100">
                <div>
                  <span class="text-sm font-medium text-gray-600">${ep.method}</span>
                  <span class="text-sm text-gray-900 ml-2">${ep.endpoint}</span>
                </div>
                <div class="text-sm text-gray-500">
                  ${ep.count.toLocaleString()} calls · ${ep.avgResponseTime}ms avg
                </div>
              </div>
            `).join('')}
          </div>
        `;
      }
    } catch (error) {
      console.error('Error loading usage stats:', error);
    }
  }
  
  // Load billing info
  async function loadBilling() {
    try {
      const response = await fetch('/api/v1/billing/plans');
      const plans = await response.json();
      
      const container = document.getElementById('plans-list');
      container.innerHTML = plans.map(plan => `
        <div class="border border-gray-200 rounded-lg p-6 hover:border-blue-300 transition-colors">
          <h3 class="text-lg font-semibold text-gray-900">${plan.name}</h3>
          <div class="mt-4">
            <span class="text-3xl font-bold text-gray-900">$${plan.priceMonthly}</span>
            <span class="text-gray-600">/month</span>
          </div>
          <p class="text-sm text-gray-600 mt-2">${plan.description || ''}</p>
          <ul class="mt-4 space-y-2 text-sm text-gray-600">
            <li>✓ ${plan.features.monthlyQuota.toLocaleString()} requests/month</li>
            <li>✓ ${plan.features.apiKeys} API keys</li>
            <li>✓ ${plan.features.webhooks} webhooks</li>
            <li>✓ ${plan.features.support} support</li>
          </ul>
          <button 
            onclick="subscribeToPlan(${plan.id})"
            class="mt-6 w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            Subscribe
          </button>
        </div>
      `).join('');
    } catch (error) {
      console.error('Error loading billing info:', error);
    }
  }
  
  // Load webhooks
  async function loadWebhooks() {
    try {
      const response = await fetch('/api/v1/webhooks');
      const webhooks = await response.json();
      
      const container = document.getElementById('webhooks-list');
      
      if (webhooks.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8 text-gray-500">
            No webhook endpoints yet. Create your first webhook to receive notifications.
          </div>
        `;
        return;
      }
      
      container.innerHTML = webhooks.map(wh => `
        <div class="border border-gray-200 rounded-lg p-4 hover:border-gray-300 transition-colors">
          <div class="flex justify-between items-start">
            <div class="flex-1">
              <h3 class="font-medium text-gray-900">${wh.url}</h3>
              <p class="text-sm text-gray-600 mt-1">${wh.description || 'No description'}</p>
              <div class="flex items-center space-x-4 mt-2 text-sm text-gray-500">
                <span class="${wh.isActive ? 'text-green-600' : 'text-red-600'}">
                  ${wh.isActive ? '● Active' : '● Inactive'}
                </span>
                <span>Events: ${wh.events.join(', ')}</span>
                <span>Deliveries: ${wh.totalDeliveries}</span>
              </div>
            </div>
            <div class="flex space-x-2">
              <button 
                onclick="toggleWebhook(${wh.id}, ${!wh.isActive})"
                class="px-3 py-1 text-sm text-gray-600 hover:text-gray-900"
              >
                ${wh.isActive ? 'Disable' : 'Enable'}
              </button>
              <button 
                onclick="deleteWebhook(${wh.id})"
                class="px-3 py-1 text-sm text-red-600 hover:text-red-700"
              >
                Delete
              </button>
            </div>
          </div>
        </div>
      `).join('');
    } catch (error) {
      console.error('Error loading webhooks:', error);
    }
  }
  
  // Create API Key modal
  function showCreateKeyModal() {
    const name = prompt('Enter a name for your API key:');
    if (name) {
      createApiKey(name);
    }
  }
  
  async function createApiKey(name) {
    try {
      const response = await fetch('/api/v1/api-keys', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          permissions: { read: true, write: false, admin: false },
          rateLimit: 100,
          monthlyQuota: 10000
        })
      });
      
      if (response.ok) {
        loadApiKeys();
        alert('API key created successfully!');
      }
    } catch (error) {
      console.error('Error creating API key:', error);
      alert('Failed to create API key');
    }
  }
  
  async function toggleKey(id, isActive) {
    try {
      await fetch(`/api/v1/api-keys/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isActive })
      });
      loadApiKeys();
    } catch (error) {
      console.error('Error toggling API key:', error);
    }
  }
  
  async function deleteKey(id) {
    if (confirm('Are you sure you want to delete this API key?')) {
      try {
        await fetch(`/api/v1/api-keys/${id}`, { method: 'DELETE' });
        loadApiKeys();
      } catch (error) {
        console.error('Error deleting API key:', error);
      }
    }
  }
  
  // Create Webhook modal
  function showCreateWebhookModal() {
    const url = prompt('Enter webhook URL:');
    if (url) {
      const events = prompt('Enter events (comma-separated, e.g., article.created,article.updated):');
      if (events) {
        createWebhook(url, events.split(',').map(e => e.trim()));
      }
    }
  }
  
  async function createWebhook(url, events) {
    try {
      const response = await fetch('/api/v1/webhooks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url, events })
      });
      
      if (response.ok) {
        loadWebhooks();
        alert('Webhook created successfully!');
      }
    } catch (error) {
      console.error('Error creating webhook:', error);
      alert('Failed to create webhook');
    }
  }
  
  async function toggleWebhook(id, isActive) {
    try {
      await fetch(`/api/v1/webhooks/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isActive })
      });
      loadWebhooks();
    } catch (error) {
      console.error('Error toggling webhook:', error);
    }
  }
  
  async function deleteWebhook(id) {
    if (confirm('Are you sure you want to delete this webhook?')) {
      try {
        await fetch(`/api/v1/webhooks/${id}`, { method: 'DELETE' });
        loadWebhooks();
      } catch (error) {
        console.error('Error deleting webhook:', error);
      }
    }
  }
  
  async function subscribeToPlan(planId) {
    try {
      const response = await fetch('/api/v1/billing/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ planId, interval: 'monthly' })
      });
      
      const data = await response.json();
      
      if (data.checkoutUrl) {
        window.location.href = data.checkoutUrl;
      }
    } catch (error) {
      console.error('Error subscribing to plan:', error);
      alert('Failed to start subscription process');
    }
  }
  
  // Initialize
  loadApiKeys();
</script>
