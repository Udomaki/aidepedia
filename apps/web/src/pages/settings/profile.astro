---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/auth';
import { getUserById } from '@aidepedia/db';

const session = await getSession(Astro.request);

// Redirect to login if not authenticated
if (!session?.user?.id) {
  return Astro.redirect('/login');
}

// Get current user data
let user: any;
try {
  user = await getUserById(parseInt(session.user.id as string));
} catch (error) {
  return Astro.redirect('/login');
}
---

<Layout title="Profile Settings">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Profile Settings</h1>
      <p class="text-gray-600 mt-2">Manage your public profile information</p>
    </div>

    <!-- Profile Form -->
    <form id="profile-form" class="space-y-6">
      <!-- Avatar Section -->
      <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Avatar</h2>
        <div class="flex items-center space-x-6">
          {user.image ? (
            <img 
              src={user.image} 
              alt={user.name} 
              class="w-20 h-20 rounded-full object-cover"
              id="avatar-preview"
            />
          ) : (
            <div 
              class="w-20 h-20 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center"
              id="avatar-preview"
            >
              <span class="text-3xl text-white font-bold">{user.name?.charAt(0)?.toUpperCase() || '?'}</span>
            </div>
          )}
          <div class="flex-1">
            <label for="avatar-url" class="block text-sm font-medium text-gray-700 mb-2">
              Avatar URL
            </label>
            <input 
              type="url" 
              id="avatar-url" 
              name="image"
              value={user.image || ''}
              placeholder="https://example.com/avatar.jpg"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <p class="text-sm text-gray-500 mt-1">
              Enter a URL for your profile picture
            </p>
          </div>
        </div>
      </div>

      <!-- Basic Info Section -->
      <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h2>
        
        <div class="space-y-4">
          <div>
            <label for="display-name" class="block text-sm font-medium text-gray-700 mb-2">
              Display Name
            </label>
            <input 
              type="text" 
              id="display-name" 
              name="name"
              value={user.name || ''}
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          <div>
            <label for="bio" class="block text-sm font-medium text-gray-700 mb-2">
              Bio
            </label>
            <textarea 
              id="bio" 
              name="bio"
              rows="4"
              placeholder="Tell us a little about yourself..."
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"
            >{user.bio || ''}</textarea>
            <p class="text-sm text-gray-500 mt-1">
              Brief description for your profile (max 500 characters)
            </p>
          </div>
        </div>
      </div>

      <!-- Privacy Settings Section -->
      <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Privacy Settings</h2>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <label for="show-activity" class="text-sm font-medium text-gray-900">
                Show Activity Feed
              </label>
              <p class="text-sm text-gray-500">
                Allow others to see your recent edits, comments, and votes
              </p>
            </div>
            <button 
              type="button"
              id="show-activity-toggle"
              class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
              role="switch"
              aria-checked={user.showActivity !== false ? 'true' : 'false'}
              data-enabled={user.showActivity !== false ? 'true' : 'false'}
            >
              <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
            </button>
            <input type="hidden" name="showActivity" value={user.showActivity !== false ? 'true' : 'false'} />
          </div>

          <div class="flex items-center justify-between">
            <div>
              <label for="show-badges" class="text-sm font-medium text-gray-900">
                Show Badges
              </label>
              <p class="text-sm text-gray-500">
                Display your earned badges on your public profile
              </p>
            </div>
            <button 
              type="button"
              id="show-badges-toggle"
              class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
              role="switch"
              aria-checked={user.showBadges !== false ? 'true' : 'false'}
              data-enabled={user.showBadges !== false ? 'true' : 'false'}
            >
              <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
            </button>
            <input type="hidden" name="showBadges" value={user.showBadges !== false ? 'true' : 'false'} />
          </div>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="flex items-center justify-end space-x-4">
        <a 
          href={`/users/${user.name}`}
          class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors"
        >
          View Profile
        </a>
        <button 
          type="submit"
          class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
        >
          Save Changes
        </button>
      </div>
    </form>

    <!-- Status Messages -->
    <div id="success-message" class="hidden mt-4 p-4 bg-green-50 border border-green-200 rounded-lg">
      <p class="text-green-800 font-medium">✓ Profile updated successfully!</p>
    </div>
    
    <div id="error-message" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
      <p class="text-red-800 font-medium" id="error-text">Error updating profile</p>
    </div>
  </div>
</Layout>

<script>
  // Toggle switch functionality
  function setupToggle(toggleId: string, inputName: string) {
    const toggle = document.getElementById(toggleId) as HTMLButtonElement;
    const input = document.querySelector(`input[name="${inputName}"]`) as HTMLInputElement;
    
    if (!toggle || !input) return;
    
    const updateToggle = () => {
      const isEnabled = toggle.dataset.enabled === 'true';
      const span = toggle.querySelector('span');
      
      if (isEnabled) {
        toggle.classList.add('bg-blue-600');
        toggle.classList.remove('bg-gray-200');
        span?.classList.add('translate-x-5');
        span?.classList.remove('translate-x-0');
      } else {
        toggle.classList.remove('bg-blue-600');
        toggle.classList.add('bg-gray-200');
        span?.classList.remove('translate-x-5');
        span?.classList.add('translate-x-0');
      }
      
      input.value = isEnabled ? 'true' : 'false';
      toggle.setAttribute('aria-checked', isEnabled ? 'true' : 'false');
    };
    
    updateToggle();
    
    toggle.addEventListener('click', () => {
      const current = toggle.dataset.enabled === 'true';
      toggle.dataset.enabled = (!current).toString();
      updateToggle();
    });
  }
  
  setupToggle('show-activity-toggle', 'showActivity');
  setupToggle('show-badges-toggle', 'showBadges');
  
  // Avatar preview
  const avatarInput = document.getElementById('avatar-url') as HTMLInputElement;
  const avatarPreview = document.getElementById('avatar-preview');
  
  avatarInput?.addEventListener('input', () => {
    const url = avatarInput.value;
    if (url && avatarPreview) {
      if (avatarPreview.tagName === 'IMG') {
        (avatarPreview as HTMLImageElement).src = url;
      } else {
        // Replace div with img
        const img = document.createElement('img');
        img.src = url;
        img.alt = 'Avatar preview';
        img.className = 'w-20 h-20 rounded-full object-cover';
        img.id = 'avatar-preview';
        avatarPreview.replaceWith(img);
      }
    }
  });
  
  // Form submission
  const form = document.getElementById('profile-form') as HTMLFormElement;
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');
  const errorText = document.getElementById('error-text');
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      bio: formData.get('bio'),
      image: formData.get('image'),
      showActivity: formData.get('showActivity') === 'true',
      showBadges: formData.get('showBadges') === 'true',
    };
    
    try {
      const response = await fetch('/api/v1/users/me', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });
      
      const result = await response.json();
      
      if (response.ok && result.success) {
        successMessage?.classList.remove('hidden');
        errorMessage?.classList.add('hidden');
        
        // Hide success message after 3 seconds
        setTimeout(() => {
          successMessage?.classList.add('hidden');
        }, 3000);
      } else {
        throw new Error(result.error?.message || 'Failed to update profile');
      }
    } catch (error) {
      errorMessage?.classList.remove('hidden');
      successMessage?.classList.add('hidden');
      if (errorText) {
        errorText.textContent = error instanceof Error ? error.message : 'Error updating profile';
      }
    }
  });
</script>
