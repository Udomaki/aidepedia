---
import Layout from '../../layouts/Layout.astro';

// This page will be client-side rendered to fetch mentions from the API
---

<Layout title="Mentions - AIdepedia">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-900">@Mentions</h1>
      <p class="text-gray-600 mt-2">Notifications when someone mentions you in articles or comments</p>
    </div>

    <div id="mentions-container">
      <!-- Loading state -->
      <div id="loading" class="text-center py-8">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
        <p class="text-gray-600 mt-4">Loading mentions...</p>
      </div>

      <!-- Mentions list (will be populated by JavaScript) -->
      <div id="mentions-list" class="space-y-4 hidden"></div>

      <!-- Empty state -->
      <div id="empty-state" class="text-center py-12 hidden">
        <div class="text-gray-400 text-6xl mb-4">💬</div>
        <h3 class="text-xl font-semibold text-gray-700 mb-2">No mentions yet</h3>
        <p class="text-gray-600">When someone mentions you with @username, it'll appear here</p>
      </div>

      <!-- Error state -->
      <div id="error-state" class="text-center py-12 hidden">
        <div class="text-red-400 text-6xl mb-4">⚠️</div>
        <h3 class="text-xl font-semibold text-gray-700 mb-2">Failed to load mentions</h3>
        <p id="error-message" class="text-gray-600 mb-4"></p>
        <button onclick="loadMentions()" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
          Try Again
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  let currentPage = 1;
  const limit = 20;

  function formatTimestamp(timestamp: string): string {
    const date = new Date(timestamp);
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffMins = Math.floor(diffMs / (1000 * 60));
    const diffHours = Math.floor(diffMins / 60);
    const diffDays = Math.floor(diffHours / 24);
    
    if (diffDays > 7) {
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }
    if (diffDays > 0) return `${diffDays}d ago`;
    if (diffHours > 0) return `${diffHours}h ago`;
    if (diffMins > 0) return `${diffMins}m ago`;
    return 'Just now';
  }

  async function loadMentions(page = 1) {
    const loadingEl = document.getElementById('loading');
    const listEl = document.getElementById('mentions-list');
    const emptyEl = document.getElementById('empty-state');
    const errorEl = document.getElementById('error-state');

    loadingEl?.classList.remove('hidden');
    listEl?.classList.add('hidden');
    emptyEl?.classList.add('hidden');
    errorEl?.classList.add('hidden');

    try {
      const response = await fetch(`/api/v1/mentions?page=${page}&limit=${limit}`);
      
      if (!response.ok) {
        if (response.status === 401) {
          window.location.href = '/auth/signin';
          return;
        }
        throw new Error('Failed to fetch mentions');
      }

      const result = await response.json();
      
      loadingEl?.classList.add('hidden');

      if (!result.success || !result.data.mentions || result.data.mentions.length === 0) {
        emptyEl?.classList.remove('hidden');
        return;
      }

      listEl?.classList.remove('hidden');

      // Render mentions
      const mentions = result.data.mentions;
      listEl!.innerHTML = mentions.map((mention: any) => {
        const bgClass = mention.read ? 'bg-gray-50' : 'bg-blue-50 border-l-4 border-blue-500';
        const data = mention.data || {};
        const link = data.articleSlug ? `/articles/${data.articleSlug}` : '#';
        
        return `
          <div class="p-4 rounded-lg border ${bgClass} hover:shadow-md transition-shadow ${!mention.read ? 'cursor-pointer' : ''}" 
               ${!mention.read ? `onclick="markAsRead(${mention.id}, '${link}')"` : ''}>
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <h3 class="font-semibold text-gray-900">${mention.title}</h3>
                ${mention.content ? `<p class="text-gray-600 mt-1">${mention.content}</p>` : ''}
                <div class="flex items-center gap-2 mt-2 text-sm text-gray-500">
                  <span>${formatTimestamp(mention.createdAt)}</span>
                  ${data.articleSlug ? `<a href="${link}" class="text-blue-600 hover:underline" onclick="event.stopPropagation()">View article →</a>` : ''}
                </div>
              </div>
              ${!mention.read ? '<span class="w-2 h-2 bg-blue-500 rounded-full"></span>' : ''}
            </div>
          </div>
        `;
      }).join('');

      // Update page title with unread count
      if (result.data.unreadCount > 0) {
        document.title = `(${result.data.unreadCount}) Mentions - AIdepedia`;
      }

    } catch (error) {
      console.error('Error loading mentions:', error);
      loadingEl?.classList.add('hidden');
      errorEl?.classList.remove('hidden');
      const errorMsg = document.getElementById('error-message');
      if (errorMsg && error instanceof Error) {
        errorMsg.textContent = error.message;
      }
    }
  }

  async function markAsRead(mentionId: number, link: string) {
    try {
      const response = await fetch(`/api/v1/mentions/${mentionId}/read`, {
        method: 'PUT',
      });

      if (response.ok) {
        // Navigate to the article
        if (link !== '#') {
          window.location.href = link;
        } else {
          // Just reload the page to update the read state
          loadMentions(currentPage);
        }
      }
    } catch (error) {
      console.error('Error marking mention as read:', error);
    }
  }

  // Load mentions on page load
  loadMentions();
</script>
