---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Server Error">
  <div class="min-h-[60vh] flex items-center justify-center px-4 py-16">
    <div class="max-w-lg w-full text-center">
      <!-- 500 Illustration -->
      <div class="mb-8">
        <div class="relative inline-block">
          <h1 class="text-[10rem] font-bold text-gray-200 dark:text-slate-700 leading-none select-none" aria-hidden="true">
            500
          </h1>
          <div class="absolute inset-0 flex items-center justify-center">
            <svg class="w-32 h-32 text-red-500 dark:text-red-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Error Message -->
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4">
        Something Went Wrong
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
        We're sorry, but something went wrong on our end. Our team has been notified and we're working to fix it.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
        <button
          onclick="window.location.reload()"
          class="px-6 py-3 bg-blue-600 dark:bg-blue-500 text-white font-medium rounded-xl hover:bg-blue-700 dark:hover:bg-blue-600 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 transition-all transform hover:scale-105 active:scale-95 inline-flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Try Again
        </button>
        <a
          href="/"
          class="px-6 py-3 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-300 font-medium rounded-xl hover:bg-gray-200 dark:hover:bg-slate-600 focus:ring-2 focus:ring-gray-200 dark:focus:ring-slate-600 transition-all transform hover:scale-105 active:scale-95 inline-flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Go Home
        </a>
      </div>

      <!-- Help Section -->
      <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-6 mb-8">
        <h3 class="text-lg font-semibold text-amber-900 dark:text-amber-200 mb-2 flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          What can you do?
        </h3>
        <ul class="text-amber-800 dark:text-amber-300 text-sm space-y-2 text-left">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Wait a few minutes and try again - the issue may be temporary</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Clear your browser cache and cookies</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Check our <a href="https://github.com/Udomaki/aidepedia" class="underline hover:text-amber-900 dark:hover:text-amber-100">GitHub</a> for known issues</span>
          </li>
        </ul>
      </div>

      <!-- Status Link -->
      <p class="text-sm text-gray-500 dark:text-gray-400">
        If this problem persists, please{' '}
        <a 
          href="https://github.com/Udomaki/aidepedia/issues" 
          class="text-blue-600 dark:text-blue-400 hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          report an issue
        </a>
      </p>

      <!-- Error ID (for support) -->
      <div class="mt-8 p-4 bg-gray-100 dark:bg-slate-700 rounded-lg">
        <p class="text-xs text-gray-500 dark:text-gray-400 font-mono">
          Error ID: {crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36)}
        </p>
        <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">
          {new Date().toISOString()}
        </p>
      </div>
    </div>
  </div>
</Layout>
