---
import { getDashboardStats, getActivityFeed, getPendingReviews, listArticles, getCommentsByArticle, getEditSuggestionsByArticle } from '@aidepedia/db';
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/auth';

export const prerender = false;

// Get current user session
const session = await getSession(Astro.request);
const currentUserId = session?.user?.id ? parseInt(session.user.id as string) : null;

// Fetch dashboard data
const stats = await getDashboardStats();
const recentActivity = await getActivityFeed({ limit: 10 });
const pendingReviews = await getPendingReviews({ limit: 5 });

// Fetch user's articles (if authenticated)
let myArticles = null;
let myDrafts = null;
let articlesWithComments = [];

if (currentUserId) {
  // Get user's published articles
  myArticles = await listArticles({ 
    authorId: currentUserId, 
    status: 'published', 
    limit: 5,
    sortBy: 'date',
    sortOrder: 'desc'
  });
  
  // Get user's draft articles
  myDrafts = await listArticles({ 
    authorId: currentUserId, 
    status: 'draft', 
    limit: 5,
    sortBy: 'date',
    sortOrder: 'desc'
  });

  // Get recent comments and suggestions on user's articles
  if (myArticles.data.length > 0) {
    for (const article of myArticles.data.slice(0, 3)) {
      try {
        const comments = await getCommentsByArticle(article.id);
        const suggestions = await getEditSuggestionsByArticle(article.id, { status: 'pending', limit: 3 });
        
        if (comments.length > 0 || suggestions.data.length > 0) {
          articlesWithComments.push({
            article,
            comments: comments.slice(0, 2),
            suggestions: suggestions.data.slice(0, 2)
          });
        }
      } catch (error) {
        console.error(`Error fetching activity for article ${article.id}:`, error);
      }
    }
  }
}
---

<Layout title="Editor Dashboard">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">Editor Dashboard</h1>
      <p class="text-gray-600">
        Manage articles, review pending edits, and track activity across AIdepedia.
      </p>
    </div>

    <!-- Quick Actions -->
    <div class="mb-8 flex gap-4 flex-wrap">
      <a
        href="/articles/new"
        class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
      >
        ✍️ Create Article
      </a>
      {myDrafts && myDrafts.meta.total > 0 && (
        <a
          href="/dashboard/drafts"
          class="px-6 py-3 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors font-medium"
        >
          📝 View All Drafts ({myDrafts.meta.total})
        </a>
      )}
      <a
        href="/dashboard/pending"
        class="px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors font-medium"
      >
        🔍 Review Pending ({stats.pendingReviews})
      </a>
      <a
        href="/dashboard/stats"
        class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium"
      >
        📊 My Statistics
      </a>
      <a
        href="/settings/profile"
        class="px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors font-medium"
      >
        ⚙️ Settings
      </a>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-sm font-medium text-gray-600">Total Articles</h3>
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <p class="text-3xl font-bold text-gray-900">{stats.totalArticles}</p>
        <p class="text-sm text-gray-500 mt-1">{stats.publishedArticles} published</p>
      </div>

      <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-sm font-medium text-gray-600">Pending Reviews</h3>
          <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <p class="text-3xl font-bold text-gray-900">{stats.pendingReviews}</p>
        <a href="/dashboard/pending" class="text-sm text-blue-600 hover:text-blue-700 mt-1 inline-block">
          View all →
        </a>
      </div>

      <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-sm font-medium text-gray-600">Active Editors</h3>
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <p class="text-3xl font-bold text-gray-900">{stats.activeEditors}</p>
        <a href="/profiles" class="text-sm text-blue-600 hover:text-blue-700 mt-1 inline-block">
          View all →
        </a>
      </div>

      <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-sm font-medium text-gray-600">Activity (24h)</h3>
          <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <p class="text-3xl font-bold text-gray-900">{recentActivity.meta.total}</p>
        <a href="/dashboard/activity" class="text-sm text-blue-600 hover:text-blue-700 mt-1 inline-block">
          View all →
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- My Articles Section (if authenticated) -->
      {currentUserId && myArticles && (
        <div class="lg:col-span-1">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-bold text-gray-900">My Articles</h2>
            <a href="/dashboard/stats" class="text-blue-600 hover:text-blue-700 text-sm font-medium">
              View all →
            </a>
          </div>

          {myArticles.data.length > 0 ? (
            <div class="space-y-4">
              {myArticles.data.map(article => (
                <div class="bg-white rounded-lg shadow border border-gray-200 p-4 hover:shadow-md transition-shadow">
                  <div class="flex items-start justify-between mb-2">
                    <h3 class="font-semibold text-gray-900">
                      <a href={`/articles/${article.slug}`} class="hover:text-blue-600">
                        {article.title}
                      </a>
                    </h3>
                    <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">
                      Published
                    </span>
                  </div>
                  {article.excerpt && (
                    <p class="text-sm text-gray-600 line-clamp-2 mb-3">
                      {article.excerpt}
                    </p>
                  )}
                  <div class="flex items-center justify-between text-xs text-gray-500">
                    <div class="flex items-center gap-3">
                      <span class="flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        {article.views || 0}
                      </span>
                      <span class="flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                        {article.reactions || 0}
                      </span>
                    </div>
                    <div class="flex gap-2">
                      <a
                        href={`/articles/${article.slug}/edit`}
                        class="text-blue-600 hover:text-blue-700 font-medium"
                      >
                        Edit
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="bg-white rounded-lg shadow border border-gray-200 p-8 text-center">
              <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <p class="text-gray-500 mb-3">You haven't published any articles yet</p>
              <a
                href="/articles/new"
                class="inline-block px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium text-sm"
              >
                Create Your First Article
              </a>
            </div>
          )}
        </div>
      )}

      <!-- Draft Articles Section (if authenticated) -->
      {currentUserId && myDrafts && (
        <div class="lg:col-span-1">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-bold text-gray-900">My Drafts</h2>
            {myDrafts.meta.total > 0 && (
              <a href="/dashboard/drafts" class="text-blue-600 hover:text-blue-700 text-sm font-medium">
                View all ({myDrafts.meta.total}) →
              </a>
            )}
          </div>

          {myDrafts.data.length > 0 ? (
            <div class="space-y-4">
              {myDrafts.data.map(article => (
                <div class="bg-white rounded-lg shadow border border-gray-200 p-4 hover:shadow-md transition-shadow">
                  <div class="flex items-start justify-between mb-2">
                    <h3 class="font-semibold text-gray-900">
                      <a href={`/articles/${article.slug}/edit`} class="hover:text-blue-600">
                        {article.title}
                      </a>
                    </h3>
                    <span class="px-2 py-1 bg-orange-100 text-orange-700 text-xs font-medium rounded-full">
                      Draft
                    </span>
                  </div>
                  {article.excerpt && (
                    <p class="text-sm text-gray-600 line-clamp-2 mb-3">
                      {article.excerpt}
                    </p>
                  )}
                  <div class="flex items-center justify-between text-xs text-gray-500">
                    <time>{new Date(article.updatedAt || article.createdAt || '').toLocaleDateString()}</time>
                    <div class="flex gap-2">
                      <a
                        href={`/articles/${article.slug}/edit`}
                        class="text-blue-600 hover:text-blue-700 font-medium"
                      >
                        Continue Editing
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="bg-white rounded-lg shadow border border-gray-200 p-8 text-center">
              <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              <p class="text-gray-500">No draft articles</p>
            </div>
          )}
        </div>
      )}

      <!-- Activity Feed -->
      <div class={currentUserId ? "lg:col-span-1" : "lg:col-span-2"}>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold text-gray-900">Recent Activity</h2>
          <a href="/dashboard/activity" class="text-blue-600 hover:text-blue-700 text-sm font-medium">
            View all →
          </a>
        </div>

        {/* Show comments and suggestions on user's articles if available */}
        {currentUserId && articlesWithComments.length > 0 && (
          <div class="space-y-4 mb-4">
            {articlesWithComments.map(({ article, comments, suggestions }) => (
              <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg border border-blue-200 p-4">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="font-semibold text-gray-900 text-sm">
                    💬 Activity on "{article.title}"
                  </h3>
                  <a href={`/articles/${article.slug}`} class="text-blue-600 hover:text-blue-700 text-xs">
                    View →
                  </a>
                </div>
                
                {comments.length > 0 && (
                  <div class="mb-2">
                    {comments.map(comment => (
                      <div class="text-xs text-gray-700 mb-1 pl-3 border-l-2 border-blue-300">
                        <span class="font-medium">{comment.user?.name || 'Anonymous'}:</span> {comment.content?.substring(0, 60)}...
                      </div>
                    ))}
                  </div>
                )}
                
                {suggestions.length > 0 && (
                  <div>
                    <p class="text-xs text-gray-600 font-medium mb-1">📝 {suggestions.length} pending edit suggestion{suggestions.length > 1 ? 's' : ''}</p>
                  </div>
                )}
              </div>
            ))}
          </div>
        )}

        {recentActivity.data.length > 0 ? (
          <div class="space-y-4">
            {recentActivity.data.map(activity => (
              <div class="bg-white rounded-lg shadow border border-gray-200 p-4">
                <div class="flex items-start gap-3">
                  <div class="flex-shrink-0">
                    {activity.type === 'article_created' && (
                      <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                        <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                      </div>
                    )}
                    {activity.type === 'article_published' && (
                      <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </div>
                    )}
                    {(activity.type === 'article_updated' || activity.type === 'revision_created') && (
                      <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                        <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                      </div>
                    )}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm text-gray-900">
                      <span class="font-medium">{activity.editor?.name || 'Unknown'}</span>
                      {activity.type === 'article_created' && ' created '}
                      {activity.type === 'article_published' && ' published '}
                      {activity.type === 'article_updated' && ' updated '}
                      {activity.type === 'revision_created' && ' edited '}
                      <a href={`/articles/${activity.article.slug}`} class="text-blue-600 hover:text-blue-700 font-medium">
                        {activity.article.title}
                      </a>
                    </p>
                    {activity.revision?.changeReason && (
                      <p class="text-xs text-gray-500 mt-1 truncate">
                        {activity.revision.changeReason}
                      </p>
                    )}
                    <p class="text-xs text-gray-500 mt-1">
                      <time datetime={activity.timestamp.toISOString()}>
                        {activity.timestamp.toLocaleString()}
                      </time>
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="bg-white rounded-lg shadow border border-gray-200 p-8 text-center">
            <p class="text-gray-500">No recent activity</p>
          </div>
        )}
      </div>
    </div>

    <!-- Pending Reviews (Full Width) -->
    <div class="mt-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-bold text-gray-900">Pending Reviews</h2>
        <a href="/dashboard/pending" class="text-blue-600 hover:text-blue-700 text-sm font-medium">
          View all →
        </a>
      </div>

      {pendingReviews.data.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {pendingReviews.data.map(article => (
            <div class="bg-white rounded-lg shadow border border-gray-200 p-4 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between mb-2">
                <h3 class="font-semibold text-gray-900">
                  <a href={`/articles/${article.slug}`} class="hover:text-blue-600">
                    {article.title}
                  </a>
                </h3>
              </div>
              {article.excerpt && (
                <p class="text-sm text-gray-600 line-clamp-2 mb-3">
                  {article.excerpt}
                </p>
              )}
              <div class="flex items-center justify-between text-xs text-gray-500">
                <span>By {article.author?.name || 'Unknown'}</span>
                <a
                  href={`/articles/${article.slug}`}
                  class="px-3 py-1 bg-blue-100 text-blue-700 rounded hover:bg-blue-200 font-medium"
                >
                  Review
                </a>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="bg-white rounded-lg shadow border border-gray-200 p-8 text-center">
          <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-gray-500">No pending reviews</p>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
