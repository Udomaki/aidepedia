---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/auth';
import { getAuthorStats, listArticles } from '@aidepedia/db';

export const prerender = false;

// Check authentication
const session = await getSession(Astro.request);
if (!session?.user?.id) {
  return Astro.redirect('/login?redirect=/dashboard/stats');
}

// Get query params for time range
const url = Astro.url;
const days = parseInt(url.searchParams.get('days') || '30');

// Get author stats
let stats;
try {
  stats = await getAuthorStats(parseInt(session.user.id as string), days);
} catch (error) {
  console.error('Error fetching author stats:', error);
  stats = null;
}

// Format number for display
function formatNumber(num: number): string {
  if (num >= 1000000) {
    return (num / 1000000).toFixed(1) + 'M';
  }
  if (num >= 1000) {
    return (num / 1000).toFixed(1) + 'K';
  }
  return num.toString();
}

// Format time for display
function formatReadTime(seconds: number | null): string {
  if (seconds === null) return 'N/A';
  const minutes = Math.floor(seconds / 60);
  const secs = Math.round(seconds % 60);
  if (minutes > 0) {
    return `${minutes}m ${secs}s`;
  }
  return `${secs}s`;
}

// Format date
function formatDate(date: Date | string | null): string {
  if (!date) return 'N/A';
  return new Date(date).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<Layout title="My Statistics - AIdepedia">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2">My Statistics</h1>
        <p class="text-gray-600">
          View detailed analytics for your articles.
        </p>
      </div>
      <div class="flex items-center gap-4">
        <a
          href="/dashboard"
          class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
        >
          ← Back to Dashboard
        </a>
        <select
          id="time-range"
          class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="7" selected={days === 7}>Last 7 days</option>
          <option value="30" selected={days === 30}>Last 30 days</option>
          <option value="90" selected={days === 90}>Last 90 days</option>
          <option value="365" selected={days === 365}>Last year</option>
        </select>
      </div>
    </div>

    {stats ? (
      <>
        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-medium text-gray-600">Total Views</h3>
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <p class="text-3xl font-bold text-gray-900">{formatNumber(stats.totalViews)}</p>
            <p class="text-sm text-gray-500 mt-1">{formatNumber(stats.uniqueVisitors)} unique visitors</p>
          </div>

          <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-medium text-gray-600">Articles</h3>
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <p class="text-3xl font-bold text-gray-900">{stats.totalArticles}</p>
            <p class="text-sm text-gray-500 mt-1">{stats.publishedArticles} published</p>
          </div>

          <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-medium text-gray-600">Engagement</h3>
              <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <p class="text-3xl font-bold text-gray-900">{formatNumber(stats.totalReactions)}</p>
            <p class="text-sm text-gray-500 mt-1">{formatNumber(stats.totalComments)} comments</p>
          </div>

          <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-medium text-gray-600">Avg. Read Time</h3>
              <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="text-3xl font-bold text-gray-900">{formatReadTime(stats.avgReadTimeSeconds)}</p>
            <p class="text-sm text-gray-500 mt-1">
              {stats.avgScrollDepth !== null ? `${Math.round(stats.avgScrollDepth)}% avg scroll` : 'No scroll data'}
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Views Over Time Chart -->
          <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Views Over Time</h2>
            {stats.viewsOverTime.length > 0 ? (
              <div class="h-64" id="views-chart-container">
                <canvas id="views-chart"></canvas>
              </div>
            ) : (
              <div class="h-64 flex items-center justify-center text-gray-500">
                No views data available for this period
              </div>
            )}
          </div>

          <!-- Top Performing Articles -->
          <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Top Performing Articles</h2>
            {stats.topArticles.length > 0 ? (
              <div class="space-y-4">
                {stats.topArticles.map((article, index) => (
                  <div class="flex items-start gap-4 p-3 rounded-lg hover:bg-gray-50 transition-colors">
                    <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold">
                      {index + 1}
                    </div>
                    <div class="flex-1 min-w-0">
                      <a
                        href={`/articles/${article.slug}`}
                        class="font-medium text-gray-900 hover:text-blue-600 line-clamp-1"
                      >
                        {article.title}
                      </a>
                      <div class="flex items-center gap-4 mt-1 text-sm text-gray-500">
                        <span>{formatNumber(article.views)} views</span>
                        <span>{formatNumber(article.reactions)} reactions</span>
                        {article.avgReadTimeSeconds && (
                          <span>{formatReadTime(article.avgReadTimeSeconds)} avg read</span>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="h-64 flex items-center justify-center text-gray-500">
                No articles with views yet
              </div>
            )}
          </div>
        </div>

        <!-- Recent Articles -->
        <div class="mt-8 bg-white rounded-xl shadow-md border border-gray-200 p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Recent Articles</h2>
          {stats.recentArticles.length > 0 ? (
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead>
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Published</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Views</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  {stats.recentArticles.map((article) => (
                    <tr class="hover:bg-gray-50">
                      <td class="px-4 py-4 whitespace-nowrap">
                        <a
                          href={`/articles/${article.slug}`}
                          class="font-medium text-blue-600 hover:text-blue-700"
                        >
                          {article.title}
                        </a>
                        {article.excerpt && (
                          <p class="text-sm text-gray-500 line-clamp-1 mt-1">{article.excerpt}</p>
                        )}
                      </td>
                      <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500">
                        {formatDate(article.publishedAt)}
                      </td>
                      <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500">
                        {formatNumber(article.views)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="py-12 text-center text-gray-500">
              You haven't published any articles yet.
              <a href="/articles/new" class="text-blue-600 hover:text-blue-700 ml-1">
                Create your first article →
              </a>
            </div>
          )}
        </div>
      </>
    ) : (
      <div class="bg-white rounded-xl shadow-md border border-gray-200 p-12 text-center">
        <p class="text-gray-500">Unable to load statistics. Please try again later.</p>
      </div>
    )}
  </div>
</Layout>

<script>
  // Handle time range change
  document.getElementById('time-range')?.addEventListener('change', (e) => {
    const target = e.target as HTMLSelectElement;
    const url = new URL(window.location.href);
    url.searchParams.set('days', target.value);
    window.location.href = url.toString();
  });

  // Simple chart rendering
  const viewsData = document.querySelector('#views-chart-container')?.getAttribute('data-views');
  if (viewsData) {
    const data = JSON.parse(viewsData);
    // Basic canvas chart - you might want to use a library like Chart.js for production
    const canvas = document.getElementById('views-chart') as HTMLCanvasElement;
    if (canvas && data.length > 0) {
      const ctx = canvas.getContext('2d');
      if (ctx) {
        const width = canvas.parentElement?.clientWidth || 400;
        const height = 256;
        canvas.width = width;
        canvas.height = height;

        const maxViews = Math.max(...data.map((d: any) => d.views));
        const barWidth = width / data.length - 2;

        ctx.fillStyle = '#3b82f6';
        data.forEach((d: any, i: number) => {
          const barHeight = (d.views / maxViews) * (height - 40);
          ctx.fillRect(i * (barWidth + 2), height - barHeight - 20, barWidth, barHeight);
        });
      }
    }
  }
</script>

<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
