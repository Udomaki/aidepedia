---
import { getPendingReviews, approveArticle, rejectArticle } from '@aidepedia/db';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// Get page from query params
const url = Astro.url;
const page = parseInt(url.searchParams.get('page') || '1', 10);

// Fetch pending reviews
const result = await getPendingReviews({ page, limit: 20 });
const pendingArticles = result.data;

// Handle form submissions for approve/reject
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;
  const articleId = parseInt(formData.get('articleId') as string, 10);
  const reason = formData.get('reason') as string;

  if (action === 'approve') {
    // Using editor ID 1 for now (would be authenticated user in real app)
    await approveArticle(articleId, 1);
    return Astro.redirect('/dashboard/pending');
  } else if (action === 'reject') {
    await rejectArticle(articleId, 1, reason);
    return Astro.redirect('/dashboard/pending');
  }
}
---

<Layout title="Pending Reviews - Dashboard">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 mb-2">Pending Reviews</h1>
          <p class="text-gray-600">
            Review and approve or reject articles awaiting publication.
          </p>
        </div>
        <a
          href="/dashboard"
          class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium"
        >
          ← Back to Dashboard
        </a>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6 mb-8">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600">Total Pending</p>
          <p class="text-3xl font-bold text-gray-900">{result.meta.total}</p>
        </div>
        <div class="flex gap-4">
          <div class="text-right">
            <p class="text-sm text-gray-600">Page</p>
            <p class="text-lg font-semibold text-gray-900">
              {result.meta.page} of {result.meta.totalPages}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Pending Articles List -->
    {pendingArticles.length > 0 ? (
      <div class="space-y-6">
        {pendingArticles.map(article => (
          <article class="bg-white rounded-xl shadow-md border border-gray-200 overflow-hidden">
            <div class="p-6">
              <div class="flex items-start justify-between gap-6 mb-4">
                <div class="flex-1">
                  <h2 class="text-2xl font-bold text-gray-900 mb-2">
                    <a href={`/articles/${article.slug}`} class="hover:text-blue-600">
                      {article.title}
                    </a>
                  </h2>
                  
                  {article.excerpt && (
                    <p class="text-gray-600 mb-4">
                      {article.excerpt}
                    </p>
                  )}

                  <div class="flex items-center gap-4 text-sm text-gray-500">
                    <span class="flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                      {article.author?.name || 'Unknown Author'}
                    </span>
                    <span>•</span>
                    <span class="flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      {new Date(article.createdAt || '').toLocaleDateString()}
                    </span>
                    {article.categoryId && (
                      <>
                        <span>•</span>
                        <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs font-medium">
                          Category
                        </span>
                      </>
                    )}
                  </div>

                  {article.tags && article.tags.length > 0 && (
                    <div class="flex gap-2 mt-3">
                      {article.tags.map(tag => (
                        <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded-full">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>

              <!-- Actions -->
              <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
                <a
                  href={`/articles/${article.slug}`}
                  class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium text-sm"
                >
                  View Full Article
                </a>
                
                <form method="POST" class="inline">
                  <input type="hidden" name="articleId" value={article.id} />
                  <input type="hidden" name="action" value="approve" />
                  <button
                    type="submit"
                    class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium text-sm"
                  >
                    Approve
                  </button>
                </form>

                <form method="POST" class="inline flex gap-2">
                  <input type="hidden" name="articleId" value={article.id} />
                  <input type="hidden" name="action" value="reject" />
                  <input
                    type="text"
                    name="reason"
                    placeholder="Rejection reason (optional)"
                    class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  />
                  <button
                    type="submit"
                    class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium text-sm"
                  >
                    Reject
                  </button>
                </form>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-xl shadow-md border border-gray-200 p-16 text-center">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">All caught up!</h3>
        <p class="text-gray-600">No articles pending review at the moment.</p>
      </div>
    )}

    <!-- Pagination -->
    {result.meta.totalPages > 1 && (
      <div class="mt-8 flex justify-center gap-2">
        {result.meta.page > 1 && (
          <a
            href={`/dashboard/pending?page=${result.meta.page - 1}`}
            class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-100 border border-gray-200"
          >
            ← Previous
          </a>
        )}
        
        {Array.from({ length: Math.min(5, result.meta.totalPages) }, (_, i) => {
          const pageNum = i + 1;
          return (
            <a
              href={`/dashboard/pending?page=${pageNum}`}
              class={`px-4 py-2 rounded-lg ${
                pageNum === result.meta.page
                  ? 'bg-blue-600 text-white'
                  : 'bg-white text-gray-700 hover:bg-gray-100 border border-gray-200'
              }`}
            >
              {pageNum}
            </a>
          );
        })}
        
        {result.meta.page < result.meta.totalPages && (
          <a
            href={`/dashboard/pending?page=${result.meta.page + 1}`}
            class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-100 border border-gray-200"
          >
            Next →
          </a>
        )}
      </div>
    )}
  </div>
</Layout>
