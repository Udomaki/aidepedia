---
import { getActivityFeed } from '@aidepedia/db';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// Get page from query params
const url = Astro.url;
const page = parseInt(url.searchParams.get('page') || '1', 10);

// Fetch activity feed
const result = await getActivityFeed({ page, limit: 30 });
const activities = result.data;
---

<Layout title="Activity Feed - Dashboard">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 mb-2">Activity Feed</h1>
          <p class="text-gray-600">
            Track all edits, approvals, and new articles across AIdepedia.
          </p>
        </div>
        <a
          href="/dashboard"
          class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium"
        >
          ← Back to Dashboard
        </a>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-4 mb-8">
      <div class="flex items-center justify-between">
        <div class="flex gap-2">
          <button class="px-4 py-2 bg-blue-600 text-white rounded-lg font-medium text-sm">
            All Activity
          </button>
          <button class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-100 font-medium text-sm border border-gray-200">
            Edits
          </button>
          <button class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-100 font-medium text-sm border border-gray-200">
            New Articles
          </button>
          <button class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-100 font-medium text-sm border border-gray-200">
            Approvals
          </button>
        </div>
        <div class="text-sm text-gray-600">
          {result.meta.total} total activities
        </div>
      </div>
    </div>

    <!-- Activity List -->
    {activities.length > 0 ? (
      <div class="space-y-4">
        {activities.map(activity => (
          <div class="bg-white rounded-lg shadow border border-gray-200 p-6 hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4">
              {/* Icon */}
              <div class="flex-shrink-0">
                {activity.type === 'article_created' && (
                  <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                  </div>
                )}
                {activity.type === 'article_published' && (
                  <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                )}
                {activity.type === 'article_updated' && (
                  <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                  </div>
                )}
                {activity.type === 'revision_created' && (
                  <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  </div>
                )}
              </div>

              {/* Content */}
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between">
                  <div>
                    <p class="text-base text-gray-900">
                      <span class="font-semibold">{activity.editor?.name || 'Unknown Editor'}</span>
                      <span class="text-gray-600">
                        {activity.type === 'article_created' && ' created a new article '}
                        {activity.type === 'article_published' && ' published '}
                        {activity.type === 'article_updated' && ' updated '}
                        {activity.type === 'revision_created' && ' made an edit to '}
                      </span>
                      <a 
                        href={`/articles/${activity.article.slug}`} 
                        class="text-blue-600 hover:text-blue-700 font-semibold"
                      >
                        {activity.article.title}
                      </a>
                    </p>

                    {activity.revision?.changeReason && (
                      <p class="text-sm text-gray-600 mt-1 italic">
                        "{activity.revision.changeReason}"
                      </p>
                    )}

                    <div class="flex items-center gap-4 mt-2 text-xs text-gray-500">
                      <time datetime={activity.timestamp.toISOString()}>
                        {activity.timestamp.toLocaleString()}
                      </time>
                      {activity.revision && (
                        <>
                          <span>•</span>
                          <a 
                            href={`/articles/${activity.article.slug}/revisions/${activity.revision.id}`}
                            class="text-blue-600 hover:text-blue-700"
                          >
                            View revision
                          </a>
                        </>
                      )}
                    </div>
                  </div>

                  {/* Article Status Badge */}
                  <div class="ml-4">
                    {activity.article.status === 'published' && (
                      <span class="px-3 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">
                        Published
                      </span>
                    )}
                    {activity.article.status === 'pending_review' && (
                      <span class="px-3 py-1 bg-yellow-100 text-yellow-700 text-xs font-medium rounded-full">
                        Pending
                      </span>
                    )}
                    {activity.article.status === 'draft' && (
                      <span class="px-3 py-1 bg-gray-100 text-gray-700 text-xs font-medium rounded-full">
                        Draft
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-xl shadow-md border border-gray-200 p-16 text-center">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
        </svg>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">No activity yet</h3>
        <p class="text-gray-600">Start creating and editing articles to see activity here.</p>
      </div>
    )}

    <!-- Pagination -->
    {result.meta.totalPages > 1 && (
      <div class="mt-8 flex justify-center gap-2">
        {result.meta.page > 1 && (
          <a
            href={`/dashboard/activity?page=${result.meta.page - 1}`}
            class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-100 border border-gray-200"
          >
            ← Previous
          </a>
        )}
        
        {Array.from({ length: Math.min(5, result.meta.totalPages) }, (_, i) => {
          const pageNum = i + 1;
          return (
            <a
              href={`/dashboard/activity?page=${pageNum}`}
              class={`px-4 py-2 rounded-lg ${
                pageNum === result.meta.page
                  ? 'bg-blue-600 text-white'
                  : 'bg-white text-gray-700 hover:bg-gray-100 border border-gray-200'
              }`}
            >
              {pageNum}
            </a>
          );
        })}
        
        {result.meta.page < result.meta.totalPages && (
          <a
            href={`/dashboard/activity?page=${result.meta.page + 1}`}
            class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-100 border border-gray-200"
          >
            Next →
          </a>
        )}
      </div>
    )}
  </div>
</Layout>
