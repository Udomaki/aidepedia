---
import { listArticles } from '@aidepedia/db';
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/auth';

export const prerender = false;

// Check authentication
const session = await getSession(Astro.request);
if (!session?.user?.id) {
  return Astro.redirect('/login?redirect=/dashboard/drafts');
}

// Get query params for pagination
const url = Astro.url;
const page = parseInt(url.searchParams.get('page') || '1', 10);
const currentUserId = parseInt(session.user.id as string);

// Fetch user's draft articles
const result = await listArticles({
  authorId: currentUserId,
  status: 'draft',
  page,
  limit: 20,
  sortBy: 'date',
  sortOrder: 'desc'
});

const drafts = result.data;
---

<Layout title="My Drafts - Dashboard">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 mb-2">My Drafts</h1>
          <p class="text-gray-600">
            Continue working on your draft articles.
          </p>
        </div>
        <div class="flex items-center gap-4">
          <a
            href="/articles/new"
            class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
          >
            ✍️ New Draft
          </a>
          <a
            href="/dashboard"
            class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
          >
            ← Back to Dashboard
          </a>
        </div>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6 mb-8">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600">Total Drafts</p>
          <p class="text-3xl font-bold text-gray-900">{result.meta.total}</p>
        </div>
        <div class="flex gap-4">
          <div class="text-right">
            <p class="text-sm text-gray-600">Page</p>
            <p class="text-lg font-semibold text-gray-900">
              {result.meta.page} of {result.meta.totalPages}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Drafts List -->
    {drafts.length > 0 ? (
      <div class="space-y-4">
        {drafts.map(draft => (
          <article class="bg-white rounded-xl shadow-md border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <div class="p-6">
              <div class="flex items-start justify-between gap-6 mb-4">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <h2 class="text-2xl font-bold text-gray-900">
                      {draft.title}
                    </h2>
                    <span class="px-3 py-1 bg-orange-100 text-orange-700 text-xs font-medium rounded-full">
                      Draft
                    </span>
                  </div>
                  
                  {draft.excerpt && (
                    <p class="text-gray-600 mb-4">
                      {draft.excerpt}
                    </p>
                  )}

                  <div class="flex items-center gap-4 text-sm text-gray-500">
                    <span class="flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      Created {new Date(draft.createdAt || '').toLocaleDateString()}
                    </span>
                    <span>•</span>
                    <span class="flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                      Updated {new Date(draft.updatedAt || '').toLocaleDateString()}
                    </span>
                    {draft.categoryId && (
                      <>
                        <span>•</span>
                        <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs font-medium">
                          Category
                        </span>
                      </>
                    )}
                  </div>

                  {draft.tags && draft.tags.length > 0 && (
                    <div class="flex gap-2 mt-3">
                      {draft.tags.map(tag => (
                        <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded-full">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>

              <!-- Actions -->
              <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
                <a
                  href={`/articles/${draft.slug}/edit`}
                  class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium text-sm"
                >
                  Continue Editing
                </a>
                
                <a
                  href={`/articles/${draft.slug}`}
                  class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors font-medium text-sm"
                >
                  Preview
                </a>

                <button
                  class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium text-sm"
                  onclick="if(confirm('Submit for review?')) { /* Submit logic */ }"
                >
                  Submit for Review
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-xl shadow-md border border-gray-200 p-16 text-center">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">No draft articles</h3>
        <p class="text-gray-600 mb-6">Start writing your first article!</p>
        <a
          href="/articles/new"
          class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
        >
          Create Your First Article
        </a>
      </div>
    )}

    <!-- Pagination -->
    {result.meta.totalPages > 1 && (
      <div class="mt-8 flex justify-center gap-2">
        {result.meta.page > 1 && (
          <a
            href={`/dashboard/drafts?page=${result.meta.page - 1}`}
            class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-100 border border-gray-200"
          >
            ← Previous
          </a>
        )}
        
        {Array.from({ length: Math.min(5, result.meta.totalPages) }, (_, i) => {
          const pageNum = i + 1;
          return (
            <a
              href={`/dashboard/drafts?page=${pageNum}`}
              class={`px-4 py-2 rounded-lg ${
                pageNum === result.meta.page
                  ? 'bg-blue-600 text-white'
                  : 'bg-white text-gray-700 hover:bg-gray-100 border border-gray-200'
              }`}
            >
              {pageNum}
            </a>
          );
        })}
        
        {result.meta.page < result.meta.totalPages && (
          <a
            href={`/dashboard/drafts?page=${result.meta.page + 1}`}
            class="px-4 py-2 bg-white text-gray-700 rounded-lg hover:bg-gray-100 border border-gray-200"
          >
            Next →
          </a>
        )}
      </div>
    )}
  </div>
</Layout>
