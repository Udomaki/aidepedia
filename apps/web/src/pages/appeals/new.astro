---
import Layout from '../../layouts/Layout.astro';
import { getUserModerationActions } from '@aidepedia/db';

export const prerender = false;

// In production, get user ID from session
const userId = 1; // TODO: Get from session

let actions: any[] = [];
try {
  actions = await getUserModerationActions(userId);
} catch (error) {
  console.error('Error fetching user actions:', error);
}
---

<Layout title="Submit Appeal">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Submit an Appeal</h1>
      <p class="text-gray-600">
        If you believe a moderation action was taken in error, you can submit an appeal for review.
      </p>
    </div>

    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-8">
      <form id="appealForm" class="space-y-6">
        <!-- Select Action -->
        <div>
          <label for="actionId" class="block text-sm font-medium text-gray-700 mb-2">
            Select Moderation Action
          </label>
          <select
            id="actionId"
            name="actionId"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option value="">Choose an action to appeal...</option>
            {actions.map((action: any) => (
              <option value={action.id}>
                {action.actionType.replace('_', ' ')} - {new Date(action.createdAt).toLocaleDateString()}
                {action.reason && ` - ${action.reason.substring(0, 50)}...`}
              </option>
            ))}
          </select>
        </div>

        <!-- Appeal Text -->
        <div>
          <label for="appealText" class="block text-sm font-medium text-gray-700 mb-2">
            Why should this action be reversed?
          </label>
          <textarea
            id="appealText"
            name="appealText"
            rows={6}
            required
            placeholder="Please explain why you believe this moderation action was incorrect. Be specific and provide any relevant context."
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <p class="text-sm text-gray-500 mt-1">
            Be clear and specific. Appeals are reviewed by human moderators.
          </p>
        </div>

        <!-- Additional Evidence -->
        <div>
          <label for="additionalEvidence" class="block text-sm font-medium text-gray-700 mb-2">
            Additional Evidence (Optional)
          </label>
          <textarea
            id="additionalEvidence"
            name="additionalEvidence"
            rows={3}
            placeholder="Links to relevant content, screenshots, or other evidence that supports your appeal"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
        </div>

        <!-- Guidelines -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
          <h3 class="text-sm font-medium text-blue-900 mb-2">Appeal Guidelines</h3>
          <ul class="text-sm text-blue-700 space-y-1">
            <li>• Be respectful and professional</li>
            <li>• Provide specific reasons why the action was incorrect</li>
            <li>• Include any relevant context or evidence</li>
            <li>• Appeals are usually reviewed within 24-48 hours</li>
            <li>• Multiple appeals for the same action may slow down the process</li>
          </ul>
        </div>

        <!-- Submit Button -->
        <div class="flex gap-4">
          <button
            type="submit"
            class="flex-1 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
          >
            Submit Appeal
          </button>
          <a
            href="/"
            class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium text-center"
          >
            Cancel
          </a>
        </div>
      </form>
    </div>

    <!-- Appeal History -->
    {actions.length > 0 && (
      <div class="mt-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Your Moderation History</h2>
        <div class="bg-white rounded-xl shadow-md border border-gray-200 overflow-hidden">
          <div class="divide-y divide-gray-200">
            {actions.map((action: any) => (
              <div class="p-4">
                <div class="flex items-center justify-between">
                  <div>
                    <span class={`inline-block px-2 py-0.5 rounded text-xs font-medium ${
                      action.actionType === 'warn' ? 'bg-yellow-100 text-yellow-700' :
                      action.actionType === 'temp_ban' ? 'bg-orange-100 text-orange-700' :
                      action.actionType === 'permaban' ? 'bg-red-100 text-red-700' :
                      action.actionType === 'content_removed' ? 'bg-red-100 text-red-700' :
                      'bg-gray-100 text-gray-700'
                    }`}>
                      {action.actionType.replace('_', ' ')}
                    </span>
                    <span class="text-sm text-gray-500 ml-2">
                      {new Date(action.createdAt).toLocaleDateString()}
                    </span>
                  </div>
                </div>
                {action.reason && (
                  <p class="text-sm text-gray-600 mt-2">{action.reason}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>

<script>
  const form = document.getElementById('appealForm') as HTMLFormElement;
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = {
      actionId: parseInt(formData.get('actionId') as string),
      appealText: formData.get('appealText'),
      additionalEvidence: formData.get('additionalEvidence'),
      appellantId: 1, // TODO: Get from session
    };
    
    try {
      const response = await fetch('/api/appeals', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      
      if (response.ok) {
        alert('Appeal submitted successfully! You will be notified when it is reviewed.');
        window.location.href = '/';
      } else {
        const error = await response.json();
        alert(error.error || 'Failed to submit appeal');
      }
    } catch (error) {
      console.error('Error submitting appeal:', error);
      alert('Failed to submit appeal. Please try again.');
    }
  });
</script>
