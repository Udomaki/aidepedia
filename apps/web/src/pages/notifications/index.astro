---
import Layout from '../../layouts/Layout.astro';

// Mock notifications - in production this would come from API/database
const notifications = [
  {
    id: '1',
    type: 'article_approved',
    title: 'Article Approved!',
    message: 'Your article "Quantum Computing Basics" has been approved and published.',
    articleSlug: 'quantum-computing-basics',
    timestamp: '2026-04-01T01:45:00Z',
    read: false,
    points: 25,
  },
  {
    id: '2',
    type: 'vote_received',
    title: 'New Vote on Your Article',
    message: 'Your article "Machine Learning Fundamentals" received an approval vote.',
    articleSlug: 'machine-learning-fundamentals',
    timestamp: '2026-03-31T22:30:00Z',
    read: false,
    points: 5,
  },
  {
    id: '3',
    type: 'reputation_milestone',
    title: 'Reputation Milestone Reached!',
    message: 'Congratulations! You\'ve reached 1,250 reputation points.',
    timestamp: '2026-03-31T18:15:00Z',
    read: true,
    points: 50,
  },
  {
    id: '4',
    type: 'article_rejected',
    title: 'Article Needs Revision',
    message: 'Your article "Advanced Neural Networks" was rejected. Please review the feedback and resubmit.',
    articleSlug: 'advanced-neural-networks',
    timestamp: '2026-03-31T14:20:00Z',
    read: true,
    points: -10,
  },
  {
    id: '5',
    type: 'edit_accepted',
    title: 'Edit Accepted',
    message: 'Your edit to "Deep Learning Architecture" has been accepted.',
    articleSlug: 'deep-learning-architecture',
    timestamp: '2026-03-30T09:15:00Z',
    read: true,
    points: 15,
  },
  {
    id: '6',
    type: 'badge_earned',
    title: 'New Badge Earned!',
    message: 'You\'ve earned the "Quality Editor" badge for maintaining high standards.',
    timestamp: '2026-03-29T16:45:00Z',
    read: true,
  },
];

function formatTimestamp(timestamp: string): string {
  const date = new Date(timestamp);
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffMins = Math.floor(diffMs / (1000 * 60));
  const diffHours = Math.floor(diffMins / 60);
  const diffDays = Math.floor(diffHours / 24);
  
  if (diffDays > 7) {
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }
  if (diffDays > 0) return `${diffDays}d ago`;
  if (diffHours > 0) return `${diffHours}h ago`;
  if (diffMins > 0) return `${diffMins}m ago`;
  return 'Just now';
}

function getNotificationIcon(type: string): string {
  const icons: Record<string, string> = {
    article_approved: '✅',
    article_rejected: '❌',
    vote_received: '🗳️',
    reputation_milestone: '🏆',
    edit_accepted: '✏️',
    badge_earned: '🎖️',
  };
  return icons[type] || '📢';
}

function getNotificationColor(type: string): string {
  const colors: Record<string, string> = {
    article_approved: 'bg-green-50 border-green-200',
    article_rejected: 'bg-red-50 border-red-200',
    vote_received: 'bg-blue-50 border-blue-200',
    reputation_milestone: 'bg-yellow-50 border-yellow-200',
    edit_accepted: 'bg-purple-50 border-purple-200',
    badge_earned: 'bg-indigo-50 border-indigo-200',
  };
  return colors[type] || 'bg-gray-50 border-gray-200';
}

const unreadCount = notifications.filter(n => !n.read).length;
---

<Layout title="Notifications - AIdepedia">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Notifications</h1>
        <p class="text-gray-500 mt-1">
          {unreadCount > 0 ? `${unreadCount} unread notifications` : 'All caught up!'}
        </p>
      </div>
      {unreadCount > 0 && (
        <button class="px-4 py-2 text-sm font-medium text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors">
          Mark all as read
        </button>
      )}
    </div>

    <!-- Notifications List -->
    <div class="space-y-3">
      {notifications.map((notification) => (
        <div class={`rounded-xl border-2 ${getNotificationColor(notification.type)} p-5 transition-all hover:shadow-md ${!notification.read ? 'ring-2 ring-blue-400 ring-offset-2' : ''}`}>
          <div class="flex items-start space-x-4">
            <div class="text-3xl flex-shrink-0">
              {getNotificationIcon(notification.type)}
            </div>
            <div class="flex-grow min-w-0">
              <div class="flex items-start justify-between">
                <div>
                  <h3 class={`text-lg font-semibold ${!notification.read ? 'text-gray-900' : 'text-gray-700'}`}>
                    {notification.title}
                    {!notification.read && (
                      <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        New
                      </span>
                    )}
                  </h3>
                  <p class="text-gray-600 mt-1">{notification.message}</p>
                  {notification.articleSlug && (
                    <a 
                      href={`/articles/${notification.articleSlug}`}
                      class="inline-block mt-2 text-sm text-blue-600 hover:text-blue-800 font-medium"
                    >
                      View article →
                    </a>
                  )}
                </div>
                <div class="flex-shrink-0 text-right ml-4">
                  <div class="text-sm text-gray-500">{formatTimestamp(notification.timestamp)}</div>
                  {notification.points && notification.points > 0 && (
                    <div class="mt-1 text-sm font-semibold text-green-600">
                      +{notification.points} rep
                    </div>
                  )}
                  {notification.points && notification.points < 0 && (
                    <div class="mt-1 text-sm font-semibold text-red-600">
                      {notification.points} rep
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Empty State */}
    {notifications.length === 0 && (
      <div class="text-center py-16">
        <div class="text-6xl mb-4">🔔</div>
        <h2 class="text-2xl font-bold text-gray-900 mb-2">No notifications yet</h2>
        <p class="text-gray-500">When you receive notifications, they'll appear here.</p>
      </div>
    )}

    {/* Load More */}
    {notifications.length > 0 && (
      <div class="mt-8 text-center">
        <button class="px-6 py-3 bg-white border-2 border-gray-200 text-gray-700 rounded-xl font-medium hover:bg-gray-50 hover:border-gray-300 transition-all">
          Load older notifications
        </button>
      </div>
    )}
  </div>
</Layout>
