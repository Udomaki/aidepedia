---
import Layout from '../../layouts/Layout.astro';
import { getCategoryBySlug, listArticles } from '@aidepedia/db';

export function getStaticPaths() {
  // Mock data for static build - in production this would fetch from database
  return [
    { params: { slug: 'technology' } },
    { params: { slug: 'science' } },
    { params: { slug: 'history' } },
    { params: { slug: 'arts' } },
  ];
}

const { slug } = Astro.params;

let category;
let articles = [];

try {
  category = await getCategoryBySlug(slug!);
  const result = await listArticles({ 
    categoryId: category.id, 
    status: 'published',
    limit: 50 
  });
  articles = result.data;
} catch (error) {
  return Astro.redirect('/categories');
}
---

<Layout title={`${category.name} - AIdepedia`}>
  <div class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <a href="/categories" class="text-blue-600 hover:text-blue-700">
        ← Back to Categories
      </a>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-6 mb-8">
      <div class="flex items-start justify-between">
        <div>
          <h1 class="text-4xl font-bold mb-3">{category.name}</h1>
          {category.description && (
            <p class="text-gray-600 text-lg">{category.description}</p>
          )}
        </div>
        <div class="flex gap-2">
          <a
            href={`/categories/${category.slug}/edit`}
            class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded transition"
          >
            Edit
          </a>
        </div>
      </div>
      
      <div class="mt-4 pt-4 border-t border-gray-200">
        <span class="text-sm text-gray-500">
          {category.articleCount || 0} articles
        </span>
      </div>
    </div>

    {articles.length === 0 ? (
      <div class="text-center py-12">
        <p class="text-gray-500 text-lg">No articles in this category yet.</p>
      </div>
    ) : (
      <div>
        <h2 class="text-2xl font-bold mb-4">Articles</h2>
        <div class="space-y-4">
          {articles.map((article) => (
            <a
              href={`/articles/${article.slug}`}
              class="block p-6 bg-white rounded-lg border border-gray-200 hover:border-blue-500 hover:shadow-md transition"
            >
              <h3 class="text-xl font-semibold mb-2">{article.title}</h3>
              {article.excerpt && (
                <p class="text-gray-600 mb-3">{article.excerpt}</p>
              )}
              <div class="flex items-center gap-4 text-sm text-gray-500">
                <span>Quality Score: {article.qualityScore}</span>
                <span>•</span>
                <span>{article.viewCount} views</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
