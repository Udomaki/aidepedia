---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="New Category - AIdepedia">
  <div class="container mx-auto px-4 py-8 max-w-2xl">
    <div class="mb-6">
      <a href="/categories" class="text-blue-600 hover:text-blue-700">
        ← Back to Categories
      </a>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-6">
      <h1 class="text-3xl font-bold mb-6">Create New Category</h1>

      <form id="categoryForm" class="space-y-6">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
            Category Name *
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="e.g., Technology, Science, History"
          />
        </div>

        <div>
          <label for="slug" class="block text-sm font-medium text-gray-700 mb-2">
            Slug *
          </label>
          <input
            type="text"
            id="slug"
            name="slug"
            required
            pattern="[a-z0-9-]+"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="e.g., technology, science, history"
          />
          <p class="text-sm text-gray-500 mt-1">
            URL-friendly identifier. Use lowercase letters, numbers, and hyphens only.
          </p>
        </div>

        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
            Description
          </label>
          <textarea
            id="description"
            name="description"
            rows="3"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Brief description of this category..."
          ></textarea>
        </div>

        <div>
          <label for="displayOrder" class="block text-sm font-medium text-gray-700 mb-2">
            Display Order
          </label>
          <input
            type="number"
            id="displayOrder"
            name="displayOrder"
            value="0"
            min="0"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <p class="text-sm text-gray-500 mt-1">
            Categories are sorted by this number (lower numbers appear first).
          </p>
        </div>

        <div class="flex gap-4">
          <button
            type="submit"
            class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition"
          >
            Create Category
          </button>
          <a
            href="/categories"
            class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg transition"
          >
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('categoryForm') as HTMLFormElement;
  const nameInput = document.getElementById('name') as HTMLInputElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;

  // Auto-generate slug from name
  nameInput.addEventListener('input', (e) => {
    const name = (e.target as HTMLInputElement).value;
    const slug = name
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
    slugInput.value = slug;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      slug: formData.get('slug'),
      description: formData.get('description') || null,
      displayOrder: parseInt(formData.get('displayOrder') as string) || 0,
    };

    try {
      // Note: In a real app, this would call an API endpoint
      // For now, we'll just redirect back to categories
      alert('Category creation would happen here via API');
      window.location.href = '/categories';
    } catch (error) {
      alert('Failed to create category. Please try again.');
    }
  });
</script>
