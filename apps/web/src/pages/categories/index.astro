---
import Layout from '../../layouts/Layout.astro';
import { getCategories } from '@aidepedia/db';

const categories = await getCategories();
---

<Layout title="Categories - AIdepedia">
  <div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-4xl font-bold">Categories</h1>
      <a
        href="/categories/new"
        class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition"
      >
        New Category
      </a>
    </div>

    {categories.length === 0 ? (
      <div class="text-center py-12">
        <p class="text-gray-500 text-lg">No categories found.</p>
        <p class="text-gray-400 mt-2">Create your first category to get started!</p>
      </div>
    ) : (
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {categories.map((category) => (
          <a
            href={`/categories/${category.slug}`}
            class="block p-6 bg-white rounded-lg border border-gray-200 hover:border-blue-500 hover:shadow-md transition"
          >
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <h2 class="text-xl font-semibold mb-2">{category.name}</h2>
                {category.description && (
                  <p class="text-gray-600 text-sm mb-3">{category.description}</p>
                )}
                <div class="flex items-center gap-4 text-sm text-gray-500">
                  <span>{category.articleCount || 0} articles</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
