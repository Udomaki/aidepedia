---
import Layout from '../../layouts/Layout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import ReportButton from '../../components/ReportButton.astro';
import ReactionPicker from '../../components/ReactionPicker.astro';
import ArticleStatsCard from '../../components/ArticleStatsCard.astro';
import VotingWorkflow from '../../components/VotingWorkflow.astro';
import ExportButton from '../../components/ExportButton.astro';
import { getArticleBySlug, listArticles, getCategories, getCommentsByArticle, isBookmarked, getArticleTags } from '@aidepedia/db';
import { getSession } from '../../lib/auth';
import { generateArticleSchema, generateBreadcrumbSchema, generateOrganizationSchema, generateWebsiteSchema } from '../../lib/structured-data';

export async function getStaticPaths() {
  // Try to fetch all published articles for static generation
  // If database is not available, return empty array (will need SSR or manual build)
  try {
    const { data: articles } = await listArticles({ status: 'published', limit: 1000 });
    
    return articles.map((article) => ({
      params: { slug: article.slug },
    }));
  } catch (error) {
    console.warn('Could not fetch articles for static generation:', error);
    // Return empty array - pages will need to be generated dynamically or database must be available during build
    return [];
  }
}

const { slug } = Astro.params;

let article = null;

if (slug) {
  try {
    article = await getArticleBySlug(slug);
  } catch (e) {
    // Article not found, will redirect below
  }
}

if (!article) {
  return Astro.redirect('/articles');
}

// Fetch categories for lookup
const categories = await getCategories();
const categoryMap = new Map(categories.map(c => [c.id, c]));
const articleCategory = article.categoryId ? categoryMap.get(article.categoryId) : null;

// Fetch article tags
let articleTags = [];
try {
  articleTags = await getArticleTags(article.id);
} catch (e) {
  console.warn('Could not fetch article tags:', e);
}

// Fetch comments for the article
let comments = [];
try {
  comments = await getCommentsByArticle(article.id);
} catch (e) {
  console.warn('Could not fetch comments:', e);
}

// Check if user is logged in and has bookmarked this article
let isUserLoggedIn = false;
let isArticleBookmarked = false;
let isAuthor = false;
try {
  const session = await getSession(Astro.request);
  if (session?.user?.id) {
    isUserLoggedIn = true;
    isArticleBookmarked = await isBookmarked(parseInt(session.user.id as string), article.id);
    isAuthor = article.authorId === parseInt(session.user.id as string);
  }
} catch (e) {
  // User not logged in or error checking bookmark status
}

const pageTitle = `${article.title} - AIdepedia`;
const pageDescription = article.excerpt || `${article.title} - AIdepedia article`;
const pageUrl = Astro.url.href;
const pageImage = '/og-image.svg'; // Default OG image
const canonicalUrl = `https://aidepedia.com/articles/${article.slug}`;

// Generate structured data
const articleSchema = generateArticleSchema(article, articleCategory || undefined);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Articles', url: '/articles' },
  { name: article.title, url: `/articles/${article.slug}` }
]);
const organizationSchema = generateOrganizationSchema();
const websiteSchema = generateWebsiteSchema();

const structuredData = [organizationSchema, websiteSchema, breadcrumbSchema, articleSchema];

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(new Date(date));
}

function formatRelativeTime(date: Date): string {
  const now = new Date();
  const then = new Date(date);
  const diff = now.getTime() - then.getTime();
  
  const minutes = Math.floor(diff / 60000);
  const hours = Math.floor(diff / 3600000);
  const days = Math.floor(diff / 86400000);
  
  if (minutes < 1) return 'just now';
  if (minutes < 60) return `${minutes}m ago`;
  if (hours < 24) return `${hours}h ago`;
  if (days < 7) return `${days}d ago`;
  return formatDate(date);
}

function getCategoryColor(categoryName: string | undefined): string {
  const colors: Record<string, string> = {
    'technology': 'bg-blue-600',
    'wellness': 'bg-green-600',
    'philosophy': 'bg-purple-600',
  };
  return colors[(categoryName || '').toLowerCase()] || 'bg-gray-600';
}

// Count total comments including replies
function countAllComments(commentList: any[]): number {
  let count = commentList.length;
  for (const comment of commentList) {
    if (comment.replies && comment.replies.length > 0) {
      count += countAllComments(comment.replies);
    }
  }
  return count;
}

const totalComments = countAllComments(comments);
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  url={pageUrl} 
  image={pageImage} 
  type="article"
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  publishedTime={article.publishedAt || article.createdAt}
  modifiedTime={article.updatedAt}
  canEdit={isAuthor}
  articleSlug={slug}
>
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6">
      <a href="/" class="text-blue-600 hover:text-blue-700">Home</a>
      <span class="mx-2 text-gray-400">/</span>
      <a href="/articles" class="text-blue-600 hover:text-blue-700">Articles</a>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-gray-600">{article.title}</span>
    </nav>

    <article data-article-id={article.id} class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <!-- Header -->
      <header class="p-8 border-b border-gray-200">
        <div class="flex items-center gap-3 mb-4">
          {articleCategory && (
            <span class={`px-3 py-1 text-white text-sm font-medium rounded-full ${getCategoryColor(articleCategory.name)}`}>
              {articleCategory.name}
            </span>
          )}
          {article.status === 'published' && (
            <span class="text-green-600 text-sm">✓ Published</span>
          )}
        </div>
        
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{article.title}</h1>
        
        <!-- Action Buttons -->
        <div class="flex items-center gap-4 mb-4">
          {isUserLoggedIn && (
            <button
              id="bookmark-btn"
              data-article-slug={article.slug}
              data-bookmarked={isArticleBookmarked.toString()}
              class="flex items-center gap-2 px-4 py-2 rounded-lg transition-colors font-medium"
            >
              <span id="bookmark-icon" class="text-2xl">
                {isArticleBookmarked ? '🔖' : '📑'}
              </span>
              <span id="bookmark-text" class="text-gray-700">
                {isArticleBookmarked ? 'Bookmarked' : 'Save for later'}
              </span>
            </button>
          )}
          <ShareButtons url={pageUrl} title={pageTitle} description={pageDescription} />
          <ExportButton articleSlug={article.slug} articleTitle={article.title} isLoggedIn={isUserLoggedIn} />
        </div>
        
        {article.excerpt && (
          <p class="text-xl text-gray-600 mb-4">{article.excerpt}</p>
        )}
        
        <div class="flex items-center gap-4 text-sm text-gray-500">
          {article.createdAt && (
            <span>📅 {formatDate(article.createdAt)}</span>
          )}
          {article.publishedAt && (
            <span>✨ Published {formatDate(article.publishedAt)}</span>
          )}
          {article.readingTime && (
            <span>⏱ {article.readingTime} min read</span>
          )}
          {article.viewCount && article.viewCount > 0 && (
            <span>👁 {article.viewCount} views</span>
          )}
          {article.qualityScore !== null && article.qualityScore !== undefined && (
            <span>⭐ Quality: {article.qualityScore}</span>
          )}
        </div>

        {articleTags && articleTags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {articleTags.map((tag: any) => (
              <a 
                href={`/tags/${tag.slug}`}
                class="px-3 py-1 bg-gray-100 text-gray-700 text-sm rounded-full hover:bg-gray-200 transition-colors"
              >
                #{tag.name}
              </a>
            ))}
          </div>
        )}
      </header>

      <!-- Article Stats Card (visible to author only) -->
      <ArticleStatsCard articleId={article.id} slug={article.slug} isAuthor={isAuthor} />

      <!-- Voting Workflow -->
      <div class="p-8 border-b border-gray-200">
        <VotingWorkflow articleSlug={article.slug} articleId={article.id} isLoggedIn={isUserLoggedIn} />
      </div>

      <!-- Content -->
      <div class="p-8 prose prose-lg max-w-none">
        {article.content.split('\n\n').map((paragraph: string) => (
          <p class="mb-4 text-gray-700 leading-relaxed">{paragraph}</p>
        ))}
      </div>

      <!-- Reaction Picker -->
      <ReactionPicker articleId={article.id} articleSlug={article.slug} isLoggedIn={isUserLoggedIn} />

      <!-- Footer -->
      <footer class="p-8 bg-gray-50 border-t border-gray-200">
        <div class="flex items-center justify-between mb-4">
          <div class="text-sm text-gray-500">
            {article.updatedAt && <p>Last updated: {formatDate(article.updatedAt)}</p>}
          </div>
          <div class="flex gap-2 items-center">
            <ShareButtons url={pageUrl} title={pageTitle} description={pageDescription} />
            <button
              id="suggest-edit-btn"
              class="px-4 py-2 bg-green-100 text-green-700 rounded-lg hover:bg-green-200 transition-colors font-medium"
            >
              ✏️ Suggest Edit
            </button>
            <ReportButton contentType="article" contentId={article.id} isLoggedIn={isUserLoggedIn} />
            <a
              href={`/articles/${article.slug}/revisions`}
              class="px-4 py-2 bg-purple-100 text-purple-700 rounded-lg hover:bg-purple-200 transition-colors font-medium"
            >
              📜 View History
            </a>
            <a
              href="/articles"
              class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
            >
              ← Back to Articles
            </a>
          </div>
        </div>
      </footer>
    </article>

    <!-- Suggest Edit Modal -->
    <div id="suggest-edit-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
        <div class="p-6 border-b border-gray-200">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-bold text-gray-900">Suggest an Edit</h2>
            <button id="close-modal-btn" class="text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
          </div>
        </div>
        
        <form id="suggest-edit-form" class="p-6 space-y-6">
          <div>
            <label for="field-name" class="block text-sm font-medium text-gray-700 mb-2">
              Field to Edit
            </label>
            <select
              id="field-name"
              name="fieldName"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500"
              required
            >
              <option value="">Select a field...</option>
              <option value="title">Title</option>
              <option value="excerpt">Excerpt/Summary</option>
              <option value="content">Content</option>
            </select>
          </div>

          <div>
            <label for="old-value" class="block text-sm font-medium text-gray-700 mb-2">
              Current Value
            </label>
            <textarea
              id="old-value"
              name="oldValue"
              rows="3"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 bg-gray-50"
              readonly
            ></textarea>
          </div>

          <div>
            <label for="new-value" class="block text-sm font-medium text-gray-700 mb-2">
              Proposed New Value
            </label>
            <textarea
              id="new-value"
              name="newValue"
              rows="5"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500"
              placeholder="Enter the proposed new value..."
              required
            ></textarea>
          </div>

          <div>
            <label for="reason" class="block text-sm font-medium text-gray-700 mb-2">
              Reason for Edit (optional)
            </label>
            <textarea
              id="reason"
              name="reason"
              rows="3"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500"
              placeholder="Explain why this edit is needed..."
            ></textarea>
          </div>

          <div class="flex gap-3 justify-end">
            <button
              type="button"
              id="cancel-edit-btn"
              class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium"
            >
              Submit Suggestion
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Comments Section -->
    <section class="mt-8 bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-2xl font-bold text-gray-900">
          💬 Comments ({totalComments})
        </h2>
      </div>

      <!-- Comment Form -->
      <div class="p-6 border-b border-gray-200 bg-gray-50">
        <form id="comment-form" class="space-y-4">
          <div>
            <label for="comment-content" class="block text-sm font-medium text-gray-700 mb-2">
              Add a comment
            </label>
            <textarea
              id="comment-content"
              name="content"
              rows="3"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              placeholder="Share your thoughts..."
              required
            ></textarea>
          </div>
          <div class="flex items-center justify-between">
            <p id="auth-message" class="text-sm text-gray-500">
              <!-- Will be populated by client-side script -->
            </p>
            <button
              type="submit"
              class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Post Comment
            </button>
          </div>
        </form>
      </div>

      <!-- Comments List -->
      <div id="comments-list" class="divide-y divide-gray-200">
        {comments.length === 0 ? (
          <div class="p-8 text-center text-gray-500">
            <p class="text-lg mb-2">No comments yet</p>
            <p class="text-sm">Be the first to share your thoughts!</p>
          </div>
        ) : (
          comments.map((comment: any) => (
            <CommentThread comment={comment} level={0} />
          ))
        )
      </div>
    </section>
  </main>
</Layout>

<!-- Comment Thread Component -->
{comments.map((comment: any) => (
  <div slot={`comment-${comment.id}`} class="comment-thread" data-comment-id={comment.id}>
    <div class="p-6">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          {comment.author?.image ? (
            <img
              src={comment.author.image}
              alt={comment.author.name || 'User'}
              class="w-10 h-10 rounded-full"
            />
          ) : (
            <div class="w-10 h-10 rounded-full bg-gray-300 flex items-center justify-center text-gray-600 font-medium">
              {(comment.author?.name || 'A')[0].toUpperCase()}
            </div>
          )}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <span class="font-medium text-gray-900">
              {comment.author?.name || 'Anonymous'}
            </span>
            <span class="text-sm text-gray-500">
              {formatRelativeTime(comment.createdAt)}
            </span>
          </div>
          <p class="text-gray-700 mb-2">{comment.content}</p>
          <button
            class="text-sm text-blue-600 hover:text-blue-700 font-medium reply-btn"
            data-comment-id={comment.id}
          >
            Reply
          </button>
        </div>
      </div>

      <!-- Reply Form (hidden by default) -->
      <div id={`reply-form-${comment.id}`} class="hidden ml-14 mt-4">
        <form class="space-y-3 reply-form" data-parent-id={comment.id}>
          <textarea
            name="content"
            rows="2"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
            placeholder="Write a reply..."
            required
          ></textarea>
          <div class="flex gap-2">
            <button
              type="submit"
              class="px-4 py-1.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium"
            >
              Reply
            </button>
            <button
              type="button"
              class="px-4 py-1.5 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors text-sm font-medium cancel-reply-btn"
              data-comment-id={comment.id}
            >
              Cancel
            </button>
          </div>
        </form>
      </div>

      <!-- Nested Replies -->
      {comment.replies && comment.replies.length > 0 && (
        <div class="ml-14 mt-4 space-y-4 border-l-2 border-gray-200 pl-4">
          {comment.replies.map((reply: any) => (
            <div class="comment-reply" data-comment-id={reply.id}>
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                  {reply.author?.image ? (
                    <img
                      src={reply.author.image}
                      alt={reply.author.name || 'User'}
                      class="w-8 h-8 rounded-full"
                    />
                  ) : (
                    <div class="w-8 h-8 rounded-full bg-gray-300 flex items-center justify-center text-gray-600 font-medium text-sm">
                      {(reply.author?.name || 'A')[0].toUpperCase()}
                    </div>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="font-medium text-gray-900 text-sm">
                      {reply.author?.name || 'Anonymous'}
                    </span>
                    <span class="text-xs text-gray-500">
                      {formatRelativeTime(reply.createdAt)}
                    </span>
                  </div>
                  <p class="text-gray-700 text-sm">{reply.content}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
))}

<script define:vars={{ slug }}>
  // Comment section client-side functionality
  const articleSlug = slug;
  let currentUser = null;

  // Check authentication status
  async function checkAuth() {
    try {
      const response = await fetch('/api/auth/session');
      const data = await response.json();
      currentUser = data.user || null;
      updateAuthUI();
    } catch (error) {
      console.error('Error checking auth:', error);
      updateAuthUI();
    }
  }

  function updateAuthUI() {
    const authMessage = document.getElementById('auth-message');
    const submitBtn = document.querySelector('#comment-form button[type="submit"]');
    
    if (currentUser) {
      authMessage.innerHTML = `Posting as <strong>${currentUser.name || currentUser.email}</strong>`;
      submitBtn.disabled = false;
    } else {
      authMessage.innerHTML = '<a href="/login" class="text-blue-600 hover:text-blue-700">Sign in</a> to comment';
      submitBtn.disabled = true;
    }
  }

  // Handle main comment form submission
  document.getElementById('comment-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (!currentUser) {
      window.location.href = '/login';
      return;
    }

    const form = e.target;
    const content = form.content.value.trim();
    
    if (!content) return;

    try {
      const response = await fetch(`/api/v1/articles/${articleSlug}/comments`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content })
      });

      if (response.ok) {
        // Reload page to show new comment
        window.location.reload();
      } else {
        const error = await response.json();
        alert(error.error || 'Failed to post comment');
      }
    } catch (error) {
      console.error('Error posting comment:', error);
      alert('Failed to post comment');
    }
  });

  // Handle reply button clicks
  document.querySelectorAll('.reply-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const commentId = btn.dataset.commentId;
      const replyForm = document.getElementById(`reply-form-${commentId}`);
      replyForm?.classList.toggle('hidden');
    });
  });

  // Handle cancel reply buttons
  document.querySelectorAll('.cancel-reply-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const commentId = btn.dataset.commentId;
      const replyForm = document.getElementById(`reply-form-${commentId}`);
      replyForm?.classList.add('hidden');
    });
  });

  // Handle reply form submissions
  document.querySelectorAll('.reply-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (!currentUser) {
        window.location.href = '/login';
        return;
      }

      const parentId = form.dataset.parentId;
      const content = form.content.value.trim();
      
      if (!content) return;

      try {
        const response = await fetch(`/api/v1/articles/${articleSlug}/comments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ parentId, content })
        });

        if (response.ok) {
          // Reload page to show new reply
          window.location.reload();
        } else {
          const error = await response.json();
          alert(error.error || 'Failed to post reply');
        }
      } catch (error) {
        console.error('Error posting reply:', error);
        alert('Failed to post reply');
      }
    });
  });

  // Initialize
  checkAuth();

  // Handle bookmark toggle
  const bookmarkBtn = document.getElementById('bookmark-btn');
  bookmarkBtn?.addEventListener('click', async () => {
    if (!currentUser) {
      window.location.href = '/login';
      return;
    }

    const articleSlug = bookmarkBtn.dataset.articleSlug;
    const isBookmarked = bookmarkBtn.dataset.bookmarked === 'true';
    
    try {
      const response = await fetch(`/api/v1/articles/${articleSlug}/bookmark`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });

      if (response.ok) {
        const result = await response.json();
        const newBookmarked = result.data.bookmarked;
        
        // Update button state
        bookmarkBtn.dataset.bookmarked = newBookmarked.toString();
        document.getElementById('bookmark-icon').textContent = newBookmarked ? '🔖' : '📑';
        document.getElementById('bookmark-text').textContent = newBookmarked ? 'Bookmarked' : 'Save for later';
        
        // Update button style
        if (newBookmarked) {
          bookmarkBtn.className = 'flex items-center gap-2 mb-4 px-4 py-2 rounded-lg transition-colors font-medium bg-yellow-100 text-yellow-800';
        } else {
          bookmarkBtn.className = 'flex items-center gap-2 mb-4 px-4 py-2 rounded-lg transition-colors font-medium bg-gray-100 text-gray-700 hover:bg-gray-200';
        }
      } else {
        const error = await response.json();
        alert(error.error || 'Failed to update bookmark');
      }
    } catch (error) {
      console.error('Error toggling bookmark:', error);
      alert('Failed to update bookmark');
    }
  });

  // Suggest Edit Modal functionality
  const articleData = {
    title: article.title,
    excerpt: article.excerpt || '',
    content: article.content
  };

  const suggestEditBtn = document.getElementById('suggest-edit-btn');
  const suggestEditModal = document.getElementById('suggest-edit-modal');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelEditBtn = document.getElementById('cancel-edit-btn');
  const suggestEditForm = document.getElementById('suggest-edit-form');
  const fieldNameSelect = document.getElementById('field-name');
  const oldValueTextarea = document.getElementById('old-value');

  // Open modal
  suggestEditBtn?.addEventListener('click', () => {
    if (!currentUser) {
      window.location.href = '/login';
      return;
    }
    suggestEditModal?.classList.remove('hidden');
  });

  // Close modal
  closeModalBtn?.addEventListener('click', () => {
    suggestEditModal?.classList.add('hidden');
  });

  cancelEditBtn?.addEventListener('click', () => {
    suggestEditModal?.classList.add('hidden');
  });

  // Close modal on background click
  suggestEditModal?.addEventListener('click', (e) => {
    if (e.target === suggestEditModal) {
      suggestEditModal?.classList.add('hidden');
    }
  });

  // Update old value when field changes
  fieldNameSelect?.addEventListener('change', (e) => {
    const field = e.target.value;
    if (field && articleData[field] !== undefined) {
      oldValueTextarea.value = articleData[field];
    } else {
      oldValueTextarea.value = '';
    }
  });

  // Handle form submission
  suggestEditForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (!currentUser) {
      window.location.href = '/login';
      return;
    }

    const formData = new FormData(suggestEditForm);
    const fieldName = formData.get('fieldName');
    const oldValue = formData.get('oldValue');
    const newValue = formData.get('newValue');
    const reason = formData.get('reason');

    if (!fieldName || !newValue) {
      alert('Please fill in all required fields');
      return;
    }

    try {
      const response = await fetch('/api/v1/articles/' + articleSlug + '/suggestions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fieldName,
          oldValue,
          newValue,
          reason
        })
      });

      if (response.ok) {
        alert('Thank you! Your edit suggestion has been submitted for review.');
        suggestEditModal?.classList.add('hidden');
        suggestEditForm.reset();
        oldValueTextarea.value = '';
      } else {
        const error = await response.json();
        alert(error.error || 'Failed to submit suggestion');
      }
    } catch (error) {
      console.error('Error submitting edit suggestion:', error);
      alert('Failed to submit suggestion');
    }
  });

</script>
