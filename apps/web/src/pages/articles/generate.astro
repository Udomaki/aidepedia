---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/auth';

export const prerender = false;

// Check authentication
const session = await getSession(Astro.request);
if (!session?.user?.id) {
  return Astro.redirect('/login?redirect=' + encodeURIComponent(Astro.url.pathname));
}

const pageTitle = 'Generate Article from Outline - AIdepedia';
---

<Layout title={pageTitle}>
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6">
      <a href="/" class="text-blue-600 hover:text-blue-700">Home</a>
      <span class="mx-2 text-gray-400">/</span>
      <a href="/articles" class="text-blue-600 hover:text-blue-700">Articles</a>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-gray-600">Generate Article</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Generate Article from Outline</h1>
      <p class="text-gray-600">Enter a structured outline and our AI will generate a complete encyclopedia article.</p>
    </div>

    <!-- Generation Form -->
    <form id="generation-form" class="space-y-6">
      <!-- Title -->
      <div>
        <label for="title" class="block text-sm font-medium text-gray-700 mb-2">
          Article Title <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="title"
          name="title"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-lg"
          placeholder="e.g., History of Artificial Intelligence"
          required
        />
      </div>

      <!-- Outline -->
      <div>
        <label for="outline" class="block text-sm font-medium text-gray-700 mb-2">
          Outline <span class="text-red-500">*</span>
        </label>
        <textarea
          id="outline"
          name="outline"
          rows="15"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono text-sm"
          placeholder={`Enter your outline in this format:

## Introduction
- Brief overview of the topic
- Historical context
- Why this topic matters

## Main Section 1
- Point 1
- Point 2
- Point 3

### Subsection 1.1
- Detail about point 1
- Additional context

## Main Section 2
- Point 1
- Point 2

## Conclusion
- Summary of key points
- Future directions
- References`}
          required
        ></textarea>
        <p class="text-xs text-gray-500 mt-1">
          Use markdown headings (##, ###) for sections and bullet points (-) for content. Each section will be expanded by the AI.
        </p>
      </div>

      <!-- Options -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="provider" class="block text-sm font-medium text-gray-700 mb-2">
            AI Provider
          </label>
          <select
            id="provider"
            name="provider"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          >
            <option value="openai">OpenAI (GPT-4)</option>
            <option value="claude">Claude (Claude 3.5 Sonnet)</option>
          </select>
        </div>

        <div>
          <label for="citationFormat" class="block text-sm font-medium text-gray-700 mb-2">
            Citation Format
          </label>
          <select
            id="citationFormat"
            name="citationFormat"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          >
            <option value="apa">APA</option>
            <option value="mla">MLA</option>
          </select>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center justify-between pt-4 border-t border-gray-200">
        <a
          href="/articles"
          class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
        >
          Cancel
        </a>
        <button
          type="submit"
          id="generate-btn"
          class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium flex items-center gap-2"
        >
          <span>Generate Article</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </button>
      </div>
    </form>

    <!-- Loading State -->
    <div id="loading-state" class="hidden mt-8">
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
        <div class="flex items-center gap-4">
          <svg class="animate-spin h-8 w-8 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <div>
            <h3 class="text-lg font-semibold text-blue-900">Generating Article...</h3>
            <p class="text-sm text-blue-700">This may take 30-60 seconds. Please don't close this page.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Error State -->
    <div id="error-state" class="hidden mt-8">
      <div class="bg-red-50 border border-red-200 rounded-lg p-6">
        <div class="flex items-start gap-3">
          <span class="text-2xl">⚠️</span>
          <div>
            <h3 class="text-lg font-semibold text-red-900">Generation Failed</h3>
            <p id="error-message" class="text-sm text-red-700 mt-1"></p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('generation-form');
  const loadingState = document.getElementById('loading-state');
  const errorState = document.getElementById('error-state');
  const errorMessage = document.getElementById('error-message');
  const generateBtn = document.getElementById('generate-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Hide previous states
    errorState?.classList.add('hidden');
    loadingState?.classList.remove('hidden');
    generateBtn?.setAttribute('disabled', 'true');

    // Parse outline
    const title = (document.getElementById('title') as HTMLInputElement).value;
    const outlineText = (document.getElementById('outline') as HTMLTextAreaElement).value;
    const provider = (document.getElementById('provider') as HTMLSelectElement).value;
    const citationFormat = (document.getElementById('citationFormat') as HTMLSelectElement).value;

    const outline = parseOutline(outlineText);
    outline.title = title;

    try {
      const response = await fetch('/api/v1/articles/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          outline,
          options: {
            provider,
            citationFormat
          }
        })
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || result.message || 'Failed to generate article');
      }

      // Redirect to the generated article
      const articleSlug = result.data?.article?.slug;
      if (articleSlug) {
        window.location.href = `/articles/${articleSlug}`;
      } else {
        throw new Error('Article created but slug not returned');
      }

    } catch (error) {
      console.error('Generation error:', error);
      loadingState?.classList.add('hidden');
      errorState?.classList.remove('hidden');
      if (errorMessage) {
        errorMessage.textContent = error instanceof Error ? error.message : 'Unknown error occurred';
      }
      generateBtn?.removeAttribute('disabled');
    }
  });

  function parseOutline(text: string): any {
    const lines = text.split('\n');
    const sections: any[] = [];
    let currentSection: any = null;
    let currentSubsection: any = null;

    lines.forEach((line: string) => {
      line = line.trim();
      if (!line) return;

      if (line.startsWith('## ')) {
        // Main section
        if (currentSection) {
          sections.push(currentSection);
        }
        currentSection = {
          heading: line.substring(3).trim(),
          points: [],
          subsections: []
        };
        currentSubsection = null;
      } else if (line.startsWith('### ')) {
        // Subsection
        if (currentSection) {
          currentSubsection = {
            heading: line.substring(4).trim(),
            points: []
          };
          currentSection.subsections?.push(currentSubsection);
        }
      } else if (line.startsWith('- ')) {
        // Bullet point
        const point = line.substring(2).trim();
        if (currentSubsection) {
          currentSubsection.points.push(point);
        } else if (currentSection) {
          currentSection.points.push(point);
        }
      }
    });

    if (currentSection) {
      sections.push(currentSection);
    }

    return { title: '', sections };
  }
</script>
