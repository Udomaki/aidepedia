---
import Layout from '../../../../layouts/Layout.astro';
import { getArticleBySlug, getRevisionById } from '@aidepedia/db';
import * as Diff from 'diff';

export async function getStaticPaths() {
  // For static generation, we'd need to fetch all articles
  // For now, we'll rely on SSR
  return [];
}

const { slug, revs } = Astro.params;

let article = null;
let revision1 = null;
let revision2 = null;
let error = null;

// Parse revision IDs from the path
const [rev1Id, rev2Id] = revs ? revs.split('...') : [null, null];

if (slug && rev1Id && rev2Id) {
  try {
    article = await getArticleBySlug(slug);
    revision1 = await getRevisionById(parseInt(rev1Id, 10));
    revision2 = await getRevisionById(parseInt(rev2Id, 10));
    
    // Verify these revisions belong to this article
    if (revision1.articleId !== article.id || revision2.articleId !== article.id) {
      error = 'Revisions do not belong to this article';
      article = null;
      revision1 = null;
      revision2 = null;
    }
  } catch (e) {
    error = 'Article or revisions not found';
  }
} else {
  error = 'Invalid comparison parameters';
}

if (!article || !revision1 || !revision2) {
  return Astro.redirect(`/articles/${slug}/revisions`);
}

const pageTitle = `Compare Revisions: ${article.title} - AIdepedia`;

// Calculate diffs
const titleDiff = Diff.diffWords(revision1.title, revision2.title);
const contentDiff = Diff.diffLines(revision1.content, revision2.content);
const excerptDiff = revision1.excerpt && revision2.excerpt 
  ? Diff.diffWords(revision1.excerpt, revision2.excerpt)
  : null;

// Calculate stats
const additions = contentDiff.filter(d => d.added).reduce((acc, d) => acc + d.count, 0);
const deletions = contentDiff.filter(d => d.removed).reduce((acc, d) => acc + d.count, 0);

function formatDate(date: Date | null): string {
  if (!date) return 'Unknown date';
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  }).format(new Date(date));
}
---

<Layout title={pageTitle}>
  <main class="container mx-auto px-4 py-8 max-w-6xl">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6">
      <a href="/" class="text-blue-600 hover:text-blue-700">Home</a>
      <span class="mx-2 text-gray-400">/</span>
      <a href="/articles" class="text-blue-600 hover:text-blue-700">Articles</a>
      <span class="mx-2 text-gray-400">/</span>
      <a href={`/articles/${article.slug}`} class="text-blue-600 hover:text-blue-700">{article.title}</a>
      <span class="mx-2 text-gray-400">/</span>
      <a href={`/articles/${article.slug}/revisions`} class="text-blue-600 hover:text-blue-700">Revisions</a>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-gray-600">Compare</span>
    </nav>

    <!-- Header -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden mb-6">
      <header class="p-6 border-b border-gray-200">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-gray-900 mb-2">Compare Revisions</h1>
            <p class="text-gray-600">{article.title}</p>
          </div>
          <a
            href={`/articles/${article.slug}/revisions`}
            class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
          >
            ← All Revisions
          </a>
        </div>
      </header>

      <!-- Stats -->
      <div class="p-6 bg-gray-50 flex items-center gap-6">
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium text-gray-600">Changes:</span>
          <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium">
            +{additions} additions
          </span>
          <span class="px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm font-medium">
            -{deletions} deletions
          </span>
        </div>
      </div>
    </div>

    <!-- Revision Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
      <!-- Revision 1 -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-gray-900">Revision #{revision1.id}</h2>
          <a
            href={`/articles/${article.slug}/revisions/${revision1.id}`}
            class="text-blue-600 hover:text-blue-700 text-sm font-medium"
          >
            View →
          </a>
        </div>
        <div class="space-y-2 text-sm text-gray-600">
          <div>📅 {formatDate(revision1.createdAt)}</div>
          <div>👤 Editor ID: {revision1.editorId}</div>
          <div class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full inline-block text-xs font-medium">
            {revision1.changeType}
          </div>
        </div>
      </div>

      <!-- Revision 2 -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-gray-900">Revision #{revision2.id}</h2>
          <a
            href={`/articles/${article.slug}/revisions/${revision2.id}`}
            class="text-blue-600 hover:text-blue-700 text-sm font-medium"
          >
            View →
          </a>
        </div>
        <div class="space-y-2 text-sm text-gray-600">
          <div>📅 {formatDate(revision2.createdAt)}</div>
          <div>👤 Editor ID: {revision2.editorId}</div>
          <div class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full inline-block text-xs font-medium">
            {revision2.changeType}
          </div>
        </div>
      </div>
    </div>

    <!-- Diff View -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <!-- Tabs -->
      <div class="border-b border-gray-200">
        <nav class="flex -mb-px">
          <button
            id="unified-tab"
            class="px-6 py-4 text-blue-600 border-b-2 border-blue-600 font-medium"
            onclick="showUnified()"
          >
            Unified Diff
          </button>
          <button
            id="split-tab"
            class="px-6 py-4 text-gray-600 hover:text-gray-900 font-medium"
            onclick="showSplit()"
          >
            Side-by-Side
          </button>
        </nav>
      </div>

      <!-- Title Diff -->
      <div class="border-b border-gray-200 p-6">
        <h3 class="text-lg font-bold text-gray-900 mb-3">Title</h3>
        <div class="p-4 bg-gray-50 rounded-lg">
          {titleDiff.map((part: any) => (
            <span 
              class:list={[
                part.added && 'bg-green-200 text-green-900',
                part.removed && 'bg-red-200 text-red-900 line-through',
                !part.added && !part.removed && 'text-gray-700'
              ]}
            >
              {part.value}
            </span>
          ))}
        </div>
      </div>

      <!-- Content Diff - Unified View -->
      <div id="unified-view" class="p-6">
        <h3 class="text-lg font-bold text-gray-900 mb-3">Content</h3>
        <div class="font-mono text-sm bg-gray-900 text-gray-100 rounded-lg overflow-hidden">
          <div class="p-4">
            {contentDiff.map((part: any) => (
              <div 
                class:list={[
                  'whitespace-pre-wrap',
                  part.added && 'bg-green-900/30 text-green-300',
                  part.removed && 'bg-red-900/30 text-red-300'
                ]}
              >
                {part.added && part.value.split('\n').map((line: string, i: number, arr: string[]) => (
                  <div>+ {line}{i < arr.length - 1 ? '' : ''}</div>
                ))}
                {part.removed && part.value.split('\n').map((line: string, i: number, arr: string[]) => (
                  <div>- {line}{i < arr.length - 1 ? '' : ''}</div>
                ))}
                {!part.added && !part.removed && part.value.split('\n').map((line: string, i: number, arr: string[]) => (
                  <div class="text-gray-400">  {line}{i < arr.length - 1 ? '' : ''}</div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Content Diff - Split View -->
      <div id="split-view" class="hidden">
        <div class="grid grid-cols-2 divide-x divide-gray-200">
          <!-- Left side - Old -->
          <div>
            <div class="p-4 bg-red-50 border-b border-gray-200">
              <h4 class="font-bold text-gray-900">Revision #{revision1.id}</h4>
            </div>
            <div class="p-6 bg-red-50/30 max-h-96 overflow-y-auto">
              <div class="font-mono text-sm whitespace-pre-wrap">
                {contentDiff.map((part: any) => (
                  <div 
                    class:list={[
                      part.removed && 'bg-red-200 text-red-900',
                      !part.removed && !part.added && 'text-gray-700'
                    ]}
                  >
                    {part.removed ? part.value : (part.added ? '' : part.value)}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Right side - New -->
          <div>
            <div class="p-4 bg-green-50 border-b border-gray-200">
              <h4 class="font-bold text-gray-900">Revision #{revision2.id}</h4>
            </div>
            <div class="p-6 bg-green-50/30 max-h-96 overflow-y-auto">
              <div class="font-mono text-sm whitespace-pre-wrap">
                {contentDiff.map((part: any) => (
                  <div 
                    class:list={[
                      part.added && 'bg-green-200 text-green-900',
                      !part.added && !part.removed && 'text-gray-700'
                    ]}
                  >
                    {part.added ? part.value : (part.removed ? '' : part.value)}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Excerpt Diff -->
      {excerptDiff && (
        <div class="border-t border-gray-200 p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-3">Excerpt</h3>
          <div class="p-4 bg-gray-50 rounded-lg">
            {excerptDiff.map((part: any) => (
              <span 
                class:list={[
                  part.added && 'bg-green-200 text-green-900',
                  part.removed && 'bg-red-200 text-red-900 line-through',
                  !part.added && !part.removed && 'text-gray-700'
                ]}
              >
                {part.value}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>
</Layout>

<script>
  function showUnified() {
    document.getElementById('unified-view')?.classList.remove('hidden');
    document.getElementById('split-view')?.classList.add('hidden');
    document.getElementById('unified-tab')?.classList.add('text-blue-600', 'border-b-2', 'border-blue-600');
    document.getElementById('unified-tab')?.classList.remove('text-gray-600');
    document.getElementById('split-tab')?.classList.remove('text-blue-600', 'border-b-2', 'border-blue-600');
    document.getElementById('split-tab')?.classList.add('text-gray-600');
  }

  function showSplit() {
    document.getElementById('split-view')?.classList.remove('hidden');
    document.getElementById('unified-view')?.classList.add('hidden');
    document.getElementById('split-tab')?.classList.add('text-blue-600', 'border-b-2', 'border-blue-600');
    document.getElementById('split-tab')?.classList.remove('text-gray-600');
    document.getElementById('unified-tab')?.classList.remove('text-blue-600', 'border-b-2', 'border-blue-600');
    document.getElementById('unified-tab')?.classList.add('text-gray-600');
  }

  // Expose to global scope
  (window as any).showUnified = showUnified;
  (window as any).showSplit = showSplit;
</script>
