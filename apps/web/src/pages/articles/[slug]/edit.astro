---
import Layout from '../../../layouts/Layout.astro';
import AISuggestions from '../../../components/AISuggestions.astro';
import { getArticleBySlug, getCategories, getArticleDraft, getArticleTags } from '@aidepedia/db';
import { getSession } from '../../../lib/auth';

export const prerender = false;

const { slug } = Astro.params;

// Check authentication
const session = await getSession(Astro.request);
if (!session?.user?.id) {
  return Astro.redirect('/login?redirect=' + encodeURIComponent(Astro.url.pathname));
}

const userId = parseInt(session.user.id as string, 10);

// Check if this is a new article
const isNewArticle = slug === 'new';

// Fetch article data (for editing existing articles)
let article = null;
let existingTags: string[] = [];
if (!isNewArticle && slug) {
  try {
    article = await getArticleBySlug(slug);
    existingTags = await getArticleTags(article.id);
  } catch (e) {
    return Astro.redirect('/articles');
  }
}

// Fetch categories
const categories = await getCategories();

// Check for existing draft
let draft = null;
try {
  draft = await getArticleDraft(article?.id ?? null, userId);
} catch (e) {
  console.error('Error fetching draft:', e);
}

const pageTitle = isNewArticle ? 'Create Article - AIdepedia' : `Edit: ${article?.title} - AIdepedia`;
---

<Layout title={pageTitle}>
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6">
      <a href="/" class="text-blue-600 hover:text-blue-700">Home</a>
      <span class="mx-2 text-gray-400">/</span>
      <a href="/articles" class="text-blue-600 hover:text-blue-700">Articles</a>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-gray-600">{isNewArticle ? 'New Article' : 'Edit'}</span>
    </nav>

    <!-- Draft Recovery Banner -->
    <div id="draft-banner" class="hidden mb-6 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-2xl">📝</span>
          <div>
            <p class="font-medium text-yellow-800">You have an unsaved draft</p>
            <p class="text-sm text-yellow-600">
              Last saved: <span id="draft-last-saved"></span>
            </p>
          </div>
        </div>
        <div class="flex gap-3">
          <button
            id="restore-draft-btn"
            class="px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors font-medium"
          >
            Restore Draft
          </button>
          <button
            id="discard-draft-btn"
            class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
          >
            Discard Draft
          </button>
        </div>
      </div>
    </div>

    <!-- Editor Form -->
    <form id="article-form" class="space-y-6">
      <input type="hidden" name="slug" value={slug || 'new'} />
      
      <!-- Auto-save Status -->
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-bold text-gray-900">
          {isNewArticle ? 'Create New Article' : 'Edit Article'}
        </h1>
        <div id="auto-save-status" class="flex items-center gap-2 text-sm text-gray-500">
          <span id="save-indicator" class="hidden">
            <svg class="animate-spin h-4 w-4 inline mr-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Saving...
          </span>
          <span id="last-saved-text" class="hidden">
            <span class="text-green-600">✓</span>
            Last saved: <span id="last-saved-time"></span>
          </span>
          <span id="unsaved-changes" class="hidden text-yellow-600">
            ● Unsaved changes
          </span>
        </div>
      </div>

      <!-- Title -->
      <div>
        <label for="title" class="block text-sm font-medium text-gray-700 mb-2">
          Title <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="title"
          name="title"
          value={draft?.title || article?.title || ''}
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-lg"
          placeholder="Enter article title..."
          required
        />
      </div>

      <!-- Slug -->
      <div>
        <label for="article-slug" class="block text-sm font-medium text-gray-700 mb-2">
          Slug (URL path)
        </label>
        <div class="flex items-center gap-2">
          <span class="text-gray-500">/articles/</span>
          <input
            type="text"
            id="article-slug"
            name="article-slug"
            value={article?.slug || ''}
            class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            placeholder="article-slug"
            pattern="[a-z0-9-]+"
          />
        </div>
        <p class="text-xs text-gray-500 mt-1">
          Only lowercase letters, numbers, and hyphens. Leave empty to auto-generate from title.
        </p>
      </div>

      <!-- Excerpt -->
      <div>
        <label for="excerpt" class="block text-sm font-medium text-gray-700 mb-2">
          Excerpt / Summary
        </label>
        <textarea
          id="excerpt"
          name="excerpt"
          rows="2"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="Brief summary of the article..."
        >{draft?.excerpt || article?.excerpt || ''}</textarea>
      </div>

      <!-- Category -->
      <div>
        <label for="category" class="block text-sm font-medium text-gray-700 mb-2">
          Category
        </label>
        <select
          id="category"
          name="category"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">Select a category...</option>
          {categories.map((cat) => (
            <option value={cat.id} selected={article?.categoryId === cat.id}>
              {cat.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Tags -->
      <div>
        <label for="tags" class="block text-sm font-medium text-gray-700 mb-2">
          Tags
        </label>
        <input
          type="text"
          id="tags"
          name="tags"
          value={(draft?.tags || existingTags.map(t => t.name))?.join(', ') || ''}
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="Enter tags separated by commas..."
        />
        <p class="text-xs text-gray-500 mt-1">
          Separate tags with commas, e.g., "AI, machine learning, neural networks"
        </p>
      </div>

      <!-- Content -->
      <div>
        <label for="content" class="block text-sm font-medium text-gray-700 mb-2">
          Content <span class="text-red-500">*</span>
        </label>
        <textarea
          id="content"
          name="content"
          rows="20"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono text-sm"
          placeholder="Write your article content here..."
          required
        >{draft?.content || article?.content || ''}</textarea>
      </div>

      <!-- Status -->
      <div>
        <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
          Status
        </label>
        <select
          id="status"
          name="status"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="draft" selected={article?.status === 'draft' || isNewArticle}>Draft</option>
          <option value="pending_review" selected={article?.status === 'pending_review'}>Submit for Review</option>
          <option value="published" selected={article?.status === 'published'}>Published</option>
        </select>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center justify-between pt-4 border-t border-gray-200">
        <a
          href={isNewArticle ? '/articles' : `/articles/${article?.slug}`}
          class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
        >
          Cancel
        </a>
        <div class="flex gap-3">
          <button
            type="button"
            id="save-draft-btn"
            class="px-6 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors font-medium"
          >
            Save Draft
          </button>
          <button
            type="submit"
            id="publish-btn"
            class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
          >
            {isNewArticle ? 'Create Article' : 'Save Changes'}
          </button>
        </div>
      </div>
    </form>

    <!-- AI Suggestions (only for existing articles) -->
    {!isNewArticle && article && (
      <AISuggestions articleId={article.id} articleContent={article.content} />
    )}
  </main>
</Layout>

<script define:vars={{ slug, isNewArticle, article, draft }}>
  // Auto-save configuration
  const AUTO_SAVE_INTERVAL = 30000; // 30 seconds
  const DEBOUNCE_DELAY = 2000; // 2 seconds
  
  let autoSaveTimer = null;
  let debounceTimer = null;
  let hasUnsavedChanges = false;
  let lastSavedData = null;
  let currentDraft = draft;

  // DOM Elements
  const form = document.getElementById('article-form');
  const titleInput = document.getElementById('title');
  const contentInput = document.getElementById('content');
  const excerptInput = document.getElementById('excerpt');
  const tagsInput = document.getElementById('tags');
  const slugInput = document.getElementById('article-slug');
  const categorySelect = document.getElementById('category');
  const statusSelect = document.getElementById('status');
  
  const saveIndicator = document.getElementById('save-indicator');
  const lastSavedText = document.getElementById('last-saved-text');
  const lastSavedTime = document.getElementById('last-saved-time');
  const unsavedChanges = document.getElementById('unsaved-changes');
  
  const draftBanner = document.getElementById('draft-banner');
  const draftLastSaved = document.getElementById('draft-last-saved');
  const restoreDraftBtn = document.getElementById('restore-draft-btn');
  const discardDraftBtn = document.getElementById('discard-draft-btn');
  const saveDraftBtn = document.getElementById('save-draft-btn');

  // Format relative time
  function formatRelativeTime(date) {
    const now = new Date();
    const then = new Date(date);
    const diff = now.getTime() - then.getTime();
    
    const minutes = Math.floor(diff / 60000);
    const hours = Math.floor(diff / 3600000);
    
    if (minutes < 1) return 'just now';
    if (minutes < 60) return `${minutes}m ago`;
    if (hours < 24) return `${hours}h ago`;
    return then.toLocaleDateString();
  }

  // Format time for display
  function formatTime(date) {
    return new Date(date).toLocaleTimeString(undefined, {
      hour: '2-digit',
      minute: '2-digit'
    });
  }

  // Show draft recovery banner if there's a draft
  function checkForDraft() {
    if (currentDraft && currentDraft.lastSaved) {
      // Check if draft is different from current article
      const hasChanges = isNewArticle 
        ? (currentDraft.title || currentDraft.content)
        : (
            currentDraft.title !== article?.title ||
            currentDraft.content !== article?.content ||
            currentDraft.excerpt !== article?.excerpt
          );
      
      if (hasChanges) {
        draftBanner.classList.remove('hidden');
        draftLastSaved.textContent = formatRelativeTime(currentDraft.lastSaved);
      }
    }
  }

  // Restore draft
  restoreDraftBtn?.addEventListener('click', () => {
    if (currentDraft) {
      if (currentDraft.title) titleInput.value = currentDraft.title;
      if (currentDraft.content) contentInput.value = currentDraft.content;
      if (currentDraft.excerpt) excerptInput.value = currentDraft.excerpt;
      if (currentDraft.tags) tagsInput.value = currentDraft.tags.join(', ');
      draftBanner.classList.add('hidden');
      markAsChanged();
    }
  });

  // Discard draft
  discardDraftBtn?.addEventListener('click', async () => {
    if (confirm('Are you sure you want to discard this draft?')) {
      try {
        const response = await fetch(`/api/v1/articles/${slug}/draft`, {
          method: 'DELETE',
        });
        
        if (response.ok) {
          draftBanner.classList.add('hidden');
          currentDraft = null;
        }
      } catch (error) {
        console.error('Error discarding draft:', error);
      }
    }
  });

  // Get current form data
  function getFormData() {
    const tags = tagsInput.value
      .split(',')
      .map(t => t.trim())
      .filter(t => t.length > 0);
    
    return {
      title: titleInput.value,
      content: contentInput.value,
      excerpt: excerptInput.value,
      tags: tags,
      slug: slugInput.value,
      categoryId: categorySelect.value ? parseInt(categorySelect.value) : null,
      status: statusSelect.value,
    };
  }

  // Check if data has changed
  function hasDataChanged() {
    const currentData = JSON.stringify(getFormData());
    return currentData !== lastSavedData;
  }

  // Mark as changed
  function markAsChanged() {
    hasUnsavedChanges = true;
    unsavedChanges.classList.remove('hidden');
    lastSavedText.classList.add('hidden');
    
    // Start debounce timer
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      if (hasDataChanged()) {
        saveDraft();
      }
    }, DEBOUNCE_DELAY);
  }

  // Save draft
  async function saveDraft() {
    const data = getFormData();
    
    // Don't save if nothing to save
    if (!data.title && !data.content) {
      return;
    }

    saveIndicator.classList.remove('hidden');
    unsavedChanges.classList.add('hidden');
    
    try {
      const response = await fetch(`/api/v1/articles/${slug}/draft`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      
      if (response.ok) {
        const result = await response.json();
        lastSavedData = JSON.stringify(data);
        hasUnsavedChanges = false;
        
        // Update UI
        saveIndicator.classList.add('hidden');
        lastSavedText.classList.remove('hidden');
        lastSavedTime.textContent = formatTime(new Date());
        
        // Hide draft banner if shown
        draftBanner.classList.add('hidden');
      } else {
        console.error('Failed to save draft');
        saveIndicator.classList.add('hidden');
        unsavedChanges.classList.remove('hidden');
      }
    } catch (error) {
      console.error('Error saving draft:', error);
      saveIndicator.classList.add('hidden');
      unsavedChanges.classList.remove('hidden');
    }
  }

  // Manual save draft button
  saveDraftBtn?.addEventListener('click', () => {
    saveDraft();
  });

  // Auto-save on input changes
  [titleInput, contentInput, excerptInput, tagsInput].forEach(input => {
    input?.addEventListener('input', markAsChanged);
  });

  // Auto-save on select changes
  [categorySelect, statusSelect].forEach(select => {
    select?.addEventListener('change', markAsChanged);
  });

  // Auto-save interval
  autoSaveTimer = setInterval(() => {
    if (hasUnsavedChanges && hasDataChanged()) {
      saveDraft();
    }
  }, AUTO_SAVE_INTERVAL);

  // Save before leaving page
  window.addEventListener('beforeunload', (e) => {
    if (hasUnsavedChanges && hasDataChanged()) {
      // Save draft synchronously (fire and forget)
      navigator.sendBeacon(
        `/api/v1/articles/${slug}/draft`,
        JSON.stringify(getFormData())
      );
      
      // Show warning
      e.preventDefault();
      e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
      return e.returnValue;
    }
  });

  // Form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const data = getFormData();
    
    // Generate slug from title if not provided
    if (!data.slug && data.title) {
      data.slug = data.title
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
    }
    
    try {
      let response;
      
      if (isNewArticle) {
        // Create new article
        response = await fetch('/api/v1/articles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
      } else {
        // Update existing article
        response = await fetch(`/api/v1/articles/${slug}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
      }
      
      if (response.ok) {
        const result = await response.json();
        
        // Delete draft after successful save
        await fetch(`/api/v1/articles/${slug}/draft`, {
          method: 'DELETE',
        });
        
        // Redirect to article page
        const articleSlug = result.data?.slug || data.slug;
        window.location.href = `/articles/${articleSlug}`;
      } else {
        const error = await response.json();
        alert(error.error || 'Failed to save article');
      }
    } catch (error) {
      console.error('Error saving article:', error);
      alert('Failed to save article');
    }
  });

  // Initialize
  checkForDraft();
  lastSavedData = JSON.stringify(getFormData());

  // Warn about unsaved changes when navigating away
  window.addEventListener('popstate', () => {
    if (hasUnsavedChanges && hasDataChanged()) {
      if (!confirm('You have unsaved changes. Are you sure you want to leave?')) {
        history.pushState(null, '', window.location.href);
      }
    }
  });
</script>
