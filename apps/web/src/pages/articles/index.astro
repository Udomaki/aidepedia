---
import { listArticles, getCategories } from '@aidepedia/db';
import type { Article, Category } from '@aidepedia/db';
import Layout from '../../layouts/Layout.astro';
import VotingButtons from '../../components/VotingButtons.astro';

export const prerender = false;

// Fetch published articles and categories
const [result, categories] = await Promise.all([
  listArticles({ status: 'published', limit: 20 }),
  getCategories()
]);
const articles: Article[] = result.data;
const categoryMap = new Map<number, Category>(categories.map(c => [c.id, c]));
---

<Layout title="Articles - AIdepedia">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">Articles</h1>
      <p class="text-gray-600 dark:text-gray-400">
        Browse high-quality, AI-curated articles. Vote to help improve content quality.
      </p>
    </div>

    <div class="space-y-6">
      {articles.map(article => (
        <article class="bg-white dark:bg-slate-800 rounded-xl shadow-md border border-gray-200 dark:border-slate-700 p-6 hover:shadow-lg transition-shadow">
          <div class="flex items-start justify-between gap-6">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                {article.categoryId && (
                  <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 text-xs font-medium rounded-full">
                    {categoryMap.get(article.categoryId)?.name || 'Uncategorized'}
                  </span>
                )}
                {article.tags && article.tags.length > 0 && (
                  <div class="flex gap-1">
                    {article.tags.slice(0, 3).map(tag => (
                      <span class="px-2 py-1 bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-gray-400 text-xs rounded-full">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <a href={`/articles/${article.slug}`} class="group">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2">
                  {article.title}
                </h2>
              </a>

              {article.excerpt && (
                <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-2">
                  {article.excerpt}
                </p>
              )}

              <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
                <span>
                  Quality Score: <strong class="text-gray-700 dark:text-gray-300">{article.qualityScore || 0}</strong>
                </span>
                <span>•</span>
                <span>
                  {article.viewCount || 0} views
                </span>
                <span>•</span>
                <span>
                  {article.readingTime || 1} min read
                </span>
                <span>•</span>
                <time datetime={article.createdAt?.toISOString()}>
                  {new Date(article.createdAt || '').toLocaleDateString()}
                </time>
              </div>
            </div>

            <VotingButtons
              articleId={article.id}
              upvotes={article.upvotes || 0}
              downvotes={article.downvotes || 0}
              userVote={null}
            />
          </div>
        </article>
      ))}
    </div>

    {result.meta.totalPages > 1 && (
      <div class="mt-8 flex justify-center gap-2">
        {Array.from({ length: result.meta.totalPages }, (_, i) => i + 1).map(page => (
          <a
            href={`/articles?page=${page}`}
            class={`px-4 py-2 rounded-lg ${
              page === result.meta.page
                ? 'bg-blue-600 dark:bg-blue-500 text-white'
                : 'bg-white dark:bg-slate-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-600'
            }`}
          >
            {page}
          </a>
        ))}
      </div>
    )}

    {articles.length === 0 && (
      <div class="text-center py-16">
        <p class="text-gray-500 dark:text-gray-400 text-lg">No articles found. Check back soon!</p>
      </div>
    )}
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
