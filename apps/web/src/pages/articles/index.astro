---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { listArticles, type ArticleStatus } from '@aidepedia/db';

// Get query parameters
const url = Astro.url;
const page = parseInt(url.searchParams.get('page') || '1');
const sortBy = url.searchParams.get('sortBy') || 'date';
const sortOrder = url.searchParams.get('sortOrder') || 'desc';
const search = url.searchParams.get('search') || '';
const category = url.searchParams.get('category') || '';

// Build query parameters
const queryParams = {
  status: 'published' as ArticleStatus,
  page,
  limit: 12,
  category: category || undefined,
  search: search || undefined,
};

// Fetch articles directly from database
let articlesData = { data: [], meta: { total: 0, page: 1, limit: 12, totalPages: 0 } };
try {
  articlesData = await listArticles(queryParams);
} catch (error) {
  console.error('Failed to fetch articles:', error);
}

const { data: articles, meta } = articlesData;

// Build pagination URL helper
function buildPageUrl(newPage: number): string {
  const params = new URLSearchParams();
  if (sortBy !== 'date') params.set('sortBy', sortBy);
  if (sortOrder !== 'desc') params.set('sortOrder', sortOrder);
  if (search) params.set('search', search);
  if (category) params.set('category', category);
  params.set('page', newPage.toString());
  const queryString = params.toString();
  return queryString ? `/articles?${queryString}` : '/articles';
}

// Get page numbers to display
function getPageNumbers(currentPage: number, totalPages: number): number[] {
  const pages: number[] = [];
  
  if (totalPages <= 5) {
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else if (currentPage <= 3) {
    for (let i = 1; i <= 5; i++) {
      pages.push(i);
    }
  } else if (currentPage >= totalPages - 2) {
    for (let i = totalPages - 4; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    for (let i = currentPage - 2; i <= currentPage + 2; i++) {
      pages.push(i);
    }
  }
  
  return pages;
}

const pageNumbers = getPageNumbers(meta.page, meta.totalPages);
---

<Layout 
  title="Articles" 
  description="Browse our comprehensive encyclopedia of AI-curated articles"
>
  <main class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
      <nav class="text-sm mb-4">
        <a href="/" class="text-blue-600 hover:text-blue-700">Home</a>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-gray-600">Articles</span>
      </nav>
      <h1 class="text-4xl font-bold text-gray-900">Articles</h1>
      <p class="text-gray-600 mt-2">
        {meta.total} article{meta.total !== 1 ? 's' : ''} in our encyclopedia
      </p>
    </div>

    <!-- Search and Filters -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <form method="GET" class="space-y-4">
        <div class="flex flex-col md:flex-row gap-4">
          <!-- Search -->
          <div class="flex-1">
            <label for="search" class="block text-sm font-medium text-gray-700 mb-1">
              Search
            </label>
            <input
              type="text"
              id="search"
              name="search"
              value={search}
              placeholder="Search articles..."
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          <!-- Category Filter -->
          <div class="md:w-48">
            <label for="category" class="block text-sm font-medium text-gray-700 mb-1">
              Category
            </label>
            <input
              type="text"
              id="category"
              name="category"
              value={category}
              placeholder="All categories"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          <!-- Sort By -->
          <div class="md:w-48">
            <label for="sortBy" class="block text-sm font-medium text-gray-700 mb-1">
              Sort By
            </label>
            <select
              id="sortBy"
              name="sortBy"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >
              <option value="date" selected={sortBy === 'date'}>Date</option>
              <option value="title" selected={sortBy === 'title'}>Title</option>
              <option value="views" selected={sortBy === 'views'}>Views</option>
            </select>
          </div>

          <!-- Sort Order -->
          <div class="md:w-40">
            <label for="sortOrder" class="block text-sm font-medium text-gray-700 mb-1">
              Order
            </label>
            <select
              id="sortOrder"
              name="sortOrder"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >
              <option value="desc" selected={sortOrder === 'desc'}>Descending</option>
              <option value="asc" selected={sortOrder === 'asc'}>Ascending</option>
            </select>
          </div>
        </div>

        <!-- Buttons -->
        <div class="flex gap-2">
          <button
            type="submit"
            class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
          >
            Apply Filters
          </button>
          {(search || category || sortBy !== 'date' || sortOrder !== 'desc') && (
            <a
              href="/articles"
              class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium inline-flex items-center"
            >
              Clear Filters
            </a>
          )}
        </div>
      </form>
    </div>

    <!-- Articles Grid -->
    {articles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        {articles.map((article: any) => (
          <ArticleCard article={article} />
        ))}
      </div>
    ) : (
      <div class="text-center py-12 bg-white rounded-lg border border-gray-200">
        <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h3 class="text-lg font-medium text-gray-900 mb-1">No articles found</h3>
        <p class="text-gray-600">Try adjusting your search or filter criteria</p>
      </div>
    )}

    <!-- Pagination -->
    {meta.totalPages > 1 && (
      <div class="flex items-center justify-center gap-2">
        {/* Previous Page */}
        {meta.page > 1 ? (
          <a
            href={buildPageUrl(meta.page - 1)}
            class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors text-gray-700 font-medium"
          >
            ← Previous
          </a>
        ) : (
          <span class="px-4 py-2 bg-gray-100 border border-gray-200 rounded-lg text-gray-400 font-medium cursor-not-allowed">
            ← Previous
          </span>
        )}

        {/* Page Numbers */}
        <div class="flex gap-1">
          {pageNumbers.map((pageNum) => (
            pageNum === meta.page ? (
              <span class="px-4 py-2 bg-blue-600 text-white rounded-lg font-medium">
                {pageNum}
              </span>
            ) : (
              <a
                href={buildPageUrl(pageNum)}
                class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors text-gray-700 font-medium"
              >
                {pageNum}
              </a>
            )
          ))}
        </div>

        {/* Next Page */}
        {meta.page < meta.totalPages ? (
          <a
            href={buildPageUrl(meta.page + 1)}
            class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors text-gray-700 font-medium"
          >
            Next →
          </a>
        ) : (
          <span class="px-4 py-2 bg-gray-100 border border-gray-200 rounded-lg text-gray-400 font-medium cursor-not-allowed">
            Next →
          </span>
        )}
      </div>
    )}

    {/* Page Info */}
    {meta.totalPages > 1 && (
      <p class="text-center text-gray-600 text-sm mt-4">
        Page {meta.page} of {meta.totalPages}
      </p>
    )}
  </main>
</Layout>
