---
import Layout from '../layouts/Layout.astro';
import { getCategories } from '@aidepedia/db';

export const prerender = false;

// Get categories for filter dropdown
const categories = await getCategories();
---

<Layout title="Search">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Search Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Search Articles</h1>
      <p class="text-gray-600">
        Find articles across AIdepedia. Use filters to narrow down results.
      </p>
    </div>

    <!-- Search Input with Suggestions -->
    <div class="mb-6">
      <label for="search-input" class="block text-sm font-medium text-gray-700 mb-2">
        Search articles
      </label>
      <div class="relative" role="search">
        <input
          type="search"
          id="search-input"
          placeholder="Search articles..."
          class="w-full px-6 py-4 text-lg border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all"
          autocomplete="off"
          aria-describedby="search-help"
          aria-owns="suggestions"
          aria-autocomplete="list"
        />
        <span id="search-help" class="sr-only">
          Enter keywords to search for articles. Use filters to narrow results.
        </span>
        <!-- Loading indicator -->
        <div id="search-loading" class="absolute right-4 top-1/2 transform -translate-y-1/2 hidden">
          <svg class="animate-spin h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
        <!-- Suggestions dropdown -->
        <div
          id="suggestions"
          role="listbox"
          aria-label="Search suggestions"
          class="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg hidden max-h-96 overflow-y-auto"
        ></div>
      </div>
      <!-- "Did you mean?" suggestion -->
      <div id="did-you-mean" class="mt-2 hidden">
        <span class="text-gray-600">Did you mean: </span>
        <button
          id="did-you-mean-btn"
          class="text-blue-600 hover:text-blue-800 font-medium underline"
        ></button>
      </div>
    </div>

    <!-- Active Filters Display -->
    <div id="active-filters" class="mb-4 hidden">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-sm font-medium text-gray-700">Active filters:</span>
        <div id="filter-tags" class="flex gap-2 flex-wrap"></div>
      </div>
    </div>

    <!-- Filters and Sort Row -->
    <div class="flex flex-wrap gap-4 mb-8" role="group" aria-label="Search filters">
      <!-- Category Filter -->
      <div class="flex-1 min-w-[200px]">
        <label for="category-filter" class="block text-sm font-medium text-gray-700 mb-2">Category</label>
        <select
          id="category-filter"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
          aria-describedby="category-help"
        >
          <option value="">All Categories</option>
          {categories.map(cat => (
            <option value={cat.slug}>{cat.name}</option>
          ))}
        </select>
      </div>

      <!-- Quality Score Filter -->
      <div class="flex-1 min-w-[200px]">
        <label for="quality-filter" class="block text-sm font-medium text-gray-700 mb-2">Quality Score</label>
        <select
          id="quality-filter"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
        >
          <option value="">Any Quality</option>
          <option value="70-100">High (70+)</option>
          <option value="40-69">Medium (40-69)</option>
          <option value="0-39">Low (0-39)</option>
        </select>
      </div>

      <!-- Date Range Filter -->
      <div class="flex-1 min-w-[200px]">
        <label for="date-filter" class="block text-sm font-medium text-gray-700 mb-2">Date Range</label>
        <select
          id="date-filter"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
        >
          <option value="">Any Time</option>
          <option value="today">Today</option>
          <option value="week">This Week</option>
          <option value="month">This Month</option>
          <option value="year">This Year</option>
        </select>
      </div>

      <!-- Sort Options -->
      <div class="flex-1 min-w-[200px]">
        <label for="sort-filter" class="block text-sm font-medium text-gray-700 mb-2">Sort By</label>
        <select
          id="sort-filter"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
        >
          <option value="relevance">Relevance</option>
          <option value="date">Date</option>
          <option value="quality">Quality Score</option>
          <option value="popularity">Popularity</option>
        </select>
      </div>

      <!-- Clear Filters Button -->
      <div class="flex items-end">
        <button
          id="clear-filters"
          type="button"
          class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors"
          aria-label="Clear all search filters"
        >
          Clear Filters
        </button>
      </div>
    </div>

    <!-- Recent Searches -->
    <div id="recent-searches-container" class="mb-8 hidden">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-medium text-gray-700">Recent Searches</h3>
        <button
          id="clear-history"
          class="text-sm text-red-600 hover:text-red-800"
          aria-label="Clear search history"
        >
          Clear History
        </button>
      </div>
      <div id="recent-searches" class="flex flex-wrap gap-2"></div>
    </div>

    <!-- Results Container -->
    <div
      id="results-container"
      role="region"
      aria-label="Search results"
      aria-live="polite"
      aria-atomic="true"
    >
      <!-- Results will be injected here -->
    </div>

    <!-- Pagination -->
    <nav
      id="pagination-container"
      class="mt-8 hidden"
      role="navigation"
      aria-label="Search results pagination"
    >
      <div id="pagination" class="flex justify-center gap-2" role="list"></div>
    </nav>

    <!-- No Results -->
    <div id="no-results" class="hidden text-center py-16">
      <svg class="mx-auto h-16 w-16 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <h3 class="text-xl font-semibold text-gray-900 mb-2">No results found</h3>
      <p class="text-gray-600 mb-6">Try adjusting your search or filters</p>
      <div id="suggestions-list" class="text-sm text-gray-500">
        <p>Suggestions:</p>
        <ul class="list-disc list-inside mt-2 space-y-1">
          <li>Check your spelling</li>
          <li>Try more general keywords</li>
          <li>Remove some filters</li>
          <li>Try different keywords</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

<script>
  // State
  let searchTimeout: ReturnType<typeof setTimeout> | null = null;
  let currentQuery = '';
  let currentPage = 1;
  let abortController: AbortController | null = null;
  let didYouMeanQuery: string | null = null;

  // DOM Elements
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchLoading = document.getElementById('search-loading');
  const suggestionsDiv = document.getElementById('suggestions');
  const didYouMeanDiv = document.getElementById('did-you-mean');
  const didYouMeanBtn = document.getElementById('did-you-mean-btn') as HTMLButtonElement;
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
  const qualityFilter = document.getElementById('quality-filter') as HTMLSelectElement;
  const dateFilter = document.getElementById('date-filter') as HTMLSelectElement;
  const sortFilter = document.getElementById('sort-filter') as HTMLSelectElement;
  const clearFiltersBtn = document.getElementById('clear-filters');
  const activeFiltersDiv = document.getElementById('active-filters');
  const filterTagsDiv = document.getElementById('filter-tags');
  const resultsContainer = document.getElementById('results-container');
  const paginationContainer = document.getElementById('pagination-container');
  const paginationDiv = document.getElementById('pagination');
  const noResultsDiv = document.getElementById('no-results');
  const recentSearchesContainer = document.getElementById('recent-searches-container');
  const recentSearchesDiv = document.getElementById('recent-searches');
  const clearHistoryBtn = document.getElementById('clear-history');

  // Initialize from URL params
  function initFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const query = params.get('q') || '';
    const category = params.get('category') || '';
    const quality = params.get('quality') || '';
    const sort = params.get('sort') || 'relevance';
    const page = params.get('page') || '1';
    const date = params.get('dateFrom') || '';

    searchInput.value = query;
    categoryFilter.value = category;
    qualityFilter.value = quality;
    dateFilter.value = date;
    sortFilter.value = sort;
    currentPage = parseInt(page, 10);

    updateActiveFilters();

    if (query) {
      performSearch();
    }
    
    loadRecentSearches();
  }

  // Update URL params
  function updateUrl() {
    const params = new URLSearchParams();
    
    if (currentQuery) params.set('q', currentQuery);
    if (categoryFilter.value) params.set('category', categoryFilter.value);
    if (qualityFilter.value) params.set('quality', qualityFilter.value);
    if (sortFilter.value !== 'relevance') params.set('sort', sortFilter.value);
    if (currentPage > 1) params.set('page', currentPage.toString());
    if (dateFilter.value) params.set('dateFrom', dateFilter.value);

    const newUrl = `${window.location.pathname}?${params.toString()}`;
    window.history.replaceState({}, '', newUrl);
  }

  // Update active filters display
  function updateActiveFilters() {
    const filters: { label: string; value: string; clear: () => void }[] = [];

    if (categoryFilter.value) {
      const option = categoryFilter.options[categoryFilter.selectedIndex];
      filters.push({
        label: 'Category',
        value: option.text,
        clear: () => { categoryFilter.value = ''; }
      });
    }

    if (qualityFilter.value) {
      const option = qualityFilter.options[qualityFilter.selectedIndex];
      filters.push({
        label: 'Quality',
        value: option.text,
        clear: () => { qualityFilter.value = ''; }
      });
    }

    if (dateFilter.value) {
      const option = dateFilter.options[dateFilter.selectedIndex];
      filters.push({
        label: 'Date',
        value: option.text,
        clear: () => { dateFilter.value = ''; }
      });
    }

    if (sortFilter.value !== 'relevance') {
      const option = sortFilter.options[sortFilter.selectedIndex];
      filters.push({
        label: 'Sort',
        value: option.text,
        clear: () => { sortFilter.value = 'relevance'; }
      });
    }

    if (filters.length === 0) {
      activeFiltersDiv!.classList.add('hidden');
      return;
    }

    activeFiltersDiv!.classList.remove('hidden');
    filterTagsDiv!.innerHTML = filters.map(f => `
      <button
        class="inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm hover:bg-blue-200 transition-colors"
        onclick="removeFilter('${f.label}')"
        aria-label="Remove ${f.label} filter: ${f.value}"
      >
        <span>${f.label}: ${f.value}</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    `).join('');
  }

  // Remove individual filter
  (window as any).removeFilter = (label: string) => {
    switch (label) {
      case 'Category':
        categoryFilter.value = '';
        break;
      case 'Quality':
        qualityFilter.value = '';
        break;
      case 'Date':
        dateFilter.value = '';
        break;
      case 'Sort':
        sortFilter.value = 'relevance';
        break;
    }
    updateActiveFilters();
    if (currentQuery) performSearch();
    updateUrl();
  };

  // Debounced search
  function debounceSearch() {
    if (searchTimeout) clearTimeout(searchTimeout);
    
    searchTimeout = setTimeout(() => {
      currentPage = 1;
      performSearch();
    }, 300);
  }

  // Perform search
  async function performSearch() {
    const query = searchInput.value.trim();
    currentQuery = query;

    if (!query) {
      resultsContainer!.innerHTML = '';
      paginationContainer!.classList.add('hidden');
      noResultsDiv!.classList.add('hidden');
      suggestionsDiv!.classList.add('hidden');
      didYouMeanDiv!.classList.add('hidden');
      updateUrl();
      return;
    }

    // Cancel previous request
    if (abortController) {
      abortController.abort();
    }
    abortController = new AbortController();

    // Show loading
    searchLoading!.classList.remove('hidden');
    suggestionsDiv!.classList.add('hidden');

    try {
      // Build search URL
      const params = new URLSearchParams();
      params.set('q', query);
      params.set('page', currentPage.toString());
      if (categoryFilter.value) params.set('category', categoryFilter.value);
      if (qualityFilter.value) {
        const [min, max] = qualityFilter.value.split('-');
        params.set('minQuality', min);
        params.set('maxQuality', max);
      }
      if (dateFilter.value) params.set('dateFrom', dateFilter.value);
      if (sortFilter.value) params.set('sortBy', sortFilter.value);

      const response = await fetch(`/api/v1/search?${params.toString()}`, {
        signal: abortController.signal
      });
      const data = await response.json();

      if (data.success) {
        displayResults(data.data, data.meta);
        saveRecentSearch(query);
      } else {
        showError(data.error?.message || 'Search failed');
      }

      updateUrl();
    } catch (error: any) {
      if (error.name !== 'AbortError') {
        console.error('Search error:', error);
        showError('Failed to perform search. Please try again.');
      }
    } finally {
      searchLoading!.classList.add('hidden');
    }
  }

  // Display search results
  function displayResults(data: any, meta: any) {
    const { results, query } = data;
    const { total, page, totalPages } = meta;

    if (results.length === 0) {
      resultsContainer!.innerHTML = '';
      paginationContainer!.classList.add('hidden');
      noResultsDiv!.classList.remove('hidden');
      return;
    }

    noResultsDiv!.classList.add('hidden');

    // Display results
    resultsContainer!.innerHTML = results.map((article: any) => createArticleCard(article, query)).join('');
    
    // Display pagination
    if (totalPages > 1) {
      displayPagination(page, totalPages);
      paginationContainer!.classList.remove('hidden');
    } else {
      paginationContainer!.classList.add('hidden');
    }
  }

  // Create article card HTML
  function createArticleCard(article: any, query: string) {
    const dateToShow = article.publishedAt || article.createdAt;
    const formattedDate = new Date(dateToShow).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });

    const relevanceScore = article.relevanceScore || 0;
    const relevanceBadge = relevanceScore >= 80 ? 'bg-green-100 text-green-700' :
                          relevanceScore >= 60 ? 'bg-yellow-100 text-yellow-700' :
                          'bg-gray-100 text-gray-700';

    return `
      <article class="bg-white rounded-xl shadow-md border border-gray-200 p-6 hover:shadow-lg transition-shadow mb-6" role="article">
        <div class="flex items-start justify-between gap-6">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-2">
              ${article.category ? `
                <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-medium rounded-full" aria-label="Category: ${article.category}">
                  ${article.category}
                </span>
              ` : ''}
              ${relevanceScore > 0 && sortFilter.value === 'relevance' ? `
                <span class="px-2 py-1 ${relevanceBadge} text-xs font-medium rounded-full" aria-label="Relevance score: ${relevanceScore}">
                  Relevance: ${relevanceScore}%
                </span>
              ` : ''}
              ${article.tags && article.tags.length > 0 ? `
                <div class="flex gap-1" aria-label="Tags">
                  ${article.tags.slice(0, 3).map((tag: string) => `
                    <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded-full">
                      #${tag}
                    </span>
                  `).join('')}
                </div>
              ` : ''}
            </div>

            <a href="/articles/${article.slug}" class="group" aria-label="Read article: ${article.title}">
              <h2 class="text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2">
                ${highlightText(article.title, query)}
              </h2>
            </a>

            ${article.excerpt ? `
              <p class="text-gray-600 mb-4 line-clamp-2">
                ${highlightText(article.excerpt, query)}
              </p>
            ` : ''}

            <div class="flex items-center gap-4 text-sm text-gray-500" aria-label="Article statistics">
              <span>
                Quality Score: <strong class="text-gray-700">${article.qualityScore || 0}</strong>
              </span>
              <span aria-hidden="true">•</span>
              <span>
                ${article.upvotes - article.downvotes} votes
              </span>
              <span aria-hidden="true">•</span>
              <span>
                ${article.viewCount || 0} views
              </span>
              <span aria-hidden="true">•</span>
              <time datetime="${dateToShow}">
                ${formattedDate}
              </time>
            </div>
          </div>

          <div class="flex flex-col items-center gap-1" role="group" aria-label="Voting">
            <button class="p-2 hover:bg-gray-100 rounded transition-colors" title="Upvote" aria-label="Upvote article">
              <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
              </svg>
            </button>
            <span class="font-semibold text-gray-700" aria-label="Vote score">${article.upvotes - article.downvotes}</span>
            <button class="p-2 hover:bg-gray-100 rounded transition-colors" title="Downvote" aria-label="Downvote article">
              <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
          </div>
        </div>
      </article>
    `;
  }

  // Highlight matching text
  function highlightText(text: string, query: string) {
    if (!query) return text;
    
    const regex = new RegExp(`(${escapeRegex(query)})`, 'gi');
    return text.replace(regex, '<mark class="bg-yellow-200 px-1 rounded">$1</mark>');
  }

  // Escape regex special characters
  function escapeRegex(string: string) {
    return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  // Display pagination
  function displayPagination(currentPage: number, totalPages: number) {
    const pages: (number | string)[] = [];

    // Always show first page
    pages.push(1);

    // Show pages around current
    for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
      if (pages[pages.length - 1] !== i - 1) pages.push('...');
      pages.push(i);
    }

    // Always show last page
    if (totalPages > 1) {
      if (pages[pages.length - 1] !== totalPages - 1) pages.push('...');
      pages.push(totalPages);
    }

    paginationDiv!.innerHTML = pages.map(p => {
      if (p === '...') {
        return '<span class="px-4 py-2 text-gray-500" aria-hidden="true">...</span>';
      }
      return `
        <button
          role="listitem"
          class="px-4 py-2 rounded-lg ${p === currentPage
            ? 'bg-blue-600 text-white'
            : 'bg-white text-gray-700 hover:bg-gray-100 border border-gray-300'}"
          onclick="goToPage(${p})"
          aria-label="Go to page ${p}"
          aria-current="${p === currentPage ? 'page' : 'false'}"
        >
          ${p}
        </button>
      `;
    }).join('');
  }

  // Go to page
  (window as any).goToPage = (page: number) => {
    currentPage = page;
    performSearch();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // Show error
  function showError(message: string) {
    resultsContainer!.innerHTML = `
      <div class="text-center py-16">
        <p class="text-red-600 text-lg">${message}</p>
      </div>
    `;
    paginationContainer!.classList.add('hidden');
    noResultsDiv!.classList.add('hidden');
  }

  // Recent searches management
  function loadRecentSearches() {
    const recent = JSON.parse(localStorage.getItem('recentSearches') || '[]');
    
    if (recent.length === 0) {
      recentSearchesContainer!.classList.add('hidden');
      return;
    }

    recentSearchesContainer!.classList.remove('hidden');
    recentSearchesDiv!.innerHTML = recent.map((search: string) => `
      <button
        class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-gray-200 transition-colors"
        onclick="useRecentSearch('${search.replace(/'/g, "\\'")}')"
      >
        ${search}
      </button>
    `).join('');
  }

  function saveRecentSearch(query: string) {
    let recent = JSON.parse(localStorage.getItem('recentSearches') || '[]');
    
    // Remove if already exists
    recent = recent.filter((s: string) => s !== query);
    
    // Add to beginning
    recent.unshift(query);
    
    // Keep only last 5
    recent = recent.slice(0, 5);
    
    localStorage.setItem('recentSearches', JSON.stringify(recent));
    loadRecentSearches();
  }

  (window as any).useRecentSearch = (query: string) => {
    searchInput.value = query;
    currentQuery = query;
    currentPage = 1;
    performSearch();
  };

  // Clear search history
  clearHistoryBtn!.addEventListener('click', () => {
    localStorage.removeItem('recentSearches');
    loadRecentSearches();
  });

  // Live suggestions with "did you mean"
  async function showSuggestions(query: string) {
    if (query.length < 2) {
      suggestionsDiv!.classList.add('hidden');
      didYouMeanDiv!.classList.add('hidden');
      return;
    }

    try {
      const response = await fetch(`/api/v1/autocomplete?q=${encodeURIComponent(query)}&limit=5`);
      const data = await response.json();

      if (data.success) {
        // Show "did you mean" suggestion
        if (data.data.didYouMean) {
          didYouMeanQuery = data.data.didYouMean;
          didYouMeanBtn.textContent = data.data.didYouMean;
          didYouMeanDiv!.classList.remove('hidden');
        } else {
          didYouMeanDiv!.classList.add('hidden');
          didYouMeanQuery = null;
        }

        // Show autocomplete suggestions
        if (data.data.suggestions.length > 0) {
          suggestionsDiv!.innerHTML = `
            <ul class="divide-y divide-gray-200" role="listbox">
              ${data.data.suggestions.map((article: any, index: number) => `
                <li role="option" aria-selected="false">
                  <a
                    href="/articles/${article.slug}"
                    class="block px-4 py-3 hover:bg-gray-50 transition-colors"
                    role="option"
                    tabindex="0"
                    aria-label="${article.title}"
                  >
                    <div class="font-medium text-gray-900">${highlightText(article.title, query)}</div>
                    ${article.excerpt ? `
                      <div class="text-sm text-gray-500 truncate">${highlightText(article.excerpt, query)}</div>
                    ` : ''}
                  </a>
                </li>
              `).join('')}
            </ul>
          `;
          suggestionsDiv!.classList.remove('hidden');
        } else {
          suggestionsDiv!.classList.add('hidden');
        }
      }
    } catch (error) {
      console.error('Suggestions error:', error);
    }
  }

  // "Did you mean" click handler
  didYouMeanBtn.addEventListener('click', () => {
    if (didYouMeanQuery) {
      searchInput.value = didYouMeanQuery;
      currentQuery = didYouMeanQuery;
      currentPage = 1;
      didYouMeanDiv!.classList.add('hidden');
      performSearch();
    }
  });

  // Event listeners
  searchInput.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.trim();
    
    // Show suggestions immediately
    if (query.length >= 2) {
      showSuggestions(query);
    } else {
      suggestionsDiv!.classList.add('hidden');
      didYouMeanDiv!.classList.add('hidden');
    }
    
    // Debounced search
    debounceSearch();
  });

  searchInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      if (searchTimeout) clearTimeout(searchTimeout);
      currentPage = 1;
      performSearch();
      suggestionsDiv!.classList.add('hidden');
    }
  });

  // Close suggestions when clicking outside
  document.addEventListener('click', (e) => {
    if (!searchInput.contains(e.target as Node) && !suggestionsDiv!.contains(e.target as Node)) {
      suggestionsDiv!.classList.add('hidden');
    }
  });

  categoryFilter.addEventListener('change', () => {
    updateActiveFilters();
    currentPage = 1;
    if (currentQuery) performSearch();
    updateUrl();
  });

  qualityFilter.addEventListener('change', () => {
    updateActiveFilters();
    currentPage = 1;
    if (currentQuery) performSearch();
    updateUrl();
  });

  sortFilter.addEventListener('change', () => {
    updateActiveFilters();
    currentPage = 1;
    if (currentQuery) performSearch();
    updateUrl();
  });

  dateFilter.addEventListener('change', () => {
    updateActiveFilters();
    currentPage = 1;
    if (currentQuery) performSearch();
    updateUrl();
  });

  clearFiltersBtn!.addEventListener('click', () => {
    searchInput.value = '';
    categoryFilter.value = '';
    qualityFilter.value = '';
    dateFilter.value = '';
    sortFilter.value = 'relevance';
    currentQuery = '';
    currentPage = 1;
    resultsContainer!.innerHTML = '';
    paginationContainer!.classList.add('hidden');
    noResultsDiv!.classList.add('hidden');
    suggestionsDiv!.classList.add('hidden');
    didYouMeanDiv!.classList.add('hidden');
    updateActiveFilters();
    updateUrl();
  });

  // Initialize
  initFromUrl();
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
