---
/**
 * Admin Quality Dashboard Page (OC-131)
 * Displays quality analytics for administrators
 */

import Layout from '../../layouts/Layout.astro';
import QualityDashboard from '../../components/QualityDashboard.astro';
import { getQualityAnalytics } from '../../lib/quality-scoring';

// Check authentication
// Note: In a real app, you'd check session/auth here
// For now, we'll just fetch the data

let analytics = null;
try {
  analytics = await getQualityAnalytics();
} catch (error) {
  console.error('Failed to fetch quality analytics:', error);
}
---

<Layout title="Quality Dashboard - AIdepedia Admin">
  <main class="admin-quality-page">
    <QualityDashboard analytics={analytics} />
  </main>
</Layout>

<style>
.admin-quality-page {
  min-height: 100vh;
  background: #f5f5f5;
}
</style>
