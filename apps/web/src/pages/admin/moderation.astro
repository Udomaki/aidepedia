---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Moderation Dashboard">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">Moderation Dashboard</h1>
      <p class="text-gray-600">
        Review flagged content, manage moderation actions, and handle appeals.
      </p>
    </div>

    <!-- Tabs -->
    <div class="mb-6 border-b border-gray-200">
      <nav class="-mb-px flex space-x-8">
        <button
          id="flags-tab"
          class="tab-button border-b-2 border-blue-500 text-blue-600 py-4 px-1 font-medium text-sm"
          data-tab="flags"
        >
          Flags Queue
        </button>
        <button
          id="appeals-tab"
          class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 font-medium text-sm"
          data-tab="appeals"
        >
          Appeals
        </button>
        <button
          id="audit-tab"
          class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 font-medium text-sm"
          data-tab="audit"
        >
          Audit Log
        </button>
      </nav>
    </div>

    <!-- Flags Queue Tab -->
    <div id="flags-content" class="tab-content">
      <!-- Filters -->
      <div class="mb-6 bg-white rounded-lg shadow p-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label for="status-filter" class="block text-sm font-medium text-gray-700 mb-1">
              Status
            </label>
            <select id="status-filter" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="">All Statuses</option>
              <option value="pending">Pending</option>
              <option value="under_review">Under Review</option>
              <option value="approved">Approved</option>
              <option value="rejected">Rejected</option>
              <option value="escalated">Escalated</option>
            </select>
          </div>
          <div>
            <label for="severity-filter" class="block text-sm font-medium text-gray-700 mb-1">
              Severity
            </label>
            <select id="severity-filter" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="">All Severities</option>
              <option value="low">Low</option>
              <option value="medium">Medium</option>
              <option value="high">High</option>
              <option value="critical">Critical</option>
            </select>
          </div>
          <div>
            <label for="content-type-filter" class="block text-sm font-medium text-gray-700 mb-1">
              Content Type
            </label>
            <select id="content-type-filter" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="">All Types</option>
              <option value="article">Article</option>
              <option value="comment">Comment</option>
              <option value="user_profile">User Profile</option>
            </select>
          </div>
          <div class="flex items-end">
            <button
              id="apply-filters"
              class="w-full px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
            >
              Apply Filters
            </button>
          </div>
        </div>
      </div>

      <!-- Flags List -->
      <div id="flags-list" class="bg-white rounded-lg shadow">
        <div class="p-8 text-center text-gray-500">
          Loading flags...
        </div>
      </div>

      <!-- Pagination -->
      <div id="flags-pagination" class="mt-6 flex justify-center gap-2"></div>
    </div>

    <!-- Appeals Tab -->
    <div id="appeals-content" class="tab-content hidden">
      <div id="appeals-list" class="bg-white rounded-lg shadow">
        <div class="p-8 text-center text-gray-500">
          Loading appeals...
        </div>
      </div>
      <div id="appeals-pagination" class="mt-6 flex justify-center gap-2"></div>
    </div>

    <!-- Audit Log Tab -->
    <div id="audit-content" class="tab-content hidden">
      <div id="audit-list" class="bg-white rounded-lg shadow overflow-x-auto">
        <div class="p-8 text-center text-gray-500">
          Loading audit log...
        </div>
      </div>
      <div id="audit-pagination" class="mt-6 flex justify-center gap-2"></div>
    </div>
  </div>
</Layout>

<script>
  // State
  let currentTab = 'flags';
  let currentPage = {
    flags: 1,
    appeals: 1,
    audit: 1
  };

  // Tab switching
  document.querySelectorAll('.tab-button').forEach(button => {
    button.addEventListener('click', () => {
      const tab = button.dataset.tab;
      currentTab = tab;

      // Update tab styles
      document.querySelectorAll('.tab-button').forEach(btn => {
        btn.classList.remove('border-blue-500', 'text-blue-600');
        btn.classList.add('border-transparent', 'text-gray-500');
      });
      button.classList.remove('border-transparent', 'text-gray-500');
      button.classList.add('border-blue-500', 'text-blue-600');

      // Show/hide content
      document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.add('hidden');
      });
      document.getElementById(`${tab}-content`)?.classList.remove('hidden');

      // Load data
      loadData(tab);
    });
  });

  // Filter application
  document.getElementById('apply-filters')?.addEventListener('click', () => {
    currentPage.flags = 1;
    loadData('flags');
  });

  // Load data based on tab
  async function loadData(tab: string) {
    if (tab === 'flags') {
      await loadFlags();
    } else if (tab === 'appeals') {
      await loadAppeals();
    } else if (tab === 'audit') {
      await loadAuditLog();
    }
  }

  // Load flags
  async function loadFlags() {
    const status = (document.getElementById('status-filter') as HTMLSelectElement)?.value;
    const severity = (document.getElementById('severity-filter') as HTMLSelectElement)?.value;
    const contentType = (document.getElementById('content-type-filter') as HTMLSelectElement)?.value;

    const params = new URLSearchParams();
    if (status) params.append('status', status);
    if (severity) params.append('severity', severity);
    if (contentType) params.append('contentType', contentType);
    params.append('page', currentPage.flags.toString());
    params.append('limit', '20');

    try {
      const response = await fetch(`/api/v1/moderation/flags?${params}`);
      const result = await response.json();

      if (response.ok) {
        renderFlags(result.data);
        renderPagination('flags', result.meta);
      } else {
        console.error('Error loading flags:', result.error);
      }
    } catch (error) {
      console.error('Error loading flags:', error);
    }
  }

  // Render flags
  function renderFlags(flags: any[]) {
    const container = document.getElementById('flags-list');
    if (!container) return;

    if (flags.length === 0) {
      container.innerHTML = '<div class="p-8 text-center text-gray-500">No flags found</div>';
      return;
    }

    container.innerHTML = flags.map(flag => `
      <div class="border-b border-gray-200 p-6 last:border-b-0 hover:bg-gray-50">
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getSeverityColor(flag.severity)}">
                ${flag.severity}
              </span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getStatusColor(flag.status)}">
                ${flag.status.replace('_', ' ')}
              </span>
              <span class="text-sm text-gray-500">${flag.contentType}</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-1">
              ${flag.content?.title || `Content ID: ${flag.contentId}`}
            </h3>
            <p class="text-sm text-gray-600 mb-2">
              <span class="font-medium">Reason:</span> ${flag.reason}
              ${flag.description ? `<br><span class="font-medium">Description:</span> ${flag.description}` : ''}
            </p>
            <div class="text-sm text-gray-500">
              Flagged by ${flag.flagger.name || flag.flagger.email} on ${new Date(flag.createdAt).toLocaleDateString()}
            </div>
          </div>
          <div class="ml-4 flex gap-2">
            ${flag.status === 'pending' ? `
              <button
                onclick="reviewFlag(${flag.id}, 'approved')"
                class="px-3 py-1 bg-green-600 text-white rounded text-sm hover:bg-green-700"
              >
                Approve
              </button>
              <button
                onclick="reviewFlag(${flag.id}, 'rejected')"
                class="px-3 py-1 bg-red-600 text-white rounded text-sm hover:bg-red-700"
              >
                Reject
              </button>
              <button
                onclick="reviewFlag(${flag.id}, 'escalated')"
                class="px-3 py-1 bg-orange-600 text-white rounded text-sm hover:bg-orange-700"
              >
                Escalate
              </button>
            ` : ''}
            ${flag.content ? `
              <a
                href="/articles/${flag.content.id}"
                target="_blank"
                class="px-3 py-1 bg-gray-600 text-white rounded text-sm hover:bg-gray-700"
              >
                View Content
              </a>
            ` : ''}
          </div>
        </div>
      </div>
    `).join('');
  }

  // Review flag
  (window as any).reviewFlag = async function(flagId: number, status: string) {
    const resolution = prompt('Enter resolution (optional):');
    try {
      const response = await fetch(`/api/v1/moderation/flags/${flagId}/review`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status, resolution })
      });

      if (response.ok) {
        loadFlags();
      } else {
        const result = await response.json();
        alert(`Error: ${result.error}`);
      }
    } catch (error) {
      console.error('Error reviewing flag:', error);
      alert('Failed to review flag');
    }
  };

  // Load appeals
  async function loadAppeals() {
    const params = new URLSearchParams();
    params.append('page', currentPage.appeals.toString());
    params.append('limit', '20');

    try {
      const response = await fetch(`/api/v1/moderation/appeals?${params}`);
      const result = await response.json();

      if (response.ok) {
        renderAppeals(result.data);
        renderPagination('appeals', result.meta);
      } else {
        console.error('Error loading appeals:', result.error);
      }
    } catch (error) {
      console.error('Error loading appeals:', error);
    }
  }

  // Render appeals
  function renderAppeals(appeals: any[]) {
    const container = document.getElementById('appeals-list');
    if (!container) return;

    if (appeals.length === 0) {
      container.innerHTML = '<div class="p-8 text-center text-gray-500">No appeals found</div>';
      return;
    }

    container.innerHTML = appeals.map(appeal => `
      <div class="border-b border-gray-200 p-6 last:border-b-0 hover:bg-gray-50">
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getAppealStatusColor(appeal.status)}">
                ${appeal.status.replace('_', ' ')}
              </span>
              <span class="text-sm text-gray-500">Appeal for ${appeal.action.actionType}</span>
            </div>
            <p class="text-sm text-gray-600 mb-2">
              ${appeal.reason}
            </p>
            <div class="text-sm text-gray-500">
              Appeal by ${appeal.appellant.name || appeal.appellant.email} on ${new Date(appeal.createdAt).toLocaleDateString()}
            </div>
          </div>
          <div class="ml-4 flex gap-2">
            ${appeal.status === 'pending' ? `
              <button
                onclick="reviewAppeal(${appeal.id}, 'approved')"
                class="px-3 py-1 bg-green-600 text-white rounded text-sm hover:bg-green-700"
              >
                Approve
              </button>
              <button
                onclick="reviewAppeal(${appeal.id}, 'rejected')"
                class="px-3 py-1 bg-red-600 text-white rounded text-sm hover:bg-red-700"
              >
                Reject
              </button>
            ` : ''}
          </div>
        </div>
      </div>
    `).join('');
  }

  // Review appeal
  (window as any).reviewAppeal = async function(appealId: number, status: string) {
    const resolution = prompt('Enter resolution (optional):');
    try {
      const response = await fetch(`/api/v1/moderation/appeals/${appealId}/review`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status, resolution })
      });

      if (response.ok) {
        loadAppeals();
      } else {
        const result = await response.json();
        alert(`Error: ${result.error}`);
      }
    } catch (error) {
      console.error('Error reviewing appeal:', error);
      alert('Failed to review appeal');
    }
  };

  // Load audit log
  async function loadAuditLog() {
    const params = new URLSearchParams();
    params.append('page', currentPage.audit.toString());
    params.append('limit', '50');

    try {
      const response = await fetch(`/api/v1/moderation/audit-log?${params}`);
      const result = await response.json();

      if (response.ok) {
        renderAuditLog(result.data);
        renderPagination('audit', result.meta);
      } else {
        console.error('Error loading audit log:', result.error);
      }
    } catch (error) {
      console.error('Error loading audit log:', error);
    }
  }

  // Render audit log
  function renderAuditLog(logs: any[]) {
    const container = document.getElementById('audit-list');
    if (!container) return;

    if (logs.length === 0) {
      container.innerHTML = '<div class="p-8 text-center text-gray-500">No audit logs found</div>';
      return;
    }

    container.innerHTML = `
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Moderator</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Resource</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Details</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          ${logs.map(log => `
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                ${new Date(log.createdAt).toLocaleString()}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                ${log.moderator.name || log.moderator.email}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                ${log.action}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                ${log.resourceType} ${log.resourceId ? `#${log.resourceId}` : ''}
              </td>
              <td class="px-6 py-4 text-sm text-gray-500">
                ${log.details ? JSON.stringify(log.details).substring(0, 100) : '-'}
              </td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  // Render pagination
  function renderPagination(type: string, meta: any) {
    const container = document.getElementById(`${type}-pagination`);
    if (!container || meta.totalPages <= 1) {
      if (container) container.innerHTML = '';
      return;
    }

    const pages = [];
    for (let i = 1; i <= meta.totalPages; i++) {
      pages.push(`
        <button
          onclick="changePage('${type}', ${i})"
          class="px-4 py-2 rounded ${i === meta.page ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50'}"
        >
          ${i}
        </button>
      `);
    }

    container.innerHTML = pages.join('');
  }

  // Change page
  (window as any).changePage = function(type: string, page: number) {
    currentPage[type as keyof typeof currentPage] = page;
    loadData(type);
  };

  // Helper functions for colors
  function getSeverityColor(severity: string): string {
    const colors: Record<string, string> = {
      low: 'bg-gray-100 text-gray-800',
      medium: 'bg-yellow-100 text-yellow-800',
      high: 'bg-orange-100 text-orange-800',
      critical: 'bg-red-100 text-red-800'
    };
    return colors[severity] || colors.medium;
  }

  function getStatusColor(status: string): string {
    const colors: Record<string, string> = {
      pending: 'bg-yellow-100 text-yellow-800',
      under_review: 'bg-blue-100 text-blue-800',
      approved: 'bg-green-100 text-green-800',
      rejected: 'bg-red-100 text-red-800',
      escalated: 'bg-orange-100 text-orange-800'
    };
    return colors[status] || colors.pending;
  }

  function getAppealStatusColor(status: string): string {
    const colors: Record<string, string> = {
      pending: 'bg-yellow-100 text-yellow-800',
      under_review: 'bg-blue-100 text-blue-800',
      approved: 'bg-green-100 text-green-800',
      rejected: 'bg-red-100 text-red-800'
    };
    return colors[status] || colors.pending;
  }

  // Initial load
  loadData('flags');
</script>
