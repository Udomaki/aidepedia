---
import { getAllUsers, getEditorById } from '@aidepedia/db';
import Layout from '../../../layouts/Layout.astro';

export const prerender = false;

// Get query params
const url = new URL(Astro.request.url);
const page = parseInt(url.searchParams.get('page') || '1');
const search = url.searchParams.get('search') || '';
const userId = url.searchParams.get('id');

// Fetch users
const usersData = await getAllUsers({ page, limit: 20, search });

// Fetch specific user if requested
let selectedUser = null;
if (userId) {
  try {
    selectedUser = await getEditorById(parseInt(userId));
  } catch (e) {
    // User not found
  }
}
---

<Layout title="User Management">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 mb-2">User Management</h1>
          <p class="text-gray-600">
            Manage user roles, permissions, and account status.
          </p>
        </div>
        <a
          href="/admin"
          class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors font-medium"
        >
          ← Back to Dashboard
        </a>
      </div>
    </div>

    <!-- Search -->
    <div class="mb-6">
      <form method="GET" class="flex gap-4">
        <input
          type="text"
          name="search"
          value={search}
          placeholder="Search users by name..."
          class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        />
        <button
          type="submit"
          class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
        >
          Search
        </button>
      </form>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- User List -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-xl shadow-md border border-gray-200 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-xl font-bold text-gray-900">
              All Users ({usersData.meta.total})
            </h2>
          </div>

          {usersData.data.length > 0 ? (
            <div class="divide-y divide-gray-200">
              {usersData.data.map(user => (
                <div class="p-4 hover:bg-gray-50 transition-colors">
                  <div class="flex items-start justify-between">
                    <div class="flex-1">
                      <div class="flex items-center gap-3 mb-2">
                        <h3 class="font-semibold text-gray-900">{user.name}</h3>
                        <span class={`px-2 py-0.5 rounded text-xs font-medium ${
                          user.tier === 'admin' ? 'bg-red-100 text-red-700' :
                          user.tier === 'senior_editor' ? 'bg-purple-100 text-purple-700' :
                          user.tier === 'editor' ? 'bg-blue-100 text-blue-700' :
                          'bg-gray-100 text-gray-700'
                        }`}>
                          {user.tier?.replace('_', ' ') || 'contributor'}
                        </span>
                        {!user.isActive && (
                          <span class="px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700">
                            Banned
                          </span>
                        )}
                      </div>
                      
                      <div class="flex items-center gap-4 text-sm text-gray-500">
                        <span>Rep: {user.reputationScore}</span>
                        <span>•</span>
                        <span>Created: {user.articlesCreated}</span>
                        <span>•</span>
                        <span>Edited: {user.articlesEdited}</span>
                      </div>

                      <p class="text-xs text-gray-400 mt-1">
                        Joined {new Date(user.createdAt || '').toLocaleDateString()}
                      </p>
                    </div>

                    <a
                      href={`/admin/users?id=${user.id}`}
                      class="px-4 py-2 bg-blue-100 text-blue-700 rounded hover:bg-blue-200 text-sm font-medium"
                    >
                      Manage
                    </a>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="p-8 text-center">
              <p class="text-gray-500">No users found</p>
            </div>
          )}

          {/* Pagination */}
          {usersData.meta.totalPages > 1 && (
            <div class="px-6 py-4 border-t border-gray-200 flex items-center justify-between">
              <p class="text-sm text-gray-500">
                Page {usersData.meta.page} of {usersData.meta.totalPages}
              </p>
              <div class="flex gap-2">
                {usersData.meta.page > 1 && (
                  <a
                    href={`/admin/users?page=${usersData.meta.page - 1}${search ? `&search=${search}` : ''}`}
                    class="px-4 py-2 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 text-sm"
                  >
                    Previous
                  </a>
                )}
                {usersData.meta.page < usersData.meta.totalPages && (
                  <a
                    href={`/admin/users?page=${usersData.meta.page + 1}${search ? `&search=${search}` : ''}`}
                    class="px-4 py-2 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 text-sm"
                  >
                    Next
                  </a>
                )}
              </div>
            </div>
          )}
        </div>
      </div>

      <!-- User Details Panel -->
      <div class="lg:col-span-1">
        {selectedUser ? (
          <div class="bg-white rounded-xl shadow-md border border-gray-200 overflow-hidden sticky top-24">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
              <h2 class="text-xl font-bold text-gray-900">User Details</h2>
            </div>

            <div class="p-6 space-y-6">
              <div>
                <h3 class="font-semibold text-gray-900 text-lg mb-2">{selectedUser.name}</h3>
                <p class="text-sm text-gray-500">ID: {selectedUser.id}</p>
              </div>

              <div class="space-y-3">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
                  <p class="text-sm text-gray-900">{selectedUser.tier?.replace('_', ' ') || 'contributor'}</p>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
                  <p class="text-sm text-gray-900 capitalize">{selectedUser.type}</p>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                  <p class={`text-sm font-medium ${selectedUser.isActive ? 'text-green-600' : 'text-red-600'}`}>
                    {selectedUser.isActive ? 'Active' : 'Banned'}
                  </p>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Reputation</label>
                  <p class="text-sm text-gray-900">{selectedUser.reputationScore}</p>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Activity</label>
                  <div class="text-sm text-gray-900 space-y-1">
                    <p>Articles Created: {selectedUser.articlesCreated}</p>
                    <p>Articles Edited: {selectedUser.articlesEdited}</p>
                    <p>Votes Cast: {selectedUser.votesCast}</p>
                  </div>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Joined</label>
                  <p class="text-sm text-gray-900">
                    {new Date(selectedUser.createdAt || '').toLocaleDateString()}
                  </p>
                </div>
              </div>

              {/* Actions */}
              <div class="pt-4 border-t border-gray-200 space-y-3">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Change Role</label>
                  <form method="POST" action="/api/admin/users/role" class="flex gap-2">
                    <input type="hidden" name="userId" value={selectedUser.id} />
                    <select
                      name="tier"
                      class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm"
                    >
                      <option value="contributor" selected={selectedUser.tier === 'contributor'}>Contributor</option>
                      <option value="editor" selected={selectedUser.tier === 'editor'}>Editor</option>
                      <option value="senior_editor" selected={selectedUser.tier === 'senior_editor'}>Senior Editor</option>
                      <option value="admin" selected={selectedUser.tier === 'admin'}>Admin</option>
                    </select>
                    <button
                      type="submit"
                      class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm font-medium"
                    >
                      Update
                    </button>
                  </form>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Account Status</label>
                  <form method="POST" action="/api/admin/users/status" class="flex gap-2">
                    <input type="hidden" name="userId" value={selectedUser.id} />
                    <input type="hidden" name="isActive" value={selectedUser.isActive ? 'false' : 'true'} />
                    <button
                      type="submit"
                      class={`w-full px-4 py-2 rounded-lg text-sm font-medium ${
                        selectedUser.isActive
                          ? 'bg-red-600 text-white hover:bg-red-700'
                          : 'bg-green-600 text-white hover:bg-green-700'
                      }`}
                    >
                      {selectedUser.isActive ? 'Ban User' : 'Unban User'}
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <div class="bg-white rounded-xl shadow-md border border-gray-200 p-8 text-center sticky top-24">
            <p class="text-gray-500">Select a user to view details</p>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
