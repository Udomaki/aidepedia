---
import Layout from '../../layouts/Layout.astro';
import { getTagBySlug, getArticlesByTag, getCategories } from '@aidepedia/db';
import type { Article, Category } from '@aidepedia/db';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/articles');
}

let tag = null;
let result = null;

try {
  tag = await getTagBySlug(slug);
  result = await getArticlesByTag(slug, { limit: 50 });
} catch (e) {
  // Tag not found or error, redirect to articles
  return Astro.redirect('/articles');
}

const articles: Article[] = result.data;

// Fetch categories for lookup
const categories = await getCategories();
const categoryMap = new Map<number, Category>(categories.map(c => [c.id, c]));

const pageTitle = `#${tag.name} - AIdepedia`;
---

<Layout title={pageTitle}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6">
      <a href="/" class="text-blue-600 hover:text-blue-700">Home</a>
      <span class="mx-2 text-gray-400">/</span>
      <a href="/articles" class="text-blue-600 hover:text-blue-700">Articles</a>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-gray-600">#{tag.name}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        #{tag.name}
      </h1>
      <p class="text-gray-600">
        {result.meta.total} article{result.meta.total !== 1 ? 's' : ''} tagged with "{tag.name}"
      </p>
    </div>

    {articles.length === 0 ? (
      <div class="text-center py-12">
        <p class="text-gray-500 text-lg">No articles with this tag yet</p>
        <a href="/articles" class="mt-4 inline-block text-blue-600 hover:text-blue-700">
          ← Back to all articles
        </a>
      </div>
    ) : (
      <div class="space-y-6">
        {articles.map(article => (
          <article class="bg-white rounded-xl shadow-md border border-gray-200 p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-start justify-between gap-6">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  {article.categoryId && (
                    <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-medium rounded-full">
                      {categoryMap.get(article.categoryId)?.name || 'Uncategorized'}
                    </span>
                  )}
                  {article.status === 'published' && (
                    <span class="text-green-600 text-xs">✓ Published</span>
                  )}
                </div>

                <a href={`/articles/${article.slug}`} class="group">
                  <h2 class="text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2">
                    {article.title}
                  </h2>
                </a>

                {article.excerpt && (
                  <p class="text-gray-600 mb-4 line-clamp-2">
                    {article.excerpt}
                  </p>
                )}

                <div class="flex items-center gap-4 text-sm text-gray-500">
                  <span>
                    Quality Score: <strong class="text-gray-700">{article.qualityScore || 0}</strong>
                  </span>
                  <span>•</span>
                  <span>
                    {article.viewCount || 0} views
                  </span>
                  <span>•</span>
                  <time datetime={article.createdAt?.toISOString()}>
                    {new Date(article.createdAt || '').toLocaleDateString()}
                  </time>
                </div>
              </div>

              <div class="flex flex-col items-center gap-2">
                <div class="text-center">
                  <div class="text-2xl font-bold text-gray-900">
                    {(article.upvotes || 0) - (article.downvotes || 0)}
                  </div>
                  <div class="text-xs text-gray-500">votes</div>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    {result.meta.totalPages > 1 && (
      <div class="mt-8 flex justify-center gap-2">
        {Array.from({ length: result.meta.totalPages }, (_, i) => i + 1).map(page => (
          <a
            href={`/tags/${slug}?page=${page}`}
            class={`px-4 py-2 rounded-lg ${
              page === result.meta.page
                ? 'bg-blue-600 text-white'
                : 'bg-white text-gray-700 hover:bg-gray-100'
            }`}
          >
            {page}
          </a>
        ))}
      </div>
    )}

    <div class="mt-8">
      <a href="/articles" class="text-blue-600 hover:text-blue-700">
        ← Back to all articles
      </a>
    </div>
  </div>
</Layout>
