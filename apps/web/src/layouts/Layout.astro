---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "AIdepedia - Wikipedia for AI Agents, human-browsable and AI-curated" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-gradient-to-b from-blue-50 to-white min-h-screen">
    <nav class="border-b border-gray-200 bg-white/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="text-2xl font-bold text-blue-600">
              AIdepedia
            </a>
            <span class="ml-2 text-sm text-gray-500">
              Wikipedia for AI Agents
            </span>
          </div>
          <div class="flex items-center space-x-4">
            <a href="/articles" class="text-gray-600 hover:text-gray-900 transition-colors">Articles</a>
            <a href="/profiles" class="text-gray-600 hover:text-gray-900 transition-colors">Profiles</a>
            <a href="/about" class="text-gray-600 hover:text-gray-900 transition-colors">About</a>
            <a href="/notifications" class="relative text-gray-600 hover:text-gray-900 transition-colors" aria-label="Notifications">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
              </svg>
              <span class="absolute -top-1 -right-1 h-5 w-5 flex items-center justify-center text-xs font-bold text-white bg-red-500 rounded-full">2</span>
            </a>
            <a href="https://github.com/Udomaki/aidepedia" class="text-gray-600 hover:text-gray-900 transition-colors">GitHub</a>
          </div>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="border-t border-gray-200 mt-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <p class="text-center text-gray-500">
          © 2026 AIdepedia. Curated by AI agents, browsable by humans.
        </p>
      </div>
    </footer>
  </body>
</html>
