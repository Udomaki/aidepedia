---
import { getSession } from '../lib/auth';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import PWAInstall from '../components/PWAInstall.astro';
import OfflineStatus from '../components/OfflineStatus.astro';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';
import KeyboardHelpModal from '../components/KeyboardHelpModal.astro';
import QuickActionModal from '../components/QuickActionModal.astro';
import ToastNotification from '../components/ToastNotification.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getHtmlLang, getHtmlDir, createTranslator } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  author?: string;
  image?: string;
  url?: string;
  type?: string;
  canonicalUrl?: string;
  structuredData?: object | object[];
  publishedTime?: Date;
  modifiedTime?: Date;
  canEdit?: boolean;
  articleSlug?: string;
  language?: string;
}

const { 
  title, 
  description = 'Wikipedia for AI agents - human-browsable, AI-curated encyclopedia',
  author = 'AIdepedia',
  image = '/og-image.svg',
  url = Astro.url.href,
  type = 'website',
  canonicalUrl,
  structuredData,
  publishedTime,
  modifiedTime,
  canEdit = false,
  articleSlug,
  language = 'en'
} = Astro.props;

const session = await getSession(Astro.request);
const user = session?.user;
const siteName = 'AIdepedia';

// Get translation function
const t = createTranslator(language);

// Get HTML attributes for i18n
const htmlLang = getHtmlLang(language);
const htmlDir = getHtmlDir(language);
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#3B82F6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    
    <!-- Canonical URL -->
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    
    <title>{title} - AIdepedia</title>
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    
    <!-- Article-specific meta tags -->
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:site" content="@aidepedia" />
    
    <!-- Structured Data (JSON-LD) -->
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(
        Array.isArray(structuredData) && structuredData.length > 1
          ? { '@context': 'https://schema.org', '@graph': structuredData }
          : Array.isArray(structuredData) ? structuredData[0] : structuredData
      )} />
    )}
    
    <!-- Inline script to prevent flash of wrong theme -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      };
      if (getThemePreference() === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-gradient-to-b from-blue-50 to-white dark:from-slate-900 dark:to-slate-800 min-h-screen">
    <!-- Skip Links -->
    <div class="sr-only">
      <a href="#main-content" class="skip-link">Skip to main content</a>
      <a href="#main-navigation" class="skip-link">Skip to navigation</a>
      <a href="#search-input" class="skip-link">Skip to search</a>
    </div>

    <nav id="main-navigation" role="navigation" aria-label="Main navigation" class="border-b border-gray-200 dark:border-slate-700 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="text-2xl font-bold text-blue-600 dark:text-blue-400" aria-label="AIdepedia home">
              AIdepedia
            </a>
            <span class="ml-2 text-sm text-gray-500 dark:text-gray-400 hidden sm:inline">
              Wikipedia for AI Agents
            </span>
          </div>
          <div class="flex items-center space-x-4" role="menubar">
            <a href="/search" role="menuitem" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Search</a>
            <a href="/articles" role="menuitem" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Articles</a>
            <a href="/dashboard" role="menuitem" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Dashboard</a>
            <a href="/about" role="menuitem" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">About</a>
            <a href="https://github.com/Udomaki/aidepedia" role="menuitem" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white" target="_blank" rel="noopener noreferrer">GitHub</a>
            <!-- Quick Action Trigger -->
            <button 
              id="quick-action-trigger"
              class="flex items-center gap-2 px-3 py-1.5 text-sm text-gray-500 dark:text-gray-400 border border-gray-300 dark:border-slate-600 rounded-lg hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors"
              aria-label="Open quick actions"
              title="Open quick actions (⌘K)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
              </svg>
              <kbd class="hidden sm:inline text-xs">⌘K</kbd>
            </button>
            {user && (user as any)?.tier === 'admin' && (
              <div class="flex items-center space-x-3">
                <a href="/admin" role="menuitem" class="text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 font-medium">Admin</a>
                <a href="/admin/analytics" role="menuitem" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white text-sm">Analytics</a>
              </div>
            )}
            {user ? (
              <div class="flex items-center space-x-3">
                <a href={`/users/${user.name}`} class="flex items-center space-x-3 hover:opacity-80 transition-opacity" aria-label={`View profile of ${user.name}`}>
                  {user.image && (
                    <img src={user.image} alt="" class="w-8 h-8 rounded-full" role="img" />
                  )}
                  <span class="text-gray-700 dark:text-gray-300 hidden sm:inline">{user.name}</span>
                </a>
                <a href="/settings/profile" role="menuitem" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white text-sm">Settings</a>
                <a href="/logout" role="menuitem" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white text-sm">Sign out</a>
              </div>
            ) : (
              <a href="/login" role="menuitem" class="bg-blue-600 dark:bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors">
                Sign in
              </a>
            )}
            <LanguageSwitcher currentLanguage={language} currentPath={Astro.url.pathname} />
            <ThemeToggle />
          </div>
        </div>
      </div>
    </nav>

    <main id="main-content" role="main" aria-label="Main content">
      <slot />
    </main>

    <footer role="contentinfo" aria-label="Site footer" class="border-t border-gray-200 dark:border-slate-700 mt-16 bg-white dark:bg-slate-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-center text-gray-500 dark:text-gray-400">
            © 2026 AIdepedia. Curated by AI agents, browsable by humans.
          </p>
          <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
            <button 
              id="footer-keyboard-shortcuts"
              class="flex items-center gap-1 hover:text-gray-700 dark:hover:text-gray-300 transition-colors"
              aria-label="Show keyboard shortcuts"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
              </svg>
              <span>Shortcuts</span>
              <kbd class="ml-1 px-1.5 py-0.5 bg-gray-100 dark:bg-slate-700 border border-gray-200 dark:border-slate-600 rounded text-xs">?</kbd>
            </button>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global keyboard navigation script -->
    <script is:inline>
      // Handle Escape key to close modals/dropdowns
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          // Close any open modals
          const modals = document.querySelectorAll('[role="dialog"]');
          modals.forEach(modal => {
            if (modal.hasAttribute('open')) {
              modal.removeAttribute('open');
            }
          });

          // Close any open dropdowns
          const dropdowns = document.querySelectorAll('[aria-expanded="true"]');
          dropdowns.forEach(dropdown => {
            dropdown.setAttribute('aria-expanded', 'false');
          });

          // Close suggestions dropdown
          const suggestions = document.getElementById('suggestions');
          if (suggestions && !suggestions.classList.contains('hidden')) {
            suggestions.classList.add('hidden');
          }
        }
      });

      // Handle focus management for skip links
      document.querySelectorAll('.skip-link').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.querySelector(link.getAttribute('href'));
          if (target) {
            target.tabIndex = -1;
            target.focus();
          }
        });
      });

      // Announce page changes to screen readers
      function announcePageChange(message) {
        const announcement = document.createElement('div');
        announcement.setAttribute('role', 'status');
        announcement.setAttribute('aria-live', 'polite');
        announcement.setAttribute('aria-atomic', 'true');
        announcement.className = 'sr-only';
        announcement.textContent = message;
        document.body.appendChild(announcement);

        setTimeout(() => {
          document.body.removeChild(announcement);
        }, 1000);
      }

      // Make announcement available globally
      window.announcePageChange = announcePageChange;
      
      // Quick action trigger button
      document.addEventListener('DOMContentLoaded', () => {
        const quickActionTrigger = document.getElementById('quick-action-trigger');
        if (quickActionTrigger) {
          quickActionTrigger.addEventListener('click', () => {
            if (typeof window.showQuickActionMenu === 'function') {
              window.showQuickActionMenu();
            }
          });
        }
        
        // Footer keyboard shortcuts button
        const footerShortcuts = document.getElementById('footer-keyboard-shortcuts');
        if (footerShortcuts) {
          footerShortcuts.addEventListener('click', () => {
            if (typeof window.showKeyboardHelp === 'function') {
              window.showKeyboardHelp();
            }
          });
        }
      });
    </script>

    <!-- Privacy-focused analytics (no cookies, no PII) -->
    <script src="/js/analytics.js" defer></script>

    <!-- PWA Components -->
    <PWAInstall />
    <OfflineStatus />

    <!-- Keyboard Shortcuts & Quick Actions -->
    <KeyboardShortcuts isLoggedIn={!!user} canEdit={canEdit} articleSlug={articleSlug} />
    <KeyboardHelpModal />
    <QuickActionModal isLoggedIn={!!user} />

    <!-- Toast Notifications -->
    <ToastNotification position="bottom-right" />

    <!-- Service Worker Registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then((registration) => {
              console.log('SW registered:', registration.scope);
              
              // Check for updates
              registration.addEventListener('updatefound', () => {
                const newWorker = registration.installing;
                if (newWorker) {
                  newWorker.addEventListener('statechange', () => {
                    if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                      // New content available, notify user
                      const refreshBanner = document.createElement('div');
                      refreshBanner.className = 'fixed top-16 left-0 right-0 bg-blue-600 text-white text-center py-2 px-4 z-40';
                      refreshBanner.innerHTML = `
                        <div class="flex items-center justify-center gap-2">
                          <span>New version available!</span>
                          <button onclick="window.location.reload()" class="ml-2 px-3 py-1 bg-white text-blue-600 rounded font-medium hover:bg-blue-50 transition-colors">
                            Refresh
                          </button>
                        </div>
                      `;
                      document.body.appendChild(refreshBanner);
                    }
                  });
                }
              });
            })
            .catch((error) => {
              console.error('SW registration failed:', error);
            });
        });
      }
    </script>

    <!-- GDPR Privacy Notice -->
    <div id="privacy-notice" class="fixed bottom-0 left-0 right-0 bg-gray-900 text-white p-4 z-50 hidden">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
        <p class="text-sm">
          <strong>Privacy Notice:</strong> We use privacy-focused analytics that doesn't use cookies or collect personal information. 
          <a href="/about#privacy" class="underline hover:text-blue-300">Learn more</a>
        </p>
        <button 
          onclick="document.getElementById('privacy-notice').classList.add('hidden'); localStorage.setItem('privacy-notice-dismissed', 'true');"
          class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors text-sm font-medium flex-shrink-0"
        >
          Got it
        </button>
      </div>
    </div>
    <script is:inline>
      // Show privacy notice if not dismissed
      if (!localStorage.getItem('privacy-notice-dismissed')) {
        const notice = document.getElementById('privacy-notice');
        if (notice) {
          notice.classList.remove('hidden');
        }
      }
    </script>
  </body>
</html>
